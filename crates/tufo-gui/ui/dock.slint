// The player, docked under the page: the playing sounds as chips, then what plays, the transport
// with its seek bar, and the volume. In a narrow window it collapses into one slim row.

import { Motion, Theme } from "theme.slint";
import { Actions, Art, PlayerView, SoundChip } from "state.slint";
import { Icon, IconButton, Slider } from "widgets.slint";

component SoundChipView inherits Rectangle {
    in property <SoundChip> chip;
    height: 30px;
    width: min(layout.preferred-width, 220px);
    border-radius: self.height / 2;
    background: Theme.button;
    // Progress fills the chip from the left. The software renderer clips only to square corners,
    // so a square clip cuts a chip-sized pill down to the progress.
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.chip.progress, 0, 1);
        clip: true;
        Rectangle {
            x: 0;
            width: root.width;
            height: root.height;
            border-radius: root.border-radius;
            background: Theme.lit.with-alpha(0.2);
        }
    }

    // The loop toggle always takes its place, so looping never resizes the chip.
    layout := HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 2px;
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 24px;
            icon-size: 15px;
            icon: @image-url("icons/repeat.svg");
            tint: root.chip.looping ? Theme.accent : Theme.text-faint;
            hover-tint: root.chip.looping ? Theme.accent : Theme.text;
            tooltip: root.chip.looping ? @tr("Stop looping {0}", root.chip.title) : @tr("Loop {0}", root.chip.title);
            clicked => {
                Actions.set-sound-looping(root.chip.id, !root.chip.looping);
            }
        }

        Text {
            text: root.chip.title;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.text;
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            size: 24px;
            icon-size: 15px;
            icon: @image-url("icons/x.svg");
            tooltip: @tr("Stop {0}", root.chip.title);
            clicked => {
                Actions.stop-sound(root.chip.id);
            }
        }
    }
}

component NowPlaying inherits HorizontalLayout {
    in property <length> art-size: 46px;
    spacing: 12px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.art-size;
        height: root.art-size;
        border-radius: 12px;
        background: Theme.disc;
        if PlayerView.has-music: Image {
            width: parent.width;
            height: parent.height;
            source: Art.painting(PlayerView.collection-id, PlayerView.collection-background, self.width, self.height, 12px, Art.pictures-revision);
            image-fit: fill;
        }
        if !PlayerView.has-music: Icon {
            width: 20px;
            height: 20px;
            source: @image-url("icons/music.svg");
            tint: Theme.text-faint;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: PlayerView.has-music ? PlayerView.title : @tr("Nothing playing");
            font-size: Theme.body-small;
            font-weight: 800;
            color: PlayerView.has-music ? Theme.text : Theme.text-faint;
            overflow: elide;
        }

        if PlayerView.has-music: Text {
            text: PlayerView.collection-title;
            font-size: Theme.caption;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }
}

// Plays or pauses the music: the sunlit disc at the transport's heart.
component PlayButton inherits Rectangle {
    in property <length> size: 46px;
    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: !PlayerView.has-music ? Theme.button : touch.has-hover ? Theme.lit-bright : Theme.lit;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: PlayerView.playing ? @tr("Pause") : @tr("Play");
    accessible-enabled: PlayerView.has-music;
    accessible-action-default => { Actions.toggle-play-pause(); }
    Icon {
        width: root.size * 0.48;
        height: root.size * 0.48;
        source: PlayerView.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
        tint: PlayerView.has-music ? Theme.on-lit : Theme.text-disabled;
    }

    touch := TouchArea {
        enabled: PlayerView.has-music;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Actions.toggle-play-pause();
        }
    }
}

component SoundsPauseButton inherits IconButton {
    size: 30px;
    icon-size: 16px;
    icon: PlayerView.sounds-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
    tooltip: PlayerView.sounds-paused ? @tr("Resume sounds") : @tr("Pause sounds");
    clicked => {
        Actions.toggle-sounds-paused();
    }
}

component Transport inherits HorizontalLayout {
    alignment: center;
    spacing: 6px;
    IconButton {
        y: (parent.height - self.height) / 2;
        icon: @image-url("icons/shuffle.svg");
        tint: PlayerView.shuffle ? Theme.accent : Theme.text-secondary;
        hover-tint: PlayerView.shuffle ? Theme.accent : Theme.text;
        tooltip: PlayerView.shuffle ? @tr("Stop shuffling") : @tr("Shuffle");
        clicked => {
            Actions.toggle-shuffle();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: @image-url("icons/skip-back.svg");
        tooltip: @tr("Previous");
        enabled: PlayerView.has-music;
        clicked => {
            Actions.previous-track();
        }
    }

    PlayButton { }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: @image-url("icons/skip-forward.svg");
        tooltip: @tr("Next");
        enabled: PlayerView.has-music;
        clicked => {
            Actions.next-track();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: PlayerView.repeat == 2 ? @image-url("icons/repeat-1.svg") : @image-url("icons/repeat.svg");
        tint: PlayerView.repeat == 0 ? Theme.text-secondary : Theme.accent;
        hover-tint: PlayerView.repeat == 0 ? Theme.text : Theme.accent;
        tooltip: PlayerView.repeat == 0 ? @tr("Repeat the playlist") : PlayerView.repeat == 1 ? @tr("Repeat the track") : @tr("Stop repeating");
        clicked => {
            Actions.cycle-repeat();
        }
    }
}

// The seek bar, lit along the part of the track that has played.
component SeekBar inherits Rectangle {
    height: 18px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.track;
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * clamp(seek.shown-value, 0, 1);
        height: 3px;
        border-radius: 1.5px;
        background: Theme.lit;
    }

    if PlayerView.has-music: Rectangle {
        x: parent.width * clamp(seek.shown-value, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: seek.hovered ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.lit-bright;
        animate width { duration: 120ms; }
    }

    seek := Slider {
        width: parent.width;
        height: parent.height;
        track: transparent;
        fill: transparent;
        show-thumb: false;
        value: PlayerView.progress;
        released(value) => {
            Actions.seek(value);
        }
    }
}

component SeekRow inherits HorizontalLayout {
    spacing: 10px;
    Text {
        text: PlayerView.elapsed;
        min-width: 34px;
        font-size: 11.5px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }

    SeekBar {
        horizontal-stretch: 1;
    }

    Text {
        text: PlayerView.remaining;
        min-width: 34px;
        horizontal-alignment: right;
        font-size: 11.5px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
}

component VolumeControl inherits HorizontalLayout {
    spacing: 4px;
    IconButton {
        y: (parent.height - self.height) / 2;
        size: 32px;
        icon-size: 18px;
        icon: PlayerView.muted || PlayerView.volume == 0 ? @image-url("icons/volume-x.svg") : PlayerView.volume < 0.5 ? @image-url("icons/volume-1.svg") : @image-url("icons/volume-2.svg");
        tooltip: PlayerView.muted ? @tr("Unmute") : @tr("Mute");
        clicked => {
            Actions.toggle-mute();
        }
    }

    Slider {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 1;
        value: PlayerView.muted ? 0 : PlayerView.volume;
        changed(value) => {
            Actions.set-volume(value);
        }
    }
}

export component Dock inherits Rectangle {
    // Lays the controls out in one row, rather than in two.
    in property <bool> wide: true;
    // In a narrow window, shows only what plays, in one slim row.
    in property <bool> collapsed;
    callback set-collapsed(bool);
    background: Theme.dock;
    border-radius: Theme.radius-tile;
    border-width: 1px;
    border-color: Theme.panel-edge;
    height: layout.preferred-height;
    // Swallows clicks between the controls, so they don't reach the page under the dock.
    TouchArea { }
    layout := VerticalLayout {
        padding-top: root.wide || !root.collapsed ? 10px : 8px;
        padding-bottom: root.wide || !root.collapsed ? 10px : 8px;
        padding-left: 12px;
        padding-right: root.wide ? 16px : 8px;
        spacing: 8px;
        if PlayerView.sounds.length > 0 && (root.wide || !root.collapsed): HorizontalLayout {
            spacing: 8px;
            SoundsPauseButton { }
            Flickable {
                height: 30px;
                horizontal-stretch: 1;
                content-width: chips.preferred-width;
                mouse-drag-pan-enabled: false;
                chips := HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for chip in PlayerView.sounds: SoundChipView {
                        chip: chip;
                    }
                }
            }
        }
        if PlayerView.sounds.length > 0 && (root.wide || !root.collapsed): Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        if root.wide: HorizontalLayout {
            spacing: 16px;
            NowPlaying {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                width: 300px;
                spacing: 2px;
                Transport { }
                SeekRow { }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                VolumeControl {
                    width: 150px;
                }
            }
        }
        if !root.wide && !root.collapsed: HorizontalLayout {
            spacing: 12px;
            NowPlaying {
                horizontal-stretch: 1;
            }

            Transport { }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 32px;
                icon-size: 18px;
                icon: @image-url("icons/chevron-down.svg");
                tooltip: @tr("Collapse the player");
                clicked => {
                    root.set-collapsed(true);
                }
            }
        }
        if !root.wide && !root.collapsed: HorizontalLayout {
            spacing: 16px;
            SeekRow {
                horizontal-stretch: 1;
            }

            VolumeControl {
                width: 130px;
            }
        }
        if !root.wide && root.collapsed: HorizontalLayout {
            spacing: 8px;
            NowPlaying {
                art-size: 36px;
                horizontal-stretch: 1;
            }

            if PlayerView.sounds.length > 0: SoundsPauseButton {
                y: (parent.height - self.height) / 2;
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                size: 32px;
                icon-size: 18px;
                icon: @image-url("icons/chevron-up.svg");
                tooltip: @tr("Expand the player");
                clicked => {
                    root.set-collapsed(false);
                }
            }
        }
    }
}
