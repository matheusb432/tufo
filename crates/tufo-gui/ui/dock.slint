// The player, on the tray's ledge under the page: the playing sounds as chips, then what plays, the
// transport with its seek bar, and the volume. In a narrow window it collapses into one slim row, and the
// mini player shows a smaller set of its controls in a small window.

import { PlaybackTour } from "tours/playback.slint";
import { GuidedTours } from "tours/state.slint";
import { TourTarget } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import { Actions, Art, PlayerView, Session, SoundChip, WindowFrame, MusicLayer } from "state.slint";
import { Button, ButtonKind, Icon, IconButton, Slider, TooltipBubble } from "widgets.slint";
import { WindowDragArea } from "frame.slint";

component SoundChipView inherits Rectangle {
    in property <SoundChip> chip;
    callback stop(string);
    height: 30px;
    width: min(layout.preferred-width, 220px);
    border-radius: self.height / 2;
    background: Theme.button;
    // Progress fills the chip from the left. The software renderer clips only to square corners,
    // so a square clip cuts a chip-sized pill down to the progress.
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.chip.progress, 0, 1);
        clip: true;
        Rectangle {
            x: 0;
            width: root.width;
            height: root.height;
            border-radius: root.border-radius;
            background: Theme.lit.with-alpha(0.2);
        }
    }

    // The loop toggle always takes its place, so looping never resizes the chip.
    layout := HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 2px;
        IconButton {
            y: (parent.height - self.height) / 2;
            size: 24px;
            icon-size: 15px;
            icon: @image-url("icons/repeat.svg");
            tint: root.chip.looping ? Theme.accent : Theme.text-faint;
            hover-tint: root.chip.looping ? Theme.accent : Theme.text;
            tooltip: root.chip.looping ? @tr("Stop looping {0}", root.chip.title) : @tr("Loop {0}", root.chip.title);
            clicked => {
                Actions.set-sound-looping(root.chip.id, !root.chip.looping);
            }
        }

        Text {
            text: root.chip.title;
            font-size: Theme.label;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.text;
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            size: 24px;
            icon-size: 15px;
            icon: @image-url("icons/x.svg");
            tooltip: @tr("Stop {0}", root.chip.title);
            clicked => {
                root.stop(root.chip.id);
            }
        }
    }
}

component MusicLayerRow inherits VerticalLayout {
    in property <MusicLayer> layer;
    in property <bool> compact;
    callback stop(string);
    spacing: 2px;
    HorizontalLayout {
        spacing: 4px;
        Text {
            text: root.layer.title;
            overflow: elide;
            font-size: Theme.body-small;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.compact: Slider {
            width: 64px;
            height: 28px;
            value: root.layer.volume;
            changed(value) => { Actions.set-music-layer-volume(root.layer.id, value); }
        }
        IconButton {
            size: 28px;
            icon-size: 16px;
            icon: @image-url("icons/repeat.svg");
            tint: root.layer.looping ? Theme.accent : Theme.text-faint;
            tooltip: root.layer.looping ? @tr("Stop looping {0}", root.layer.title) : @tr("Loop {0}", root.layer.title);
            clicked => { Actions.set-music-layer-looping(root.layer.id, !root.layer.looping); }
        }
        IconButton {
            size: 28px;
            icon-size: 16px;
            icon: @image-url("icons/x.svg");
            tooltip: @tr("Stop {0}", root.layer.title);
            clicked => { root.stop(root.layer.id); }
        }
    }
    if !root.compact: Slider {
        height: 20px;
        value: root.layer.volume;
        changed(value) => { Actions.set-music-layer-volume(root.layer.id, value); }
    }
}

component MixButton inherits Button {
    TourTarget {
        anchor: PlaybackTour.mix;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    text: @tr("Mix · {0}", PlayerView.layer-count);
    kind: ButtonKind.quiet;
    height: 22px;
    clicked => { mix.show(); }
    // Close the popup before playback can remove its rows.
    function stop-song(entry-id: string) {
        mix.close();
        Actions.stop-music-layer(entry-id);
    }
    mix := PopupWindow {
        close-policy: PopupClosePolicy.close-on-click-outside;
        width: 280px;
        height: layout.preferred-height;
        y: -self.height - 8px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-row;
            border-width: 1px;
            border-color: Theme.raised-edge;
            layout := VerticalLayout {
                padding: Session.mini-player ? 8px : 12px;
                spacing: Session.mini-player ? 4px : 8px;
                Text {
                    text: Session.mini-player ? @tr("Mix · {0}", PlayerView.layer-count) : @tr("Music mix");
                    color: Theme.text;
                    font-size: Theme.body-small;
                    font-weight: 800;
                }
                if !Session.mini-player: Text {
                    text: @tr("{0} of 3 songs", PlayerView.layer-count);
                    color: Theme.text-faint;
                    font-size: Theme.caption;
                }
                if PlayerView.has-music: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: PlayerView.title;
                            overflow: elide;
                            font-size: Theme.body-small;
                            color: Theme.text;
                        }
                        if !Session.mini-player: Text {
                            text: @tr("Main track");
                            font-size: Theme.caption;
                            color: Theme.text-faint;
                        }
                    }
                    IconButton {
                        size: 28px;
                        icon-size: 16px;
                        icon: @image-url("icons/x.svg");
                        tooltip: @tr("Stop {0}", PlayerView.title);
                        clicked => { root.stop-song(PlayerView.entry-id); }
                    }
                }
                for layer in PlayerView.music-layers: MusicLayerRow {
                    layer: layer;
                    compact: Session.mini-player;
                    stop(entry-id) => { root.stop-song(entry-id); }
                }
            }
        }
    }
}

component NowPlaying inherits HorizontalLayout {
    in property <length> art-size: 46px;
    spacing: 12px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.art-size;
        height: root.art-size;
        border-radius: 12px;
        background: Theme.disc;
        if PlayerView.has-playback: Image {
            width: parent.width;
            height: parent.height;
            source: Art.painting(PlayerView.collection-id, PlayerView.collection-background, self.width, self.height, 12px, Art.pictures-revision);
            image-fit: fill;
        }
        if !PlayerView.has-playback: Icon {
            width: 20px;
            height: 20px;
            source: @image-url("icons/music.svg");
            tint: Theme.text-faint;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: PlayerView.has-playback ? PlayerView.title : @tr("Nothing playing");
            font-size: Theme.body-small;
            font-weight: 800;
            color: PlayerView.has-playback ? Theme.text : Theme.text-faint;
            overflow: elide;
        }

        if PlayerView.has-playback && PlayerView.music-layers.length == 0: Text {
            text: PlayerView.collection-title;
            font-size: Theme.caption;
            color: Theme.text-secondary;
            overflow: elide;
        }
        // Sets the quiet button's label flush with the title.
        if PlayerView.music-layers.length > 0: HorizontalLayout {
            alignment: start;
            padding-left: -10px;
            MixButton { }
        }
    }
}

// Plays or pauses the music: the sunlit disc at the transport's heart.
component PlayButton inherits Rectangle {
    in property <length> size: 46px;
    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: !PlayerView.has-playback ? Theme.button : touch.has-hover ? Theme.lit-bright : Theme.lit;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: PlayerView.playing ? @tr("Pause") : @tr("Play");
    accessible-enabled: PlayerView.has-playback;
    accessible-action-default => { Actions.toggle-play-pause(); }
    Icon {
        width: root.size * 0.48;
        height: root.size * 0.48;
        source: PlayerView.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
        tint: PlayerView.has-playback ? Theme.on-lit : Theme.text-disabled;
    }

    touch := TouchArea {
        enabled: PlayerView.has-playback;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Actions.toggle-play-pause();
        }
    }
}

component SoundsPauseButton inherits IconButton {
    size: 30px;
    icon-size: 16px;
    icon: PlayerView.sounds-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
    tooltip: PlayerView.sounds-paused ? @tr("Resume sounds") : @tr("Pause sounds");
    clicked => {
        Actions.toggle-sounds-paused();
    }
}

component Transport inherits HorizontalLayout {
    in property <length> button-size: 40px;
    in property <length> icon-size: 22px;
    in property <length> play-size: 46px;
    in property <bool> play-modes-visible: true;
    alignment: center;
    spacing: 6px;
    if root.play-modes-visible: IconButton {
        TourTarget {
            anchor: PlaybackTour.transport;
            bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
        }
        y: (parent.height - self.height) / 2;
        size: root.button-size;
        icon-size: root.icon-size;
        icon: @image-url("icons/shuffle.svg");
        tint: PlayerView.shuffle ? Theme.accent : Theme.text-secondary;
        hover-tint: PlayerView.shuffle ? Theme.accent : Theme.text;
        tooltip: PlayerView.shuffle ? @tr("Stop shuffling") : @tr("Shuffle");
        clicked => {
            Actions.toggle-shuffle();
        }
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        size: root.button-size;
        icon-size: root.icon-size;
        icon: @image-url("icons/skip-back.svg");
        tooltip: @tr("Previous");
        enabled: PlayerView.has-music;
        clicked => {
            Actions.previous-track();
        }
    }

    PlayButton {
        y: (parent.height - self.height) / 2;
        size: root.play-size;
    }

    IconButton {
        y: (parent.height - self.height) / 2;
        size: root.button-size;
        icon-size: root.icon-size;
        icon: @image-url("icons/skip-forward.svg");
        tooltip: @tr("Next");
        enabled: PlayerView.has-music;
        clicked => {
            Actions.next-track();
        }
    }

    if root.play-modes-visible: IconButton {
        y: (parent.height - self.height) / 2;
        size: root.button-size;
        icon-size: root.icon-size;
        icon: PlayerView.repeat == 2 ? @image-url("icons/repeat-1.svg") : @image-url("icons/repeat.svg");
        tint: PlayerView.repeat == 0 ? Theme.text-secondary : Theme.accent;
        hover-tint: PlayerView.repeat == 0 ? Theme.text : Theme.accent;
        tooltip: PlayerView.repeat == 0 ? (PlayerView.songs-queued ? @tr("Repeat the queue") : @tr("Repeat the playlist"))
            : PlayerView.repeat == 1 && !PlayerView.songs-queued ? @tr("Repeat the track") : @tr("Stop repeating");
        clicked => {
            Actions.cycle-repeat();
        }
    }
}

// The seek bar, lit along the part of the track that has played.
component SeekBar inherits Rectangle {
    in property <bool> thumb-hover-only;
    height: 18px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.track;
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * clamp(seek.shown-value, 0, 1);
        height: 3px;
        border-radius: 1.5px;
        background: Theme.lit;
    }

    if PlayerView.has-music: Rectangle {
        x: parent.width * clamp(seek.shown-value, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: seek.hovered ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.lit-bright;
        opacity: root.thumb-hover-only && !seek.hovered ? 0 : 1;
        animate width, opacity { duration: 120ms; }
    }

    seek := Slider {
        width: parent.width;
        height: parent.height;
        track: transparent;
        fill: transparent;
        show-thumb: false;
        value: PlayerView.progress;
        released(value) => {
            Actions.seek(value);
        }
    }
}

component TimeText inherits Text {
    min-width: 34px;
    font-size: Theme.micro;
    color: Theme.text-faint;
    vertical-alignment: center;
}

component SeekRow inherits HorizontalLayout {
    spacing: 10px;
    TimeText {
        text: PlayerView.elapsed;
    }

    SeekBar {
        TourTarget {
            anchor: PlaybackTour.seek;
            bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
        }
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 1;
    }

    TimeText {
        text: PlayerView.remaining;
        horizontal-alignment: right;
    }
}

component EffectsVolumeButton inherits IconButton {
    size: 32px;
    icon-size: 18px;
    icon: @image-url("../icons/sounds/audio-lines.svg");
    tooltip: @tr("Effects volume");
    tint: PlayerView.effects-volume == 0 ? Theme.text-faint : Theme.text-secondary;
    clicked => { effects.show(); }
    effects := PopupWindow {
        close-policy: PopupClosePolicy.close-on-click-outside;
        width: 240px;
        height: layout.preferred-height;
        x: root.width - self.width;
        y: -self.height - 8px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-row;
            border-width: 1px;
            border-color: Theme.raised-edge;
            layout := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: @tr("Effects volume");
                        color: Theme.text;
                        font-size: Theme.body-small;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: round(volume.shown-value * 100) + "%";
                        color: Theme.text-secondary;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                    }
                }
                volume := Slider {
                    value: PlayerView.effects-volume;
                    accessible-label: @tr("Effects volume");
                    changed(value) => { Actions.set-effects-volume(value); }
                }
            }
        }
    }
}

component MuteButton inherits IconButton {
    size: 32px;
    icon-size: 18px;
    icon: PlayerView.muted || PlayerView.volume == 0 ? @image-url("icons/volume-x.svg") : PlayerView.volume < 0.5 ? @image-url("icons/volume-1.svg") : @image-url("icons/volume-2.svg");
    tooltip: PlayerView.muted ? @tr("Unmute") : @tr("Mute");
    clicked => {
        Actions.toggle-mute();
    }
}

component MusicVolumeSlider inherits Slider {
    value: PlayerView.muted ? 0 : PlayerView.volume;
    accessible-label: @tr("Music volume");
    changed(value) => {
        Actions.set-volume(value);
    }
}

component VolumeControl inherits HorizontalLayout {
    spacing: 4px;
    MuteButton {
        TourTarget {
            anchor: PlaybackTour.volume;
            bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
        }
        y: (parent.height - self.height) / 2;
    }

    MusicVolumeSlider {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 1;
    }
    EffectsVolumeButton {
        y: (parent.height - self.height) / 2;
    }
}

// The pause button for every sound, and a chip for each playing sound, scrolling sideways.
component PlayingSounds inherits HorizontalLayout {
    spacing: 8px;
    SoundsPauseButton {
        TourTarget {
            anchor: PlaybackTour.playing-sounds;
            bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
        }
        y: (parent.height - self.height) / 2;
    }

    Flickable {
        y: (parent.height - self.height) / 2;
        height: 30px;
        horizontal-stretch: 1;
        content-width: chips.preferred-width;
        mouse-drag-pan-enabled: false;
        chips := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for chip in PlayerView.sounds: SoundChipView {
                chip: chip;
                stop(sound-id) => {
                    Actions.stop-sound(sound-id);
                }
            }
        }
    }
}

component MiniPlayerButton inherits IconButton {
    TourTarget {
        anchor: PlaybackTour.mini-switch;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    size: 32px;
    icon-size: 18px;
    icon: @image-url("icons/picture-in-picture-2.svg");
    tooltip: @tr("Mini player (Ctrl+Shift+M)");
    clicked => {
        WindowFrame.switch-form();
    }
}

component LocalOutputNotice inherits Rectangle {
    height: Session.mini-player ? 103px : max(64px, notice.preferred-height);
    background: Theme.field;
    border-radius: 8px;
    accessible-role: text;
    accessible-label: PlayerView.local-output-message;
    notice := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Text {
            text: PlayerView.local-output-message;
            color: PlayerView.local-output-recovering ? Theme.text-secondary : Theme.error;
            font-size: Theme.body-small;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        retry := Button {
            accessible-description: @tr("Retry local audio (Ctrl+Shift+R)");
            y: (parent.height - self.height) / 2;
            text: PlayerView.local-output-recovering ? @tr("Retrying…") : @tr("Retry audio");
            enabled: !PlayerView.local-output-recovering && Session.connected;
            clicked => { if self.enabled { Actions.recover-local-output(); } }
        }
    }
}

export component Dock inherits Rectangle {
    // Lays the controls out in one row, rather than in two.
    in property <bool> wide: true;
    // In a narrow window, shows only what plays, in one slim row.
    in property <bool> collapsed;
    callback set-collapsed(bool);
    height: layout.preferred-height;
    // Swallows clicks between the controls, so they don't reach the page under the dock.
    TouchArea { }
    layout := VerticalLayout {
        padding-top: 8px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: root.wide ? 18px : 10px;
        spacing: 8px;
        if PlayerView.local-output-message != "": LocalOutputNotice { }
        if PlayerView.sounds.length > 0 && (root.wide || !root.collapsed): PlayingSounds { }
        if PlayerView.sounds.length > 0 && (root.wide || !root.collapsed): Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        if root.wide: HorizontalLayout {
            spacing: 16px;
            NowPlaying {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                width: 300px;
                spacing: 2px;
                Transport { }
                SeekRow { }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: 8px;
                VolumeControl {
                    width: 150px;
                }

                MiniPlayerButton {
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        if !root.wide && !root.collapsed: HorizontalLayout {
            spacing: 10px;
            NowPlaying {
                art-size: 40px;
                horizontal-stretch: 1;
            }

            Transport {
                spacing: 2px;
                button-size: 34px;
                icon-size: 20px;
                play-size: 40px;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 32px;
                icon-size: 18px;
                icon: @image-url("icons/chevron-down.svg");
                tooltip: @tr("Collapse the player");
                clicked => {
                    root.set-collapsed(true);
                }
            }
        }
        if !root.wide && !root.collapsed: HorizontalLayout {
            spacing: 8px;
            SeekRow {
                horizontal-stretch: 1;
            }

            VolumeControl {
                width: 140px;
            }

            MiniPlayerButton {
                y: (parent.height - self.height) / 2;
            }
        }
        if !root.wide && root.collapsed: HorizontalLayout {
            spacing: 8px;
            NowPlaying {
                art-size: 36px;
                horizontal-stretch: 1;
            }

            if PlayerView.sounds.length > 0: SoundsPauseButton {
                y: (parent.height - self.height) / 2;
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                size: 36px;
            }

            MiniPlayerButton {
                y: (parent.height - self.height) / 2;
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                size: 32px;
                icon-size: 18px;
                icon: @image-url("icons/chevron-up.svg");
                tooltip: @tr("Expand the player");
                clicked => {
                    root.set-collapsed(false);
                }
            }
        }
    }
}

// The playing sounds behind one button that counts them. Its popover pauses, loops, and stops them
// and sets the effects volume.
component SoundsButton inherits Rectangle {
    property <int> sound-count: PlayerView.sounds.length;
    property <bool> tooltip-dismissed;
    property <length> popover-margin: 4px;
    // Beside the button rather than over it, so a second click cannot land on a row.
    property <length> popover-width: min(264px, root.absolute-position.x - 2 * root.popover-margin);
    property <length> popover-padding: 8px;
    width: content.preferred-width;
    height: 28px;
    border-radius: self.height / 2;
    background: root.sound-count == 0 ? (touch.has-hover ? Theme.hover : transparent) : touch.has-hover ? Theme.track : Theme.button;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: @tr("Sounds and effects volume");
    accessible-action-default => { popover.show(); }
    // Close the popover before playback can remove its rows.
    function stop-sound(sound-id: string) {
        popover.close();
        Actions.stop-sound(sound-id);
    }

    content := HorizontalLayout {
        padding-left: root.sound-count > 0 ? 8px : 5px;
        padding-right: root.sound-count > 0 ? 11px : 5px;
        spacing: 5px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("../icons/sounds/audio-lines.svg");
            tint: root.sound-count > 0 && !PlayerView.sounds-paused ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-faint;
        }
        if root.sound-count > 0: Text {
            text: root.sound-count;
            font-size: Theme.label;
            font-weight: 800;
            color: PlayerView.sounds-paused ? Theme.text-faint : Theme.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.tooltip-dismissed = true;
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.tooltip-dismissed = false;
            }
        }
        clicked => {
            popover.show();
        }
    }

    // Stays mounted, like IconButton's tooltip.
    Rectangle {
        width: root.width;
        height: root.height;
        visible: !root.tooltip-dismissed;
        Tooltip {
            TooltipBubble {
                text: @tr("Sounds and effects volume");
            }
        }
    }

    popover := PopupWindow {
        close-policy: PopupClosePolicy.close-on-click-outside;
        width: root.popover-width;
        height: min(panel.preferred-height, Theme.mini-player-height-min - 2 * root.popover-margin);
        x: -self.width - root.popover-margin;
        y: root.popover-margin - root.absolute-position.y;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-row;
            border-width: 1px;
            border-color: Theme.raised-edge;
            panel := VerticalLayout {
                padding: root.popover-padding;
                spacing: 4px;
                HorizontalLayout {
                    min-height: 24px;
                    spacing: 6px;
                    Text {
                        text: @tr("Sounds");
                        color: Theme.text;
                        font-size: Theme.body-small;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sound-count > 0 ? root.sound-count : "";
                        color: Theme.text-faint;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon-size: 15px;
                        enabled: root.sound-count > 0;
                        icon: PlayerView.sounds-paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                        tooltip: PlayerView.sounds-paused ? @tr("Resume sounds") : @tr("Pause sounds");
                        clicked => {
                            Actions.toggle-sounds-paused();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        source: PlayerView.effects-volume == 0 ? @image-url("icons/volume-x.svg") : PlayerView.effects-volume < 0.5 ? @image-url("icons/volume-1.svg") : @image-url("icons/volume-2.svg");
                        tint: Theme.text-faint;
                    }
                    volume := Slider {
                        horizontal-stretch: 1;
                        value: PlayerView.effects-volume;
                        accessible-label: @tr("Effects volume");
                        changed(value) => { Actions.set-effects-volume(value); }
                    }
                    Text {
                        text: round(volume.shown-value * 100) + "%";
                        min-width: 34px;
                        horizontal-alignment: right;
                        color: Theme.text-secondary;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                    }
                }
                if root.sound-count == 0: Text {
                    text: @tr("No sounds playing");
                    color: Theme.text-faint;
                    font-size: Theme.caption;
                }
                if root.sound-count > 0: Flickable {
                    preferred-height: sounds.preferred-height;
                    vertical-stretch: 1;
                    content-height: sounds.preferred-height;
                    mouse-drag-pan-enabled: false;
                    sounds := VerticalLayout {
                        spacing: 4px;
                        for chip in PlayerView.sounds: SoundChipView {
                            chip: chip;
                            width: root.popover-width - 2 * root.popover-padding;
                            height: 26px;
                            stop(sound-id) => {
                                root.stop-sound(sound-id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// The whole window as a small player that a drag anywhere outside its controls moves.
export component MiniPlayer inherits Rectangle {
    callback close();
    WindowDragArea {
        maximizes: false;
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 9px;
        if PlayerView.local-output-message != "": LocalOutputNotice { }
        HorizontalLayout {
            height: 40px;
            spacing: 2px;
            NowPlaying {
                art-size: 40px;
                horizontal-stretch: 1;
            }

            if Session.always-on-top-supported: IconButton {
                y: (parent.height - self.height) / 2;
                size: 28px;
                icon-size: 16px;
                icon: @image-url("icons/pin.svg");
                tint: Session.mini-player-pinned ? Theme.accent : Theme.text-faint;
                tooltip: Session.mini-player-pinned ? @tr("Stop keeping on top") : @tr("Keep on top");
                clicked => {
                    Session.mini-player-pinned = !Session.mini-player-pinned;
                    Actions.set-mini-player-pinned(Session.mini-player-pinned);
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 28px;
                icon-size: 16px;
                icon: @image-url("icons/maximize-2.svg");
                tint: Theme.text-faint;
                tooltip: @tr("Full window (Ctrl+Shift+M)");
                clicked => {
                    WindowFrame.switch-form();
                }
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                size: 28px;
                icon-size: 16px;
                icon: @image-url("icons/x.svg");
                tint: Theme.text-faint;
                tooltip: @tr("Close");
                background: self.has-hover ? Theme.window-close-hover : transparent;
                hover-tint: Theme.window-close-hover-icon;
                clicked => {
                    root.close();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            SeekBar {
                y: (parent.height - self.height) / 2;
                horizontal-stretch: 1;
                thumb-hover-only: true;
            }

            TimeText {
                text: PlayerView.remaining;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Transport {
                spacing: 2px;
                button-size: 32px;
                icon-size: 18px;
                play-size: 36px;
                play-modes-visible: false;
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                MuteButton {
                    y: (parent.height - self.height) / 2;
                    size: 28px;
                }

                MusicVolumeSlider {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                }
            }

            SoundsButton {
                y: (parent.height - self.height) / 2;
            }
        }
    }
}
