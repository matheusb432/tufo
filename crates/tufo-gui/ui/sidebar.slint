// The sidebar, on the tray's rim: the logo, search, the pages, every collection, and the
// connection. It collapses to a rail of icons.

import { HomeTour } from "tours/home.slint";
import { GuidedTours } from "tours/state.slint";
import { TourTarget } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import {
    Actions, BrowserState, BrowserView, CollectionKind, LibraryView, NavItem, Navigation, Page, PlayerView, Session,
    WindowFrame,
} from "state.slint";
import { Equalizer, Icon, IconButton, Logo } from "widgets.slint";
import { WindowDragArea } from "frame.slint";

// Marks the open page's row with a sunlit bar along its left edge.
component SunEdge inherits Rectangle {
    width: 3px;
    border-radius: 1.5px;
    background: Theme.lit;
}

component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <bool> running;
    in property <bool> collapsible;
    in property <bool> expanded;
    in property <bool> can-add;
    in property <string> add-label;
    callback clicked();
    callback add();
    height: 36px;
    border-radius: Theme.radius-row;
    background: touch.has-hover && !root.active ? Theme.wood-hover : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.text;
    if root.active: SunEdge {
        x: 0;
        y: 5px;
        height: root.height - 10px;
    }
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.sidebar-icon-padding;
        padding-right: 4px;
        spacing: Theme.sidebar-icon-spacing;
        Icon {
            y: (parent.height - self.height) / 2;
            width: Theme.bar-icon-size;
            height: Theme.bar-icon-size;
            source: root.icon;
            tint: root.active ? Theme.lit : root.running ? Theme.accent : Theme.text-secondary;
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: Theme.body;
            font-weight: 700;
            color: root.active ? Theme.lit : Theme.text;
        }

        if root.running: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.lit;
            }
        }

        if root.collapsible: Icon {
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
            tint: Theme.text-faint;
        }

        if root.can-add: IconButton {
            y: (parent.height - self.height) / 2;
            size: 28px;
            icon-size: 16px;
            icon: @image-url("icons/plus.svg");
            tint: Theme.text-faint;
            tooltip: root.add-label;
            clicked => {
                root.add();
            }
        }
    }
}

component SectionRow inherits NavRow {
    collapsible: true;
    accessible-expanded: root.expanded;
}

component CollectionLink inherits Rectangle {
    in property <NavItem> item;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: Theme.radius-row;
    background: touch.has-hover && !root.active ? Theme.wood-hover : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.item.title;
    if root.active: SunEdge {
        x: 0;
        y: 5px;
        height: root.height - 10px;
    }
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.sidebar-label-padding;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.item.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Theme.body-small;
            color: root.item.missing ? Theme.text-faint : root.active ? Theme.lit : touch.has-hover ? Theme.text : Theme.text-secondary;
        }

        if root.item.playing: Equalizer {
            y: (parent.height - self.height) / 2;
        }
    }
}

component SidebarForm inherits Rectangle {
    in property <bool> shown;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity {
        duration: root.shown ? Motion.sidebar-fade-in : Motion.sidebar-fade-out;
        delay: root.shown ? Motion.sidebar-fade-in-delay : 0ms;
    }
}

component FullSidebar inherits SidebarForm {
    TourTarget {
        anchor: HomeTour.navigation;
        available: root.shown;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    callback open-page(Page, string);
    callback collapse();
    callback open-search();
    callback open-settings();
    callback add(CollectionKind);
    property <Page> page: Navigation.page;
    property <bool> playlists-expanded: true;
    property <bool> soundboards-expanded: true;
    width: Theme.sidebar-width;
    VerticalLayout {
        HorizontalLayout {
            height: Theme.title-row-height;
            padding-right: 8px;
            alignment: end;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: Theme.bar-button-size;
                icon-size: Theme.bar-icon-size;
                icon: @image-url("icons/panel-left-close.svg");
                tooltip: @tr("Collapse (Ctrl+B)");
                tooltip-enabled: root.shown;
                clicked => {
                    root.collapse();
                }
            }
        }

        HorizontalLayout {
            padding-left: Theme.sidebar-row-padding;
            padding-right: Theme.sidebar-row-padding;
            padding-bottom: 8px;
            search := Rectangle {
                height: 34px;
                border-radius: Theme.radius-row;
                background: search-touch.has-hover ? Theme.wood-hover.with-alpha(0.12) : Theme.wood-field;
                accessible-role: button;
                accessible-label: @tr("Search everything");
                accessible-action-default => { root.open-search(); }
                search-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.open-search();
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.sidebar-icon-padding;
                    padding-right: 12px;
                    spacing: Theme.sidebar-icon-spacing;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: Theme.bar-icon-size;
                        height: Theme.bar-icon-size;
                        source: @image-url("icons/search.svg");
                        tint: Theme.text-faint;
                    }

                    Text {
                        text: @tr("Search");
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: Theme.body-small;
                        color: Theme.text-faint;
                    }

                    Text {
                        text: "Ctrl+Shift+F";
                        vertical-alignment: center;
                        font-size: Theme.micro;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        Flickable {
            mouse-drag-pan-enabled: false;
            vertical-stretch: 1;
            content-height: nav.preferred-height;
            nav := VerticalLayout {
                padding-left: Theme.sidebar-row-padding;
                padding-right: Theme.sidebar-row-padding;
                padding-bottom: 8px;
                spacing: 2px;
                alignment: start;
                NavRow {
                    icon: @image-url("icons/house.svg");
                    text: @tr("Home");
                    active: root.page == Page.home;
                    clicked => {
                        root.open-page(Page.home, "");
                    }
                }

                NavRow {
                    icon: @image-url("icons/music.svg");
                    text: @tr("Songs");
                    active: root.page == Page.songs;
                    clicked => {
                        root.open-page(Page.songs, "");
                    }
                }

                NavRow {
                    icon: @image-url("icons/globe.svg");
                    text: @tr("Browser");
                    active: root.page == Page.browser;
                    running: BrowserView.state == BrowserState.open;
                    accessible-description: self.running ? @tr("Browser is open") : "";
                    clicked => {
                        root.open-page(Page.browser, "");
                    }
                }

                SectionRow {
                    icon: @image-url("icons/list-music.svg");
                    text: @tr("Playlists");
                    active: root.page == Page.playlists;
                    expanded: root.playlists-expanded;
                    can-add: Session.connected;
                    add-label: @tr("Add Playlist");
                    clicked => {
                        if root.page == Page.playlists {
                            root.playlists-expanded = !root.playlists-expanded;
                        } else {
                            root.playlists-expanded = true;
                            root.open-page(Page.playlists, "");
                        }
                    }
                    add => {
                        root.add(CollectionKind.playlist);
                    }
                }

                for item in (root.playlists-expanded ? LibraryView.nav-playlists : []): CollectionLink {
                    item: item;
                    active: root.page == Page.playlist && Navigation.collection-id == item.id;
                    clicked => {
                        root.open-page(Page.playlist, item.id);
                    }
                }
                Rectangle {
                    height: 6px;
                }

                SectionRow {
                    icon: @image-url("icons/layout-grid.svg");
                    text: @tr("Soundboards");
                    active: root.page == Page.soundboards;
                    expanded: root.soundboards-expanded;
                    can-add: Session.connected;
                    add-label: @tr("Add Soundboard");
                    clicked => {
                        if root.page == Page.soundboards {
                            root.soundboards-expanded = !root.soundboards-expanded;
                        } else {
                            root.soundboards-expanded = true;
                            root.open-page(Page.soundboards, "");
                        }
                    }
                    add => {
                        root.add(CollectionKind.soundboard);
                    }
                }

                for item in (root.soundboards-expanded ? LibraryView.nav-soundboards : []): CollectionLink {
                    item: item;
                    active: root.page == Page.soundboard && Navigation.collection-id == item.id;
                    clicked => {
                        root.open-page(Page.soundboard, item.id);
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: Theme.sidebar-row-padding;
            padding-right: Theme.sidebar-row-padding;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 4px;
            HorizontalLayout {
                padding-left: Theme.sidebar-icon-padding - (Theme.bar-button-size - Theme.bar-icon-size) / 2;
                spacing: Theme.sidebar-icon-spacing - (Theme.bar-button-size - Theme.bar-icon-size) / 2;
                IconButton {
                    size: Theme.bar-button-size;
                    icon-size: Theme.bar-icon-size;
                    icon: @image-url("icons/settings.svg");
                    tooltip: @tr("Settings");
                    tooltip-enabled: root.shown;
                    clicked => {
                        root.open-settings();
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    if !Session.connected: Text {
                        text: Session.connection-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: Theme.caption;
                        color: Theme.text-faint;
                    }

                    if !Session.connected: Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.warning;
                    }
                }
            }
        }
    }
}

component RailButton inherits IconButton {
    in property <bool> active;
    in property <bool> running;
    size: Theme.bar-button-size;
    icon-size: Theme.bar-icon-size;
    border-radius: Theme.radius-row;
    background: root.has-hover && !root.active ? Theme.wood-hover : transparent;
    tint: root.active ? Theme.lit : root.running ? Theme.accent : Theme.text-secondary;
    if root.active: SunEdge {
        x: 0;
        y: 5px;
        height: root.height - 10px;
    }
    if root.running: Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.wood;
        background: Theme.lit;
    }
}

component Rail inherits SidebarForm {
    TourTarget {
        anchor: HomeTour.navigation;
        available: root.shown;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    callback open-page(Page, string);
    callback expand();
    callback open-search();
    callback open-settings();
    property <Page> page: Navigation.page;
    width: Theme.rail-width;
    VerticalLayout {
        padding-top: Theme.title-row-height;
        padding-bottom: 10px;
        spacing: 4px;
        alignment: start;
        for button[index] in [
            { icon: @image-url("icons/panel-left-open.svg"), label: @tr("Expand (Ctrl+B)") },
            { icon: @image-url("icons/search.svg"), label: @tr("Search everything (Ctrl+Shift+F)") },
            { icon: @image-url("icons/house.svg"), label: @tr("Home") },
            { icon: @image-url("icons/music.svg"), label: @tr("Songs") },
            { icon: @image-url("icons/globe.svg"), label: @tr("Browser") },
            { icon: @image-url("icons/list-music.svg"), label: @tr("Playlists") },
            { icon: @image-url("icons/layout-grid.svg"), label: @tr("Soundboards") },
        ]: HorizontalLayout {
            alignment: center;
            RailButton {
                icon: button.icon;
                tooltip: self.running ? @tr("Browser is open") : button.label;
                tooltip-enabled: root.shown;
                running: index == 4 && BrowserView.state == BrowserState.open;
                active: index == 2 ? root.page == Page.home : index == 3 ? root.page == Page.songs : index == 4 ? root.page == Page.browser : index == 5 ? root.page == Page.playlists || root.page == Page.playlist : index == 6 ? root.page == Page.soundboards || root.page == Page.soundboard : false;
                clicked => {
                    if index == 0 {
                        root.expand();
                    } else if index == 1 {
                        root.open-search();
                    } else if index == 2 {
                        root.open-page(Page.home, "");
                    } else if index == 3 {
                        root.open-page(Page.songs, "");
                    } else if index == 4 {
                        root.open-page(Page.browser, "");
                    } else if index == 5 {
                        root.open-page(Page.playlists, "");
                    } else {
                        root.open-page(Page.soundboards, "");
                    }
                }
            }
        }
    }

    VerticalLayout {
        y: parent.height - self.height;
        height: self.preferred-height;
        padding-bottom: 8px;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            IconButton {
                size: Theme.bar-button-size;
                icon-size: Theme.bar-icon-size;
                icon: @image-url("icons/settings.svg");
                tooltip: @tr("Settings");
                tooltip-enabled: root.shown;
                clicked => {
                    root.open-settings();
                }
            }
        }

        if !Session.connected: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.warning;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <bool> expanded;
    // Lies over the page rather than beside it.
    in property <bool> overlaid;
    callback page-opened();
    callback toggle();
    callback open-search();
    callback open-settings();
    callback add(CollectionKind);
    width: root.expanded ? Theme.sidebar-width : Theme.rail-width;
    animate width {
        duration: Motion.sidebar-slide;
        easing: Motion.sidebar-slide-easing;
    }
    // Over the page, the rim's wood is solid, so the page doesn't show through.
    background: root.overlaid ? Theme.wood : transparent;
    border-top-left-radius: WindowFrame.corner-radius;
    border-bottom-left-radius: WindowFrame.corner-radius;
    clip: true;

    WindowDragArea {
        y: 0;
        height: Theme.title-row-height;
    }

    Logo {
        x: (Theme.rail-width - self.width) / 2;
        width: 32px;
        height: 32px;
        y: (Theme.title-row-height - self.height) / 2;
        asleep: !PlayerView.something-plays;
        accessible-role: image;
        accessible-label: PlayerView.something-plays ? @tr("Awake while something plays") : @tr("Asleep while nothing plays");
    }

    FullSidebar {
        x: 0;
        shown: root.expanded;
        open-page(page, id) => {
            Actions.open-page(page, id);
            root.page-opened();
        }
        collapse => {
            root.toggle();
        }
        open-search => {
            root.open-search();
        }
        open-settings => {
            root.open-settings();
        }
        add(kind) => {
            root.add(kind);
        }
    }

    Rail {
        x: 0;
        shown: !root.expanded;
        open-page(page, id) => {
            Actions.open-page(page, id);
            root.page-opened();
        }
        expand => {
            root.toggle();
        }
        open-search => {
            root.open-search();
        }
        open-settings => {
            root.open-settings();
        }
    }

}
