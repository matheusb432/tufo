// The sidebar, on the tray's rim: the logo, which opens Home, search, the pages you keep in it with
// the collections pinned under them, and the connection while it's down. It collapses to a rail of
// icons and pinned paintings.

import { HomeTour } from "tours/home.slint";
import { GuidedTours } from "tours/state.slint";
import { TourTarget } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import {
    Actions, Art, BrowserState, BrowserView, CollectionKind, LibraryView, NavItem, Navigation, Page, PlayerView, Session,
    SidebarHiddenPages, SidebarPage, WindowFrame,
} from "state.slint";
import { Equalizer, Icon, IconButton, Logo, MenuItem, MenuSurface, TooltipBubble } from "widgets.slint";
import { WindowDragArea } from "frame.slint";

// Marks the open page's row with a sunlit bar along its left edge.
component SunEdge inherits Rectangle {
    width: 3px;
    border-radius: 1.5px;
    background: Theme.lit;
}

// A press of the right button, at its place in the window.
component RowTouch inherits TouchArea {
    callback context-menu(Point);
    mouse-cursor: MouseCursor.pointer;
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
            root.context-menu({ x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
        }
    }
}

// A page's row. Its right-click menu hides it from the sidebar.
component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <bool> running;
    in property <bool> can-add;
    in property <string> add-label;
    callback clicked();
    callback add();
    callback context-menu(Point);
    height: 36px;
    border-radius: Theme.radius-row;
    background: touch.has-hover && !root.active ? Theme.wood-hover : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    if root.active: SunEdge {
        x: 0;
        y: 5px;
        height: root.height - 10px;
    }
    touch := RowTouch {
        clicked => {
            root.clicked();
        }
        context-menu(position) => {
            root.context-menu(position);
        }
    }

    HorizontalLayout {
        padding-left: Theme.sidebar-icon-padding;
        padding-right: 2px;
        spacing: Theme.sidebar-icon-spacing;
        Icon {
            y: (parent.height - self.height) / 2;
            width: Theme.bar-icon-size;
            height: Theme.bar-icon-size;
            source: root.icon;
            tint: root.active ? Theme.lit : root.running ? Theme.accent : Theme.text-secondary;
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Theme.body;
            font-weight: 700;
            color: root.active ? Theme.lit : Theme.text;
        }

        if root.running: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.lit;
            }
        }

        if root.can-add: IconButton {
            y: (parent.height - self.height) / 2;
            size: 24px;
            icon-size: 16px;
            icon: @image-url("icons/plus.svg");
            tint: Theme.text-faint;
            tooltip: root.add-label;
            clicked => {
                root.add();
            }
        }
    }
}

// A pinned collection's row, led by its painting. Its right-click menu unpins it.
component CollectionLink inherits Rectangle {
    in property <NavItem> item;
    in property <bool> active;
    callback clicked();
    callback context-menu(Point);
    height: 36px;
    border-radius: Theme.radius-row;
    background: touch.has-hover && !root.active ? Theme.wood-hover : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    if root.active: SunEdge {
        x: 0;
        y: 6px;
        height: root.height - 12px;
    }
    touch := RowTouch {
        clicked => {
            root.clicked();
        }
        context-menu(position) => {
            root.context-menu(position);
        }
    }

    HorizontalLayout {
        // The painting centers on the pages' icons, so the titles line up with theirs.
        padding-left: Theme.sidebar-icon-padding - (Theme.pin-thumbnail-size - Theme.bar-icon-size) / 2;
        padding-right: 8px;
        spacing: Theme.sidebar-icon-spacing - (Theme.pin-thumbnail-size - Theme.bar-icon-size) / 2;
        Image {
            y: (parent.height - self.height) / 2;
            width: Theme.pin-thumbnail-size;
            height: Theme.pin-thumbnail-size;
            source: Art.painting(root.item.id, root.item.background, Theme.pin-thumbnail-size, Theme.pin-thumbnail-size, Theme.radius-pin, Art.pictures-revision);
            image-fit: fill;
            opacity: root.item.missing ? 0.5 : 1;
        }

        Text {
            text: root.item.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Theme.body-small;
            font-weight: 500;
            color: root.item.missing ? Theme.text-faint : root.active ? Theme.lit : touch.has-hover ? Theme.text : Theme.text-secondary;
        }

        if root.item.playing: Equalizer {
            y: (parent.height - self.height) / 2;
        }
    }
}

// Says how to pin, under a section with nothing pinned.
component PinHint inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.sidebar-label-padding;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        wrap: word-wrap;
        font-size: Theme.caption;
        color: Theme.text-faint;
    }
}

// The logo, which opens Home. It grows under the pointer and gives a little when pressed, about its
// center; each size keeps that center on a whole pixel.
component HomeLogo inherits Rectangle {
    callback clicked();
    property <length> logo-size: touch.pressed ? 34px : touch.has-hover ? 36px : 32px;
    animate logo-size {
        duration: Motion.logo-grow;
        easing: ease-out;
    }
    width: 40px;
    height: 40px;
    accessible-role: button;
    accessible-label: @tr("Home");
    accessible-description: PlayerView.something-plays ? @tr("Awake while something plays") : @tr("Asleep while nothing plays");
    accessible-action-default => { root.clicked(); }
    Logo {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.logo-size;
        height: root.logo-size;
        asleep: !PlayerView.something-plays;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SidebarForm inherits Rectangle {
    in property <bool> shown;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity {
        duration: root.shown ? Motion.sidebar-fade-in : Motion.sidebar-fade-out;
        delay: root.shown ? Motion.sidebar-fade-in-delay : 0ms;
    }
}

component FullSidebar inherits SidebarForm {
    TourTarget {
        anchor: HomeTour.navigation;
        available: root.shown;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    callback open-page(Page, string);
    callback collapse();
    callback open-search();
    callback add(CollectionKind);
    property <Page> page: Navigation.page;
    property <SidebarHiddenPages> hidden: Navigation.hidden-pages;
    // The right-clicked row: a page, or a pinned collection when `menu-collection-id` is set.
    property <SidebarPage> menu-page;
    property <string> menu-collection-id;
    property <Point> menu-position;
    width: Theme.sidebar-width;

    function show-page-menu(page: SidebarPage, position: Point) {
        root.menu-page = page;
        root.menu-collection-id = "";
        root.show-menu(position);
    }

    function show-pin-menu(id: string, position: Point) {
        root.menu-collection-id = id;
        root.show-menu(position);
    }

    function show-menu(position: Point) {
        root.menu-position = { x: position.x - root.absolute-position.x, y: position.y - root.absolute-position.y };
        row-menu.show();
    }
    VerticalLayout {
        HorizontalLayout {
            height: Theme.title-row-height;
            padding-right: Theme.sidebar-row-padding;
            alignment: end;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: Theme.bar-button-size;
                icon-size: Theme.bar-icon-size;
                icon: @image-url("icons/panel-left-close.svg");
                tooltip: @tr("Collapse (Ctrl+B)");
                tooltip-enabled: root.shown;
                clicked => {
                    root.collapse();
                }
            }
        }

        HorizontalLayout {
            padding-left: Theme.sidebar-row-padding;
            padding-right: Theme.sidebar-row-padding;
            padding-bottom: 8px;
            search := Rectangle {
                height: 34px;
                border-radius: Theme.radius-row;
                background: search-touch.has-hover ? Theme.wood-hover.with-alpha(0.12) : Theme.wood-field;
                accessible-role: button;
                accessible-label: @tr("Search everything");
                accessible-action-default => { root.open-search(); }
                search-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.open-search();
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.sidebar-icon-padding;
                    padding-right: 10px;
                    spacing: Theme.sidebar-icon-spacing;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: Theme.bar-icon-size;
                        height: Theme.bar-icon-size;
                        source: @image-url("icons/search.svg");
                        tint: Theme.text-faint;
                    }

                    Text {
                        text: @tr("Search");
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: Theme.body-small;
                        color: Theme.text-faint;
                    }

                    Text {
                        text: "Ctrl+Shift+F";
                        vertical-alignment: center;
                        font-size: Theme.micro;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        Flickable {
            mouse-drag-pan-enabled: false;
            vertical-stretch: 1;
            content-height: nav.preferred-height;
            nav := VerticalLayout {
                padding-left: Theme.sidebar-row-padding;
                padding-right: Theme.sidebar-row-padding;
                padding-bottom: 8px;
                spacing: 2px;
                alignment: start;
                if !root.hidden.home: NavRow {
                    icon: @image-url("icons/house.svg");
                    text: @tr("Home");
                    active: root.page == Page.home;
                    clicked => {
                        root.open-page(Page.home, "");
                    }
                    context-menu(position) => {
                        root.show-page-menu(SidebarPage.home, position);
                    }
                }

                if !root.hidden.songs: NavRow {
                    icon: @image-url("icons/music.svg");
                    text: @tr("Songs");
                    active: root.page == Page.songs;
                    clicked => {
                        root.open-page(Page.songs, "");
                    }
                    context-menu(position) => {
                        root.show-page-menu(SidebarPage.songs, position);
                    }
                }

                if !root.hidden.browser && BrowserView.available: NavRow {
                    icon: @image-url("icons/globe.svg");
                    text: @tr("Browser");
                    active: root.page == Page.browser;
                    running: BrowserView.state == BrowserState.open;
                    accessible-description: self.running ? @tr("Browser is open") : "";
                    clicked => {
                        root.open-page(Page.browser, "");
                    }
                    context-menu(position) => {
                        root.show-page-menu(SidebarPage.browser, position);
                    }
                }

                if !root.hidden.playlists: VerticalLayout {
                    padding-top: 6px;
                    spacing: 2px;
                    NavRow {
                        icon: @image-url("icons/list-music.svg");
                        text: @tr("Playlists");
                        active: root.page == Page.playlists;
                        can-add: Session.connected;
                        add-label: @tr("Add Playlist");
                        clicked => {
                            root.open-page(Page.playlists, "");
                        }
                        add => {
                            root.add(CollectionKind.playlist);
                        }
                        context-menu(position) => {
                            root.show-page-menu(SidebarPage.playlists, position);
                        }
                    }

                    for item in LibraryView.nav-playlists: CollectionLink {
                        item: item;
                        active: root.page == Page.playlist && Navigation.collection-id == item.id;
                        clicked => {
                            root.open-page(Page.playlist, item.id);
                        }
                        context-menu(position) => {
                            root.show-pin-menu(item.id, position);
                        }
                    }
                    if LibraryView.nav-playlists.length == 0 && LibraryView.playlists.length > 0: PinHint {
                        text: @tr("Right-click a playlist to pin it here.");
                    }
                }

                if !root.hidden.soundboards: VerticalLayout {
                    padding-top: 6px;
                    spacing: 2px;
                    NavRow {
                        icon: @image-url("icons/layout-grid.svg");
                        text: @tr("Soundboards");
                        active: root.page == Page.soundboards;
                        can-add: Session.connected;
                        add-label: @tr("Add Soundboard");
                        clicked => {
                            root.open-page(Page.soundboards, "");
                        }
                        add => {
                            root.add(CollectionKind.soundboard);
                        }
                        context-menu(position) => {
                            root.show-page-menu(SidebarPage.soundboards, position);
                        }
                    }

                    for item in LibraryView.nav-soundboards: CollectionLink {
                        item: item;
                        active: root.page == Page.soundboard && Navigation.collection-id == item.id;
                        clicked => {
                            root.open-page(Page.soundboard, item.id);
                        }
                        context-menu(position) => {
                            root.show-pin-menu(item.id, position);
                        }
                    }
                    if LibraryView.nav-soundboards.length == 0 && LibraryView.soundboards.length > 0: PinHint {
                        text: @tr("Right-click a soundboard to pin it here.");
                    }
                }
            }
        }
        if !Session.connected: HorizontalLayout {
            padding-left: Theme.sidebar-row-padding + Theme.sidebar-icon-padding;
            padding-right: Theme.sidebar-row-padding;
            padding-top: 6px;
            padding-bottom: 12px;
            spacing: Theme.sidebar-icon-spacing;
            // The dot stands in the icons' column, so the words line up with the pages' names.
            Rectangle {
                width: Theme.bar-icon-size;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.warning;
                }
            }

            Text {
                text: Session.connection-text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                font-size: Theme.caption;
                color: Theme.text-faint;
            }
        }
    }

    row-menu := PopupWindow {
        x: root.menu-position.x;
        y: root.menu-position.y;
        close-policy: close-on-click-outside;
        MenuSurface {
            if root.menu-collection-id == "": MenuItem {
                text: @tr("Hide from the sidebar");
                activated => {
                    Actions.set-sidebar-page-hidden(root.menu-page, true);
                    row-menu.close();
                }
            }
            if root.menu-collection-id != "": MenuItem {
                text: @tr("Unpin from the sidebar");
                activated => {
                    Actions.set-collection-pinned(root.menu-collection-id, false);
                    row-menu.close();
                }
            }
        }
    }
}

component RailButton inherits IconButton {
    in property <bool> active;
    in property <bool> running;
    size: Theme.bar-button-size;
    icon-size: Theme.bar-icon-size;
    border-radius: Theme.radius-row;
    background: root.has-hover && !root.active ? Theme.wood-hover : transparent;
    tint: root.active ? Theme.lit : root.running ? Theme.accent : Theme.text-secondary;
    if root.active: SunEdge {
        x: 0;
        y: 6px;
        height: root.height - 12px;
    }
    if root.running: Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.wood;
        background: Theme.lit;
    }
}

// A pinned collection's painting on the rail, ringed in sunlight while its page is open.
component RailPin inherits Rectangle {
    in property <NavItem> item;
    in property <bool> active;
    in property <bool> tooltip-enabled;
    callback clicked();
    property <bool> tooltip-dismissed;
    width: Theme.rail-pin-size;
    height: Theme.rail-pin-size;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    Image {
        width: Theme.rail-pin-size;
        height: Theme.rail-pin-size;
        source: Art.painting(root.item.id, root.item.background, Theme.rail-pin-size, Theme.rail-pin-size, Theme.radius-pin, Art.pictures-revision);
        image-fit: fill;
        opacity: root.item.missing ? 0.5 : 1;
    }

    if root.active || touch.has-hover: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-pin + 3px;
        border-width: 2px;
        border-color: root.active ? Theme.lit : Theme.wood-hover.with-alpha(0.3);
    }
    if root.item.playing: Rectangle {
        x: parent.width - self.width + 3px;
        y: parent.height - self.height + 3px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.wood;
        background: Theme.lit;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.tooltip-dismissed = true;
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.tooltip-dismissed = false;
            }
        }
        clicked => {
            root.clicked();
        }
    }

    // Slint 1.18 reenters popup cleanup if a visible tooltip is destroyed inside a popup.
    Rectangle {
        visible: touch.has-hover && root.tooltip-enabled && !root.tooltip-dismissed;
        Tooltip {
            TooltipBubble {
                text: root.item.title;
            }
        }
    }
}

component Rail inherits SidebarForm {
    TourTarget {
        anchor: HomeTour.navigation;
        available: root.shown;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    callback open-page(Page, string);
    callback expand();
    callback open-search();
    property <Page> page: Navigation.page;
    property <SidebarHiddenPages> hidden: Navigation.hidden-pages;
    width: Theme.rail-width;
    VerticalLayout {
        padding-top: Theme.title-row-height;
        padding-bottom: 8px;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            RailButton {
                icon: @image-url("icons/panel-left-open.svg");
                tooltip: @tr("Expand (Ctrl+B)");
                tooltip-enabled: root.shown;
                clicked => {
                    root.expand();
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            RailButton {
                icon: @image-url("icons/search.svg");
                tooltip: @tr("Search everything (Ctrl+Shift+F)");
                tooltip-enabled: root.shown;
                clicked => {
                    root.open-search();
                }
            }
        }

        Flickable {
            mouse-drag-pan-enabled: false;
            vertical-stretch: 1;
            content-height: pages.preferred-height;
            pages := VerticalLayout {
                padding-top: 10px;
                spacing: 4px;
                alignment: start;
                if !root.hidden.home: HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("icons/house.svg");
                        tooltip: @tr("Home");
                        tooltip-enabled: root.shown;
                        active: root.page == Page.home;
                        clicked => {
                            root.open-page(Page.home, "");
                        }
                    }
                }
                if !root.hidden.songs: HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("icons/music.svg");
                        tooltip: @tr("Songs");
                        tooltip-enabled: root.shown;
                        active: root.page == Page.songs;
                        clicked => {
                            root.open-page(Page.songs, "");
                        }
                    }
                }
                if !root.hidden.browser && BrowserView.available: HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("icons/globe.svg");
                        tooltip: self.running ? @tr("Browser is open") : @tr("Browser");
                        tooltip-enabled: root.shown;
                        active: root.page == Page.browser;
                        running: BrowserView.state == BrowserState.open;
                        clicked => {
                            root.open-page(Page.browser, "");
                        }
                    }
                }
                if !root.hidden.playlists: VerticalLayout {
                    padding-top: 6px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            icon: @image-url("icons/list-music.svg");
                            tooltip: @tr("Playlists");
                            tooltip-enabled: root.shown;
                            active: root.page == Page.playlists;
                            clicked => {
                                root.open-page(Page.playlists, "");
                            }
                        }
                    }

                    for item in LibraryView.nav-playlists: HorizontalLayout {
                        alignment: center;
                        RailPin {
                            item: item;
                            active: root.page == Page.playlist && Navigation.collection-id == item.id;
                            tooltip-enabled: root.shown;
                            clicked => {
                                root.open-page(Page.playlist, item.id);
                            }
                        }
                    }
                }
                if !root.hidden.soundboards: VerticalLayout {
                    padding-top: 6px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            icon: @image-url("icons/layout-grid.svg");
                            tooltip: @tr("Soundboards");
                            tooltip-enabled: root.shown;
                            active: root.page == Page.soundboards;
                            clicked => {
                                root.open-page(Page.soundboards, "");
                            }
                        }
                    }

                    for item in LibraryView.nav-soundboards: HorizontalLayout {
                        alignment: center;
                        RailPin {
                            item: item;
                            active: root.page == Page.soundboard && Navigation.collection-id == item.id;
                            tooltip-enabled: root.shown;
                            clicked => {
                                root.open-page(Page.soundboard, item.id);
                            }
                        }
                    }
                }
            }
        }

        // The connection, while it's down; the expanded sidebar says why.
        if !Session.connected: HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 4px;
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.warning;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <bool> expanded;
    // Lies over the page rather than beside it.
    in property <bool> overlaid;
    callback page-opened();
    callback toggle();
    callback open-search();
    callback add(CollectionKind);
    width: root.expanded ? Theme.sidebar-width : Theme.rail-width;
    animate width {
        duration: Motion.sidebar-slide;
        easing: Motion.sidebar-slide-easing;
    }
    // Over the page, the rim's wood is solid, so the page doesn't show through.
    background: root.overlaid ? Theme.wood : transparent;
    border-top-left-radius: WindowFrame.corner-radius;
    border-bottom-left-radius: WindowFrame.corner-radius;
    clip: true;

    WindowDragArea {
        y: 0;
        height: Theme.title-row-height;
    }

    HomeLogo {
        x: (Theme.rail-width - self.width) / 2;
        y: (Theme.title-row-height - self.height) / 2;
        clicked => {
            Actions.open-page(Page.home, "");
            root.page-opened();
        }
    }

    FullSidebar {
        x: 0;
        shown: root.expanded;
        open-page(page, id) => {
            Actions.open-page(page, id);
            root.page-opened();
        }
        collapse => {
            root.toggle();
        }
        open-search => {
            root.open-search();
        }
        add(kind) => {
            root.add(kind);
        }
    }

    Rail {
        x: 0;
        shown: !root.expanded;
        open-page(page, id) => {
            Actions.open-page(page, id);
            root.page-opened();
        }
        expand => {
            root.toggle();
        }
        open-search => {
            root.open-search();
        }
    }

}
