// Where the audio goes, beside the window's buttons: a chip naming the output now, and the picker
// it opens.

import { PlaybackTour } from "tours/playback.slint";
import { GuidedTours } from "tours/state.slint";
import { TourTarget } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import { Actions, CurrentOutput, OutputRow, OutputRowKind, Session, VoiceBadge } from "state.slint";
import { Icon, IconButton, MenuSurface, TextLink, TooltipBubble } from "widgets.slint";

component OutputItem inherits Rectangle {
    in property <OutputRow> output;
    callback picked();
    property <bool> guild: root.output.kind == OutputRowKind.guild;
    height: root.guild ? 32px : 38px;
    border-radius: Theme.radius-small;
    background: root.guild ? transparent : root.output.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.hover; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.guild: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: Theme.field;
            Text {
                text: root.output.initial;
                font-size: Theme.micro;
                font-weight: 700;
                color: Theme.text-secondary;
            }
        }
        if !root.guild: Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: root.output.kind == OutputRowKind.local ? @image-url("icons/monitor.svg") : @image-url("icons/volume-2.svg");
            tint: root.output.selected ? Theme.accent : Theme.text-faint;
        }
        Text {
            text: root.output.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: root.guild ? Theme.caption : Theme.body-small;
            font-weight: root.guild ? 700 : 500;
            color: root.guild ? Theme.text-faint : Theme.text;
        }

        if root.output.selected: Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("icons/check.svg");
            tint: Theme.accent;
        }
    }

    touch := TouchArea {
        enabled: !root.guild;
        mouse-cursor: root.guild ? MouseCursor.default : MouseCursor.pointer;
        clicked => {
            Actions.select-output(root.output.index);
            root.picked();
        }
    }
}

// Where the audio goes: this computer, or a Discord voice channel.
export component OutputPicker inherits MenuSurface {
    callback picked();
    callback open-settings();
    width: 272px;
    HorizontalLayout {
        padding-left: 10px;
        height: 38px;
        Text {
            text: @tr("Play into");
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: Theme.body-small;
            font-weight: 800;
            color: Theme.text-secondary;
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            size: 32px;
            icon-size: 18px;
            icon: @image-url("icons/refresh-cw.svg");
            tooltip: @tr("Refresh the voice channels");
            enabled: Session.connected && Session.discord-configured;
            clicked => {
                Actions.refresh-outputs();
            }
        }
    }

    for row in Session.outputs: OutputItem {
        output: row;
        picked => {
            root.picked();
        }
    }
    if Session.discord-disabled: HorizontalLayout {
        padding: 10px;
        TextLink {
            text: @tr("The Discord connection is disabled — enable it in Settings");
            font-size: Theme.caption;
            clicked => {
                root.open-settings();
            }
        }
    }
    if !Session.discord-configured: HorizontalLayout {
        padding: 10px;
        TextLink {
            text: @tr("Connect Discord for more outputs");
            font-size: Theme.caption;
            clicked => {
                root.open-settings();
            }
        }
    }
    if Session.voice-status != "": Text {
        text: Session.voice-status;
        font-size: Theme.caption;
        color: Theme.text-faint;
        wrap: word-wrap;
    }
}

// The output the audio goes to now, which opens the picker.
export component OutputChip inherits Rectangle {
    TourTarget {
        anchor: PlaybackTour.output;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    callback open-settings();
    property <CurrentOutput> output: Session.current-output;
    property <bool> channel: root.output.kind == OutputRowKind.channel;
    property <string> title: root.output.guild-name != "" ? @tr("{0} in {1}", root.output.label, root.output.guild-name) : root.output.label;
    property <bool> tooltip-dismissed;
    height: Theme.window-buttons-height + 2px;
    width: min(layout.preferred-width, 240px);
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.hover : Theme.window-controls;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: @tr("Output: {0}", root.title);
    accessible-action-default => { picker-popup.show(); }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.tooltip-dismissed = true;
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.tooltip-dismissed = false;
            }
        }
        clicked => {
            picker-popup.show();
        }
    }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.channel ? @image-url("icons/volume-2.svg") : @image-url("icons/monitor.svg");
            tint: Theme.text-secondary;
        }

        Text {
            text: root.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.label;
            font-weight: 700;
            color: Theme.text;
        }

        Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("icons/chevron-down.svg");
            tint: Theme.text-faint;
        }
    }

    if Session.voice-badge != VoiceBadge.none: Rectangle {
        x: 20px;
        y: 5px;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        border-width: 2px;
        border-color: Theme.still-shade;
        background: Session.voice-badge == VoiceBadge.joining ? Theme.warning : Theme.error;
    }
    // Slint 1.18 reenters popup cleanup if a visible tooltip is destroyed inside a popup.
    Rectangle {
        width: root.width;
        height: root.height;
        visible: root.channel && Session.voice-status != "" && !root.tooltip-dismissed;
        Tooltip {
            TooltipBubble {
                text: root.title;
                detail: Session.voice-status;
            }
        }
    }

    picker-popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 6px;
        width: picker.width;
        picker := OutputPicker {
            picked => {
                picker-popup.close();
            }
            open-settings => {
                picker-popup.close();
                root.open-settings();
            }
        }
    }
}
