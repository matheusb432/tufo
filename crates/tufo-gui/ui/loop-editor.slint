// A song's playback start and loop, placed on its waveform and checked by ear before saving.

import { LoopEditorTour } from "tours/loop-editor.slint";
import { GuidedTours, TourScroll } from "tours/state.slint";
import { TourTarget } from "tours/target.slint";
import { Theme } from "theme.slint";
import { Actions, LoopEditorView, LoopMarker, LoopPreview } from "state.slint";
import { Actions-Row, DialogFrame } from "dialogs.slint";
import { Button, ButtonKind, IconButton, TextField } from "widgets.slint";

component MarkerHandle inherits Rectangle {
    in property <float> fraction;
    in property <length> track-width;
    in property <string> label;
    in property <brush> marker-color;
    in property <bool> flag-at-bottom;
    callback dragged(float);
    width: 16px;
    x: clamp(root.fraction, 0, 1) * root.track-width - self.width / 2;
    visible: root.fraction >= 0 && root.fraction <= 1;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 2px;
        background: root.marker-color;
    }

    property <bool> flag-on-left: root.x + root.width / 2 + flag.width > root.track-width;
    flag := Rectangle {
        x: root.flag-on-left ? parent.width / 2 + 1px - self.width : parent.width / 2 - 1px;
        y: root.flag-at-bottom ? parent.height - self.height : 0px;
        width: flag-text.preferred-width + 10px;
        height: 18px;
        background: root.marker-color;
        flag-text := Text {
            text: root.label;
            color: Theme.on-lit;
            font-size: Theme.caption;
            font-weight: 800;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: MouseCursor.ew-resize;
        moved => {
            if self.pressed {
                root.dragged((root.x + root.width / 2 + self.mouse-x - self.pressed-x) / root.track-width);
            }
        }
    }
}

component WaveformPanel inherits Rectangle {
    callback focus-keys();
    height: 150px;
    border-radius: Theme.radius-row;
    background: Theme.field;
    clip: true;
    function px(fraction: float) -> length {
        clamp(fraction, 0, 1) * root.width
    }

    Rectangle {
        x: root.px(LoopEditorView.loop-start-x);
        width: root.px(LoopEditorView.loop-end-x) - self.x;
        background: Theme.accent.with-alpha(0.12);
    }

    Rectangle {
        x: root.px(LoopEditorView.crossfade-start-x);
        width: root.px(LoopEditorView.loop-end-x) - self.x;
        background: Theme.lit.with-alpha(0.22);
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: LoopEditorView.waveform(self.width, self.height, Theme.text-secondary, LoopEditorView.waveform-revision);
        image-fit: fill;
    }

    Rectangle {
        x: 0px;
        width: root.px(LoopEditorView.playback-start-x);
        background: Theme.scrim;
    }

    Rectangle {
        x: root.px(LoopEditorView.loop-end-x);
        width: root.width - self.x;
        background: Theme.scrim;
    }

    if LoopEditorView.loading: Text {
        text: @tr("Reading the song…");
        color: Theme.text-secondary;
        font-size: Theme.body-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: !LoopEditorView.loading;
        mouse-cursor: MouseCursor.text;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.focus-keys();
                Actions.loop-playhead-set(self.mouse-x / self.width);
            }
        }
    }

    if !LoopEditorView.loading && LoopEditorView.playhead-x >= 0 && LoopEditorView.playhead-x <= 1: Rectangle {
        x: LoopEditorView.playhead-x * root.width;
        width: 1px;
        background: Theme.text;
    }

    if !LoopEditorView.loading: MarkerHandle {
        fraction: LoopEditorView.playback-start-x;
        track-width: root.width;
        label: "1";
        marker-color: Theme.text-secondary;
        flag-at-bottom: true;
        dragged(fraction) => {
            Actions.loop-marker-dragged(LoopMarker.playback-start, fraction);
        }
    }

    if !LoopEditorView.loading: MarkerHandle {
        fraction: LoopEditorView.loop-start-x;
        track-width: root.width;
        label: "2";
        marker-color: Theme.accent;
        dragged(fraction) => {
            Actions.loop-marker-dragged(LoopMarker.loop-start, fraction);
        }
    }

    if !LoopEditorView.loading: MarkerHandle {
        fraction: LoopEditorView.loop-end-x;
        track-width: root.width;
        label: "3";
        marker-color: Theme.lit;
        dragged(fraction) => {
            Actions.loop-marker-dragged(LoopMarker.loop-end, fraction);
        }
    }
}

// Where the zoomed waveform sits in the song; dragging the thumb scrolls it.
component ViewScroller inherits Rectangle {
    height: 8px;
    border-radius: self.height / 2;
    background: Theme.track;
    visible: LoopEditorView.view-visible < 1;
    thumb := Rectangle {
        x: LoopEditorView.view-start * root.width;
        width: max(12px, LoopEditorView.view-visible * root.width);
        border-radius: root.border-radius;
        background: touch.pressed || touch.has-hover ? Theme.text : Theme.text-secondary;
        touch := TouchArea {
            mouse-cursor: MouseCursor.grab;
            moved => {
                if self.pressed {
                    Actions.loop-scroll((thumb.x + self.mouse-x - self.pressed-x) / root.width);
                }
            }
        }
    }
}

component MarkerField inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> placeable;
    in property <bool> showable: true;
    callback typed(string);
    callback place-at-playhead();
    callback show();
    out property <string> text: field.text;
    changed value => {
        field.text = root.value;
    }
    spacing: 4px;
    alignment: stretch;
    field := TextField {
        horizontal-stretch: 1;
        label: root.label;
        text: root.value;
        accepted => {
            root.typed(self.text);
        }
    }

    if root.placeable: VerticalLayout {
        alignment: end;
        HorizontalLayout {
            IconButton {
                size: 36px;
                icon-size: 18px;
                icon: @image-url("icons/pin.svg");
                tooltip: @tr("Move to the playhead");
                clicked => {
                    root.place-at-playhead();
                }
            }

            if root.showable: IconButton {
                size: 36px;
                icon-size: 18px;
                icon: @image-url("icons/search.svg");
                tooltip: @tr("Show on the waveform");
                clicked => {
                    root.show();
                }
            }
        }

        Rectangle {
            height: 4px;
        }
    }
}

export component LoopEditorDialog inherits DialogFrame {
    guide: LoopEditorTour.guide;
    title: @tr("Edit Loop");
    card-width-max: 760px;
    function commit-fields() {
        Actions.loop-marker-typed(LoopMarker.playback-start, start-field.text);
        Actions.loop-marker-typed(LoopMarker.loop-start, loop-start-field.text);
        Actions.loop-marker-typed(LoopMarker.loop-end, loop-end-field.text);
        Actions.loop-crossfade-typed(crossfade-field.text);
    }

    function toggle-preview(preview: LoopPreview) {
        Actions.toggle-loop-preview(preview);
    }

    Timer {
        interval: 33ms;
        running: LoopEditorView.preview != LoopPreview.stopped;
        triggered => {
            Actions.loop-editor-tick();
        }
    }

    property <bool> roomy: markers.width >= 520px;
    // Takes focus once the dialog settles, after the window restores its own focus.
    property <bool> settled: root.progress == 1;
    changed settled => {
        if root.settled {
            keys.focus();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if LoopEditorView.loading {
                return reject;
            }
            if event.text == " " {
                root.toggle-preview(LoopPreview.from-playhead);
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.toggle-preview(LoopPreview.seam);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                Actions.loop-playhead-step(event.text == Key.RightArrow, event.modifiers.shift);
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                Actions.loop-zoom(event.text == Key.UpArrow);
                return accept;
            }
            if event.text == "1" {
                Actions.loop-marker-at-playhead(LoopMarker.playback-start);
                return accept;
            }
            if event.text == "2" {
                Actions.loop-marker-at-playhead(LoopMarker.loop-start);
                return accept;
            }
            if event.text == "3" {
                Actions.loop-marker-at-playhead(LoopMarker.loop-end);
                return accept;
            }
            if event.text == Key.Return && LoopEditorView.can-save {
                root.commit-fields();
                Actions.save-song-loop();
                return accept;
            }
            reject
        }
        VerticalLayout {
            spacing: 20px;
            Text {
                text: LoopEditorView.song-title;
                color: Theme.text-secondary;
                font-size: Theme.body;
                overflow: elide;
            }

            if LoopEditorView.notice != "": Text {
                text: LoopEditorView.notice;
                color: Theme.warning;
                font-size: Theme.body-small;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 8px;
                WaveformPanel {
                    TourTarget {
                        anchor: LoopEditorTour.waveform;
                        scroll: TourScroll.dialog;
                        bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
                    }
                    focus-keys => {
                        keys.focus();
                    }
                }

                ViewScroller { }
            }


            preview-row := HorizontalLayout {
                TourTarget {
                    anchor: LoopEditorTour.preview;
                    scroll: TourScroll.dialog;
                    bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
                }
                spacing: 4px;
                IconButton {
                    size: 36px;
                    icon-size: 18px;
                    icon: @image-url("icons/minus.svg");
                    tooltip: @tr("Zoom out (Down)");
                    enabled: !LoopEditorView.loading;
                    clicked => {
                        Actions.loop-zoom(false);
                    }
                }

                IconButton {
                    size: 36px;
                    icon-size: 18px;
                    icon: @image-url("icons/plus.svg");
                    tooltip: @tr("Zoom in on the playhead (Up)");
                    enabled: !LoopEditorView.loading;
                    clicked => {
                        Actions.loop-zoom(true);
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: LoopEditorView.playhead-text;
                    color: Theme.text;
                    font-size: Theme.body-small;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    accessible-role: text;
                    accessible-label: @tr("Playhead {0}", LoopEditorView.playhead-text);
                }

                IconButton {
                    size: 36px;
                    icon-size: 18px;
                    icon: LoopEditorView.preview == LoopPreview.from-playhead ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                    tint: LoopEditorView.preview == LoopPreview.from-playhead ? Theme.lit : Theme.text-secondary;
                    tooltip: LoopEditorView.preview == LoopPreview.from-playhead ? @tr("Stop (Space)") : @tr("Play from the playhead (Space)");
                    enabled: !LoopEditorView.loading;
                    clicked => {
                        root.toggle-preview(LoopPreview.from-playhead);
                    }
                }

                IconButton {
                    size: 36px;
                    icon-size: 18px;
                    icon: @image-url("icons/repeat.svg");
                    tint: LoopEditorView.preview == LoopPreview.seam ? Theme.lit : Theme.text-secondary;
                    tooltip: LoopEditorView.preview == LoopPreview.seam ? @tr("Stop (R)") : @tr("Repeat the seam (R)");
                    enabled: !LoopEditorView.loading;
                    clicked => {
                        root.toggle-preview(LoopPreview.seam);
                    }
                }
            }
            markers := GridLayout {
                TourTarget {
                    anchor: LoopEditorTour.markers;
                    scroll: TourScroll.dialog;
                    bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
                }
                spacing-horizontal: 16px;
                spacing-vertical: 12px;
                Row {
                    start-field := MarkerField {
                        showable: root.roomy;
                        label: @tr("Start (1)");
                        value: LoopEditorView.playback-start-text;
                        placeable: true;
                        typed(text) => {
                            Actions.loop-marker-typed(LoopMarker.playback-start, text);
                        }
                        place-at-playhead => {
                            Actions.loop-marker-at-playhead(LoopMarker.playback-start);
                        }
                        show => {
                            Actions.loop-show-marker(LoopMarker.playback-start);
                        }
                    }

                    loop-start-field := MarkerField {
                        showable: root.roomy;
                        label: @tr("Loop (2)");
                        value: LoopEditorView.loop-start-text;
                        placeable: true;
                        typed(text) => {
                            Actions.loop-marker-typed(LoopMarker.loop-start, text);
                        }
                        place-at-playhead => {
                            Actions.loop-marker-at-playhead(LoopMarker.loop-start);
                        }
                        show => {
                            Actions.loop-show-marker(LoopMarker.loop-start);
                        }
                    }
                }

                Row {
                    loop-end-field := MarkerField {
                        showable: root.roomy;
                        label: @tr("End (3)");
                        value: LoopEditorView.loop-end-text;
                        placeable: true;
                        typed(text) => {
                            Actions.loop-marker-typed(LoopMarker.loop-end, text);
                        }
                        place-at-playhead => {
                            Actions.loop-marker-at-playhead(LoopMarker.loop-end);
                        }
                        show => {
                            Actions.loop-show-marker(LoopMarker.loop-end);
                        }
                    }

                    crossfade-field := MarkerField {
                        label: @tr("Crossfade (ms)");
                        value: LoopEditorView.crossfade-text;
                        typed(text) => {
                            Actions.loop-crossfade-typed(text);
                        }
                    }
                }
            }

            Text {
                text: @tr("Space plays, R repeats the seam, arrows move the playhead (Shift for fine steps) and zoom, 1–3 place markers.");
                color: Theme.text-faint;
                font-size: Theme.caption;
                wrap: word-wrap;
            }

            if LoopEditorView.error != "": Text {
                text: LoopEditorView.error;
                color: Theme.error;
                font-size: Theme.body-small;
                wrap: word-wrap;
            }

            Actions-Row {
                if LoopEditorView.has-saved-loop: Button {
                    text: @tr("Remove Loop");
                    kind: ButtonKind.quiet;
                    clicked => {
                        Actions.delete-song-loop();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: @tr("Cancel");
                    kind: ButtonKind.quiet;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: @tr("Save");
                    kind: ButtonKind.primary;
                    enabled: LoopEditorView.can-save;
                    clicked => {
                        root.commit-fields();
                        Actions.save-song-loop();
                    }
                }
            }
        }
    }
}
