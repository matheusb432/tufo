import { Theme } from "../theme.slint";
import { IconButton } from "../widgets.slint";
import { GuidedTours, Tour, TourId, TourVisibility } from "state.slint";

export component TourButton inherits IconButton {
    in property <Tour> guide;
    in property <string> label;
    in property <bool> available: true;
    property <bool> unseen: true;
    property <bool> ready: GuidedTours.ready;
    property <TourId> tour-id: root.guide.id;
    property <int> seen-revision: GuidedTours.seen-revision;
    property <int> restoration: GuidedTours.restore-revision;
    visible: GuidedTours.visibility == TourVisibility.always-show || (GuidedTours.visibility == TourVisibility.show-unseen && root.unseen);
    size: root.visible ? 28px : 0px;
    icon-size: 18px;
    icon: @image-url("../icons/circle-help.svg");
    tooltip: @tr("Start guide: {0}", root.label);
    tooltip-enabled: root.enabled;
    enabled: root.visible && root.available && !GuidedTours.active;
    accessible-enabled: root.enabled;
    forward-focus: keys;
    function read-seen() {
        if root.ready {
            root.unseen = !GuidedTours.seen(root.guide.id);
        }
    }
    init => { root.read-seen(); }
    changed ready => { root.read-seen(); }
    changed tour-id => { root.read-seen(); }
    changed seen-revision => { root.read-seen(); }
    changed restoration => {
        if root.enabled && GuidedTours.tour == root.guide.id { keys.focus(); }
    }
    clicked => {
        if root.enabled {
            keys.focus();
            GuidedTours.start(root.guide);
        }
    }
    unseen-marker := Rectangle {
        x: parent.width - 7px;
        y: 3px;
        width: 5px;
        height: 5px;
        border-radius: 3px;
        background: Theme.accent;
        visible: root.unseen;
    }
    Rectangle {
        border-radius: Theme.radius-small;
        border-width: root.enabled && keys.has-focus ? 1px : 0px;
        border-color: Theme.accent;
    }
    keys := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}
