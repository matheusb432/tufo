import { Tour, TourId } from "state.slint";
import { PlaybackTour } from "playback.slint";

export global MiniPlayerTour {
    out property <string> mini-pin: "mini-player.mini-pin";
    out property <Tour> guide: { id: TourId.mini-player, steps: [
        {
            anchor: PlaybackTour.transport,
            title: @tr("Your compact player"),
            body: @tr("The mini player keeps transport, seeking, music volume and effects volume close. Drag outside its controls to move the window."),
        },
        PlaybackTour.volume-step,
        {
            anchor: MiniPlayerTour.mini-pin,
            title: @tr("Keep the player handy"),
            body: @tr("Pin keeps this window above others when the platform supports it. On Wayland, use the desktop window menu's Always on Top instead."),
        },
        {
            anchor: PlaybackTour.mini-switch,
            title: @tr("Return to the full window"),
            body: @tr("Use Full window or Ctrl+Shift+M. Tufo remembers each window size and the pinned state. This guide leaves those choices alone."),
        },
    ] };
}
