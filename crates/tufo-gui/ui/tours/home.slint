import { Tour, TourId } from "state.slint";
import { PlaybackTour } from "playback.slint";

export global HomeTour {
    out property <string> home-recent: "home.home-recent";
    out property <string> home-playlists: "home.home-playlists";
    out property <string> home-soundboards: "home.home-soundboards";
    out property <string> navigation: "home.navigation";
    out property <Tour> guide: { id: TourId.home, steps: [
        {
            anchor: HomeTour.home-recent,
            title: @tr("Jump back in"),
            body: @tr("Once your playlists play, Recently played keeps their latest songs here. Click one to play its playlist again from that song; See all opens the full list."),
        },
        {
            anchor: HomeTour.home-playlists,
            title: @tr("Music for your session"),
            body: @tr("Open a playlist card to browse its songs. The play button on a card starts that playlist; opening the card leaves playback alone."),
        },
        {
            anchor: HomeTour.home-soundboards,
            title: @tr("Sounds beside your music"),
            body: @tr("Open a soundboard for effects and ambience. See all opens the full shelf; empty shelves offer Add and Kenku FM import."),
        },
        {
            anchor: HomeTour.navigation,
            title: @tr("Find your way"),
            body: @tr("The sidebar opens your pages and the playlists and soundboards pinned under them. Right-click a page to hide it, or a collection to pin or unpin it. Ctrl+B switches between the sidebar and its narrow rail."),
        },
        PlaybackTour.transport-step,
        PlaybackTour.seek-step,
        PlaybackTour.volume-step,
        PlaybackTour.output-step,
        PlaybackTour.mini-step,
    ] };
}
