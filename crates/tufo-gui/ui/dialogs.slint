// The add and edit dialogs, Add to playlist, and the settings dialog.

import { CollectionFormTour } from "tours/collection-form.slint";
import { AddToPlaylistTour } from "tours/add-to-playlist.slint";
import { EntryTour } from "tours/entry.slint";
import { SettingsTour } from "tours/settings.slint";
import { GuidedTours, Tour, TourRect, TourScroll, TourVisibility } from "tours/state.slint";
import { TourButton } from "tours/button.slint";
import { TourTarget, TourScrollArea } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import {
    Actions, Art, BackgroundLabel, Backgrounds, BrowserView, CollectionBackground, CollectionKind, LibraryView,
    KenkuImportView, Navigation, PlaylistChoice, Session, SidebarPage, SoundIcons,
} from "state.slint";
import {
    Button, ButtonKind, Icon, IconButton, MenuItem, MenuSurface, Scrim, ScrollThumb, Slider, Switch, TextField, TextLink,
} from "widgets.slint";

// A modal card over a dimmed window. Clicking the dimmed area cancels.
export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <Tour> guide;
    out property <TourRect> card-bounds: GuidedTours.bounds(surface.absolute-position, surface.width, surface.height);
    // Shows a close button beside the title, for a dialog without a Cancel button.
    in property <bool> closable;
    // A `Presence`'s progress, which fades the dialog in and out.
    in property <float> progress: 1;
    in property <length> card-width-max: 440px;
    callback cancel();
    Scrim {
        progress: root.progress;
        clicked => {
            root.cancel();
        }
    }

    // Clear of the title row, whose buttons stay above every dialog.
    surface := Rectangle {
        y: max(Theme.title-row-height, (root.height - self.height) / 2) + Motion.presence-sink(root.progress);
        opacity: root.progress;
        width: min(parent.width - 48px, root.card-width-max);
        height: min(layout.preferred-height, root.height - Theme.title-row-height - 24px);
        background: Theme.raised;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.raised-edge;
        clip: true;
        // Swallows clicks so they don't reach the dimmed area.
        TouchArea { }
        scroll := TourScrollArea {
            tour-scroll: TourScroll.dialog;
            mouse-drag-pan-enabled: false;
            content-width: self.width;
            content-height: layout.preferred-height;
            layout := VerticalLayout {
                padding: 24px;
                spacing: 20px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.title;
                        horizontal-stretch: 0;
                        overflow: elide;
                        vertical-alignment: center;
                        font-family: Theme.display-font;
                        font-size: Theme.heading;
                        font-weight: Theme.display-weight;
                        color: Theme.text;
                    }
                    if root.guide.steps.length > 0: TourButton {
                        y: (parent.height - self.height) / 2;
                        guide: root.guide;
                        label: root.title;
                        available: root.progress == 1;
                    }
                    Rectangle { horizontal-stretch: 1; }

                    if root.closable: IconButton {
                        size: 36px;
                        icon-size: 20px;
                        icon: @image-url("icons/x.svg");
                        tooltip: @tr("Close");
                        tooltip-enabled: root.progress == 1;
                        clicked => {
                            root.cancel();
                        }
                    }
                }

                @children
            }
        }
        ScrollThumb {
            x: parent.width - self.width - 2px;
            y: 12px;
            height: parent.height - 24px;
            content-height: scroll.content-height;
            viewport-height: scroll.height;
            content-y <=> scroll.content-y;
            show: scroll.content-height > scroll.height;
        }
    }

    // Swallows clicks while the dialog moves, so a double click can't act on it twice.
    if root.progress < 1: TouchArea { }
}

export component Actions-Row inherits HorizontalLayout {
    alignment: end;
    spacing: 8px;
}

// The collection's card as the grid will show it, with its title and background, over the
// background's name and a way to change it.
component BackgroundPreview inherits VerticalLayout {
    TourTarget {
        anchor: CollectionFormTour.background;
        scroll: TourScroll.dialog;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    // The collection whose gradient the card shows; empty shows the default.
    in property <string> collection-id;
    in property <string> title;
    in property <CollectionBackground> background;
    in property <BackgroundLabel> label;
    callback change();
    spacing: 10px;
    card := Rectangle {
        height: 160px;
        border-radius: Theme.radius-card;
        accessible-role: button;
        accessible-label: @tr("Change the background");
        Image {
            width: parent.width;
            height: parent.height;
            source: Art.card-background(root.collection-id, root.background, self.width, self.height, Theme.radius-card, Art.pictures-revision);
            image-fit: fill;
        }

        Text {
            x: 16px;
            y: parent.height - self.height - 14px;
            width: parent.width - 32px;
            text: root.title;
            font-size: Theme.subheading;
            font-weight: 800;
            color: Theme.text;
            overflow: elide;
        }

        Rectangle {
            border-radius: Theme.radius-card;
            background: white;
            opacity: card-touch.has-hover ? 0.05 : 0;
            animate opacity { duration: 150ms; }
        }

        card-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.change();
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label.name;
                color: Theme.text;
                font-size: Theme.body-small;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.label.credit;
                color: Theme.text-secondary;
                font-size: Theme.caption;
                overflow: elide;
            }
        }

        Button {
            text: @tr("Change background");
            clicked => {
                root.change();
            }
        }
    }
}

export component AddCollectionDialog inherits DialogFrame {
    guide: CollectionFormTour.new-collection;
    in property <CollectionKind> kind;
    title: root.kind == CollectionKind.playlist ? @tr("Add Playlist") : @tr("Add Soundboard");
    callback change-background(string);
    init => {
        Actions.start-new-collection();
    }
    name := TextField {
        TourTarget {
            anchor: CollectionFormTour.collection-name;
            scroll: TourScroll.dialog;
            bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
        }
        label: @tr("Name");
        accepted => {
            if self.text != "" {
                Actions.create-collection(root.kind, self.text);
                root.cancel();
            }
        }
        init => {
            self.focus();
        }
    }

    VerticalLayout {
        spacing: 4px;
        TextLink {
            text: @tr("Or follow a folder");
            TourTarget {
                anchor: CollectionFormTour.collection-folder;
                scroll: TourScroll.dialog;
                bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
            }
            clicked => {
                Actions.follow-folder(root.kind);
                root.cancel();
            }
        }

        Text {
            text: @tr("Its files stay in sync.");
            color: Theme.text-secondary;
            font-size: Theme.body-small;
            horizontal-stretch: 1;
        }
    }

    BackgroundPreview {
        title: name.text;
        background: Backgrounds.draft;
        label: Backgrounds.draft-label;
        change => {
            root.change-background(name.text);
        }
    }

    Actions-Row {
        Button {
            text: @tr("Cancel");
            kind: ButtonKind.quiet;
            clicked => {
                root.cancel();
            }
        }

        Button {
            text: @tr("Add");
            kind: ButtonKind.primary;
            enabled: name.text != "";
            clicked => {
                Actions.create-collection(root.kind, name.text);
                root.cancel();
            }
        }
    }
}

// A playlist to add the song to; one that lists it already shows a check and takes no click.
component PlaylistChoiceItem inherits Rectangle {
    TourTarget {
        anchor: AddToPlaylistTour.playlist-choices;
        scroll: TourScroll.dialog;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in property <PlaylistChoice> choice;
    callback picked();
    height: 44px;
    border-radius: Theme.radius-row;
    background: touch.has-hover && !root.choice.holds-song ? Theme.hover : transparent;
    animate background { duration: Motion.hover; }
    accessible-role: button;
    accessible-label: root.choice.title;
    accessible-enabled: !root.choice.holds-song;
    accessible-action-default => {
        if !root.choice.holds-song {
            root.picked();
        }
    }
    touch := TouchArea {
        enabled: !root.choice.holds-song;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.picked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("icons/list-music.svg");
            tint: Theme.text-faint;
        }

        Text {
            text: root.choice.title;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body-small;
            font-weight: 700;
            color: root.choice.holds-song ? Theme.text-secondary : Theme.text;
        }

        Text {
            text: root.choice.count-label;
            vertical-alignment: center;
            font-size: Theme.caption;
            color: Theme.text-faint;
        }

        if root.choice.holds-song: Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("icons/check.svg");
            tint: Theme.accent;
        }
    }
}

// Adds one song to a playlist that takes songs by hand, or to a new one named here.
export component AddToPlaylistDialog inherits DialogFrame {
    guide: AddToPlaylistTour.guide;
    in property <string> song-id;
    in property <string> song-title;
    title: @tr("Add to playlist");
    closable: true;
    init => {
        Actions.adding-song-changed(root.song-id);
    }

    function create() {
        if name.text != "" {
            Actions.add-song-to-new-playlist(name.text, root.song-id);
            root.cancel();
        }
    }

    Text {
        text: root.song-title;
        font-size: Theme.body-small;
        color: Theme.text-secondary;
        overflow: elide;
    }

    if LibraryView.playlist-choices.length > 0: VerticalLayout {
        spacing: 2px;
        for choice in LibraryView.playlist-choices: PlaylistChoiceItem {
            choice: choice;
            picked => {
                Actions.add-song-to-playlist(choice.id, root.song-id);
                root.cancel();
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;
        name := TextField {
            TourTarget {
                anchor: CollectionFormTour.collection-name;
                scroll: TourScroll.dialog;
                bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
            }
            horizontal-stretch: 1;
            label: @tr("New playlist");
            placeholder: @tr("Name");
            accepted => {
                root.create();
            }
            init => {
                self.focus();
            }
        }

        VerticalLayout {
            alignment: end;
            Button {
                text: @tr("Create");
                kind: ButtonKind.primary;
                enabled: name.text != "" && Session.connected;
                clicked => {
                    root.create();
                }
            }
        }
    }
}

export component EditCollectionDialog inherits DialogFrame {
    guide: CollectionFormTour.edit-collection;
    title: @tr("Edit");
    callback change-background(string);
    name := TextField {
        TourTarget {
            anchor: CollectionFormTour.collection-name;
            scroll: TourScroll.dialog;
            bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
        }
        label: @tr("Name");
        text: LibraryView.collection-title;
        accepted => {
            Actions.rename-collection(Navigation.collection-id, self.text);
            root.cancel();
        }
    }

    BackgroundPreview {
        collection-id: Navigation.collection-id;
        title: name.text;
        background: LibraryView.collection-background;
        label: LibraryView.collection-background-label;
        change => {
            root.change-background(name.text);
        }
    }

    if Art.picture-missing(LibraryView.collection-background, Art.pictures-revision): Text {
        text: @tr("This image can't be opened anymore, so the gradient shows instead. Change the background to pick another.");
        color: Theme.error;
        font-size: Theme.body-small;
        wrap: word-wrap;
    }

    Actions-Row {
        Button {
            text: @tr("Done");
            kind: ButtonKind.primary;
            clicked => {
                if name.text != "" && name.text != LibraryView.collection-title {
                    Actions.rename-collection(Navigation.collection-id, name.text);
                }
                root.cancel();
            }
        }
    }
}

component SoundIconPicker inherits VerticalLayout {
    TourTarget {
        anchor: EntryTour.sound-icons;
        scroll: TourScroll.dialog;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in-out property <int> selected;
    property <int> columns: 10;
    property <length> cell: grid.width / root.columns;
    spacing: 8px;
    Text {
        text: @tr("Icon: {0}", SoundIcons.labels[root.selected]);
        font-size: Theme.body-small;
        font-weight: 700;
        color: Theme.text-secondary;
    }

    grid := Rectangle {
        height: Math.ceil(SoundIcons.images.length / root.columns) * root.cell;
        for image[index] in SoundIcons.images: Rectangle {
            x: Math.mod(index, root.columns) * root.cell;
            y: Math.floor(index / root.columns) * root.cell;
            width: root.cell;
            height: root.cell;
            border-radius: self.width / 2;
            background: index == root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: SoundIcons.labels[index];
            accessible-checked: index == root.selected;
            accessible-action-default => { root.selected = index; }
            Icon {
                width: 20px;
                height: 20px;
                source: image;
                tint: index == root.selected ? Theme.accent : Theme.text-secondary;
            }

            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.selected = index;
                }
            }
        }
    }
}

// Edits a track's title, or a sound's title, icon, and fades.
export component EditEntryDialog inherits DialogFrame {
    guide: root.sound ? EntryTour.edit-sound : EntryTour.edit-track;
    in property <string> entry-id;
    in property <string> entry-title;
    in property <bool> sound;
    in property <int> fade-in-ms;
    in property <int> fade-out-ms;
    // A position in `SoundIcons.images`.
    in property <int> icon;
    property <int> chosen-icon: root.icon;
    title: root.sound ? @tr("Edit Sound") : @tr("Edit Track");
    name := TextField {
        TourTarget {
            anchor: EntryTour.entry-name;
            scroll: TourScroll.dialog;
            bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
        }
        label: @tr("Name");
        text: root.entry-title;
    }

    if root.sound: SoundIconPicker {
        selected <=> root.chosen-icon;
    }

    HorizontalLayout {
        spacing: 12px;
        visible: root.sound;
        TourTarget {
            anchor: EntryTour.sound-fades;
            available: root.sound;
            scroll: TourScroll.dialog;
            bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
        }
        height: root.sound ? 66px : 0px;
        fade-in := TextField {
            label: @tr("Fade In (ms)");
            text: root.fade-in-ms;
        }

        fade-out := TextField {
            label: @tr("Fade Out (ms)");
            text: root.fade-out-ms;
        }
    }

    Actions-Row {
        Button {
            text: @tr("Cancel");
            kind: ButtonKind.quiet;
            clicked => {
                root.cancel();
            }
        }

        Button {
            text: @tr("Save");
            kind: ButtonKind.primary;
            enabled: name.text != "";
            clicked => {
                if root.sound {
                    Actions.update-sound(root.entry-id, name.text, Math.round(fade-in.text.to-float()), Math.round(fade-out.text.to-float()), root.chosen-icon);
                } else {
                    Actions.rename-entry(root.entry-id, name.text);
                }
                root.cancel();
            }
        }
    }
}

// A titled panel of settings rows.
component SettingsSection inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        font-size: Theme.body-small;
        font-weight: 800;
        color: Theme.text-secondary;
    }

    Rectangle {
        background: Theme.field;
        border-radius: Theme.radius-row;
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            @children
        }
    }
}

component SettingsDivider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// A setting's name over what it does.
component SettingLabel inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: Theme.body;
        font-weight: 700;
        color: Theme.text;
        wrap: word-wrap;
    }

    if root.description != "": Text {
        text: root.description;
        font-size: Theme.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

// A setting's name and what it does, beside its controls.
component SettingRow inherits Rectangle {
    in property <string> tour-anchor;
    in property <string> title;
    in property <string> description;
    TourTarget {
        anchor: root.tour-anchor;
        available: root.tour-anchor != "";
        scroll: TourScroll.dialog;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        SettingLabel {
            alignment: center;
            horizontal-stretch: 1;
            title: root.title;
            description: root.description;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

component SwitchSetting inherits SettingRow {
    in-out property <bool> checked;
    callback toggled(bool);
    Switch {
        label: root.title;
        checked <=> root.checked;
        toggled(checked) => {
            root.toggled(checked);
        }
    }
}

// Saves when the slider is released.
component CrossfadeSetting inherits Rectangle {
    property <int> crossfade-ms-max: 10000;
    TourTarget {
        anchor: SettingsTour.crossfade;
        scroll: TourScroll.dialog;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px;
            SettingLabel {
                horizontal-stretch: 1;
                title: @tr("Crossfade");
                description: @tr("How long consecutive songs overlap.");
            }

            Text {
                text: @tr("{0} s", Math.round(slider.shown-value * root.crossfade-ms-max / 100) / 10);
                vertical-alignment: center;
                font-size: Theme.body;
                font-weight: 700;
                color: Theme.accent;
            }
        }

        slider := Slider {
            value: Session.crossfade-ms / root.crossfade-ms-max;
            step: 0.05;
            fill: Theme.accent;
            thumb-always-visible: true;
            released(value) => {
                Actions.set-crossfade(Math.round(value * root.crossfade-ms-max));
            }
        }
    }
}

struct TourVisibilityOption { visibility: TourVisibility, label: string }

component TourVisibilitySetting inherits SettingRow {
    tour-anchor: SettingsTour.tours;
    title: @tr("Tours");
    description: @tr("When guide icons appear.");
    property <[TourVisibilityOption]> options: [
        { visibility: TourVisibility.always-show, label: @tr("Always show") },
        { visibility: TourVisibility.show-unseen, label: @tr("Show unseen") },
        { visibility: TourVisibility.always-hide, label: @tr("Always hide") },
    ];
    property <int> selected-index: GuidedTours.visibility == TourVisibility.always-show ? 0 : GuidedTours.visibility == TourVisibility.show-unseen ? 1 : 2;
    property <int> keyboard-index;
    function show-menu() {
        root.keyboard-index = root.selected-index;
        menu.show();
    }
    function select(visibility: TourVisibility) {
        menu.close();
        Actions.set-tour-visibility(visibility);
        picker-keys.focus();
    }
    picker := Button {
        // Fits every option, so the button keeps its width as the choice changes.
        min-width: 160px;
        text: root.options[root.selected-index].label;
        icon: @image-url("icons/chevron-down.svg");
        accessible-label: @tr("Tours: {0}", self.text);
        forward-focus: picker-keys;
        clicked => { root.show-menu(); }
        Rectangle {
            border-radius: parent.height / 2;
            border-width: picker-keys.has-focus ? 1px : 0px;
            border-color: Theme.accent;
        }
        picker-keys := FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: true;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow {
                    root.show-menu();
                    return accept;
                }
                reject
            }
        }
        menu := PopupWindow {
            width: picker.width;
            y: picker.height + 4px;
            MenuSurface {
                width: picker.width;
                forward-focus: option-keys;
                init => { option-keys.focus(); }
                for option[index] in root.options: MenuItem {
                    text: option.label;
                    highlighted: index == root.keyboard-index;
                    activated => { root.select(option.visibility); }
                }
                option-keys := FocusScope {
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.text == Key.UpArrow || event.text == Key.DownArrow {
                            root.keyboard-index = clamp(root.keyboard-index + (event.text == Key.DownArrow ? 1 : -1), 0, root.options.length - 1);
                            return accept;
                        }
                        if event.text == Key.Return || event.text == " " {
                            root.select(root.options[root.keyboard-index].visibility);
                            return accept;
                        }
                        if event.text == Key.Escape || event.text == Key.Tab {
                            menu.close();
                            picker-keys.focus();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
    }
}

// Each setting saves as it changes; only a new bot token waits for its button, since saving it
// restarts tufo-server.
export component SettingsDialog inherits DialogFrame {
    guide: SettingsTour.guide;
    title: @tr("Settings");
    closable: true;
    card-width-max: 520px;

    function save-token() {
        if token.text != "" {
            Actions.save-discord-token(token.text);
            root.cancel();
        }
    }

    SettingsSection {
        title: @tr("Discord");
        Rectangle {
            TourTarget {
                anchor: SettingsTour.discord-token;
                scroll: TourScroll.dialog;
                bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
            }

            HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 8px;
                token := TextField {
                    horizontal-stretch: 1;
                    label: @tr("Bot token");
                    password: true;
                    secret-saved: Session.discord-configured;
                    placeholder: Session.discord-configured ? @tr("Paste a new token") : @tr("Paste your bot's token");
                    accepted => {
                        root.save-token();
                    }
                }

                VerticalLayout {
                    alignment: end;
                    padding-bottom: 3px;
                    Button {
                        text: @tr("Save and restart");
                        kind: ButtonKind.primary;
                        enabled: token.text != "";
                        clicked => {
                            root.save-token();
                        }
                    }
                }
            }
        }

        if Session.discord-configured: SettingsDivider { }
        if Session.discord-configured: SwitchSetting {
            tour-anchor: SettingsTour.discord-disable;
            title: @tr("Disable Discord connection");
            description: @tr("Logs the bot out.");
            checked: Session.discord-disabled;
            toggled(checked) => {
                Actions.set-discord-connection-disabled(checked);
            }
        }
    }

    SettingsSection {
        title: @tr("Playback");
        CrossfadeSetting { }
        SettingsDivider { }
        SwitchSetting {
            tour-anchor: SettingsTour.quit-behavior;
            title: @tr("Keep playing after quitting");
            description: @tr("Audio keeps playing after the GUI closes.");
            checked: Session.keep-playing-after-quit;
            toggled(checked) => {
                Actions.set-keep-playing-after-quit(checked);
            }
        }
    }

    SettingsSection {
        title: @tr("General");
        SwitchSetting {
            tour-anchor: SettingsTour.startup;
            title: @tr("Run at startup");
            description: @tr("Starts when you log in.");
            checked: Session.start-at-login;
            toggled(checked) => {
                Actions.set-start-at-login(checked);
            }
        }

        SettingsDivider { }
        TourVisibilitySetting { }
    }

    SettingsSection {
        title: @tr("Sidebar");
        SwitchSetting {
            title: @tr("Home");
            checked: !Navigation.hidden-pages.home;
            toggled(checked) => {
                Actions.set-sidebar-page-hidden(SidebarPage.home, !checked);
            }
        }

        SettingsDivider { }
        SwitchSetting {
            title: @tr("Songs");
            checked: !Navigation.hidden-pages.songs;
            toggled(checked) => {
                Actions.set-sidebar-page-hidden(SidebarPage.songs, !checked);
            }
        }

        if BrowserView.available: VerticalLayout {
            SettingsDivider { }
            SwitchSetting {
                title: @tr("Browser");
                checked: !Navigation.hidden-pages.browser;
                toggled(checked) => {
                    Actions.set-sidebar-page-hidden(SidebarPage.browser, !checked);
                }
            }
        }

        SettingsDivider { }
        SwitchSetting {
            title: @tr("Playlists");
            checked: !Navigation.hidden-pages.playlists;
            toggled(checked) => {
                Actions.set-sidebar-page-hidden(SidebarPage.playlists, !checked);
            }
        }

        SettingsDivider { }
        SwitchSetting {
            title: @tr("Soundboards");
            checked: !Navigation.hidden-pages.soundboards;
            toggled(checked) => {
                Actions.set-sidebar-page-hidden(SidebarPage.soundboards, !checked);
            }
        }
    }

    SettingsSection {
        title: @tr("Library");
        SettingRow {
            tour-anchor: SettingsTour.kenku-launch;
            title: @tr("Kenku FM");
            description: @tr("Imports your library and settings.");
            Button {
                text: KenkuImportView.available ? @tr("View import") : @tr("Import");
                clicked => {
                    Actions.import-kenku-library();
                    root.cancel();
                }
            }
        }

        SettingsDivider { }
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            SettingLabel {
                title: @tr("Song loops");
                description: @tr("Moves saved loops between libraries as a file; importing checks each song’s audio first.");
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("Import…");
                    clicked => {
                        Actions.import-song-loops();
                    }
                }

                Button {
                    text: @tr("Export…");
                    clicked => {
                        Actions.export-song-loops();
                    }
                }
            }
        }
    }
}
