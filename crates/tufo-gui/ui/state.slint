// State the host pushes into the window, and the actions the window asks the host to run.

import { Theme } from "theme.slint";
import { TourVisibility } from "tours/state.slint";

export enum Page { home, songs, playlists, playlist, soundboards, soundboard, browser }

export enum CollectionKind { playlist, soundboard }

export enum OutputRowKind { local, guild, channel }

export enum VoiceBadge { none, joining, dropped }

// The form the window switches to once the one on show has faded out. `none` means no switch
// is waiting.
export enum FormSwitch { none, to-mini-player, to-full-window }

// Which collection's background a picker changes. `none` means no dialog shows a picker.
export enum BackgroundTarget { none, new-collection, open-collection }

// What a collection shows behind it: a preset, an image file, or, with neither, its gradient.
export struct CollectionBackground {
    // A preset's position in the host's list, or -1.
    preset: int,
    // An image file's path, or empty.
    image-path: string,
}

// A background's name, and the line under it: a painting's artist and year, or an image's
// folder.
export struct BackgroundLabel {
    name: string,
    credit: string,
}

export struct BackgroundPresetTile {
    // The preset's position in the host's list, which `CollectionBackground.preset` names.
    preset: int,
    label: BackgroundLabel,
}

export struct BackgroundGroup {
    name: string,
    presets: [BackgroundPresetTile],
}

export struct CollectionCard {
    id: string,
    title: string,
    // How many tracks or sounds it holds, as a sentence fragment.
    count-label: string,
    background: CollectionBackground,
    // A playlist whose music is playing now, or a soundboard with a sound playing.
    playing: bool,
    missing: bool,
}

// A collection as the sidebar lists it.
export struct NavItem {
    id: string,
    title: string,
    playing: bool,
    missing: bool,
}

export enum LoopMarker { playback-start, loop-start, loop-end }

export enum LoopPreview { stopped, from-playhead, seam }

// The editor's fields as typed, including text not yet entered.
export struct LoopFieldTexts {
    playback-start: string,
    loop-start: string,
    loop-end: string,
    crossfade: string,
}

export enum LoopBadge { none, saved, needs-review }

export struct TrackRow {
    id: string,
    // The audio file's id, which Add to playlist adds.
    song-id: string,
    title: string,
    duration: string,
    date-added: string,
    source: string,
    missing: bool,
    // A song in the mix, playing or paused.
    current: bool,
    playing: bool,
    // Its place in the queue, from 1, or 0.
    queue-number: int,
    loop-badge: LoopBadge,
}

// A song on the Songs page or among a playlist's song search results.
export struct SongRow {
    // The audio file's id.
    id: string,
    title: string,
    duration: string,
    date-added: string,
    source: string,
    missing: bool,
    // Added by its own path, so it can leave the songs; a followed folder keeps the others.
    removable: bool,
    loop-badge: LoopBadge,
}

// A followed folder of music.
export struct SongFolder {
    id: string,
    path: string,
    // How many songs it holds, such as "12 songs".
    count-label: string,
}

// A hand-picked playlist that Add to playlist offers.
export struct PlaylistChoice {
    id: string,
    title: string,
    count-label: string,
    // It lists the song already.
    holds-song: bool,
}

export struct SoundTile {
    id: string,
    title: string,
    // A position in `SoundIcons.images`.
    icon: int,
    looping: bool,
    volume: float,
    fade-in-ms: int,
    fade-out-ms: int,
    playing: bool,
    // How far a playing sound is through its file, from 0 to 1.
    progress: float,
    missing: bool,
}

export struct MusicLayer {
    id: string,
    title: string,
    volume: float,
    looping: bool,
}

export struct OutputRow {
    kind: OutputRowKind,
    label: string,
    // A guild's first letter, shown in place of its icon.
    initial: string,
    selected: bool,
    // The output's position in the host's list; -1 for guild headers.
    index: int,
}

export struct CurrentOutput {
    kind: OutputRowKind,
    label: string,
    guild-name: string,
    guild-initial: string,
}

export struct SoundChip {
    id: string,
    title: string,
    progress: float,
    looping: bool,
}

export struct SearchResult {
    // "Music", "Sounds", or "Collections".
    section: string,
    title: string,
    subtitle: string,
}

// Whether the browser runs, and why it stopped when it closed on its own.
export enum BrowserState { closed, starting, open, stopped-idle, crashed, start-failed, unavailable }

// How the browser's pane draws the pointer over a page.
export enum BrowserPointer {
    default, hand, text, wait, progress, crosshair, move, not-allowed, grab, grabbing, help,
    column-resize, row-resize, nesw-resize, nwse-resize, none,
}

export enum BrowserPointerKind { move, down, up, leave }

export enum BrowserButton { none, left, middle, right }

export struct BrowserModifiers {
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
}

export struct BrowserTabView {
    id: int,
    title: string,
    loading: bool,
    audible: bool,
}

export global BrowserView {
    in property <BrowserState> state;
    in property <[BrowserTabView]> tabs;
    // The selected tab's id, or -1.
    in property <int> selected-tab: -1;
    // The selected tab's address, empty for a blank tab.
    in property <string> address;
    in property <bool> loading;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    // Why the selected tab shows no page; empty while it shows one.
    in property <string> failure;
    // The selected tab's pixels, at the pane's physical size.
    in property <image> frame;
    in property <BrowserPointer> pointer;
    in property <float> volume: 1.0;
    in property <bool> muted;
    // Some page plays now.
    in property <bool> audible;
}

export global Session {
    in property <bool> connected;
    in property <string> connection-text: @tr("Connecting to tufo-server…");
    in property <[OutputRow]> outputs;
    in property <bool> discord-configured;
    in property <bool> discord-disabled;
    in property <string> voice-status;
    in property <VoiceBadge> voice-badge;
    in property <CurrentOutput> current-output;
    in-out property <bool> drawer-pinned: true;
    in-out property <bool> player-collapsed;
    // The window shows only the player, as a small widget.
    in property <bool> mini-player;
    in-out property <bool> mini-player-pinned: true;
    // False on Wayland, where only the desktop's window menu keeps a window above the others.
    in property <bool> always-on-top-supported: true;
    // A short message at the bottom of the window; empty hides it.
    in property <string> toast;
    in property <bool> toast-is-error;
    // Files are being dragged over a page that accepts them.
    in property <bool> drop-hover;
    in property <string> drop-label;
    in property <int> crossfade-ms: 2000;
    // Quitting Tufo leaves tufo-server running, and Tufo never starts it.
    in property <bool> keep-playing-after-quit;
    in property <bool> start-at-login;
}

export global Navigation {
    in-out property <Page> page: Page.home;
    in-out property <string> collection-id;
}

export global LibraryView {
    // The library has arrived from the server at least once.
    in property <bool> loaded;
    in property <[CollectionCard]> playlists;
    in property <[CollectionCard]> soundboards;
    in property <int> playlist-count;
    in property <int> soundboard-count;
    // Every collection, unfiltered, for the sidebar.
    in property <[NavItem]> nav-playlists;
    in property <[NavItem]> nav-soundboards;
    in property <string> collection-title;
    // Its size, such as "10 tracks, 36 minutes".
    in property <string> collection-summary;
    in property <CollectionBackground> collection-background;
    in property <BackgroundLabel> collection-background-label;
    in property <bool> collection-linked;
    in property <string> collection-folder;
    in property <bool> collection-missing;
    in property <int> order-key;
    in property <bool> order-descending;
    in property <[TrackRow]> tracks;
    in property <[SoundTile]> sounds;
    // The open hand-picked playlist's song search results.
    in property <[SongRow]> song-search-results;
    // The Songs page: how many there are, the followed folders, and the rows the filter matches.
    in property <string> songs-summary;
    in property <[SongFolder]> song-folders;
    in property <[SongRow]> songs;
    // Says how many matching songs the rows leave out; empty when none.
    in property <string> songs-overflow;
    // The hand-picked playlists for the song the Add to playlist dialog adds.
    in property <[PlaylistChoice]> playlist-choices;
}

export global PlayerView {
    in property <bool> has-music;
    in property <bool> has-playback;
    in property <string> entry-id;
    in property <bool> can-add-layer: true;
    in property <int> layer-count;
    in property <[MusicLayer]> music-layers;
    in property <string> title;
    in property <string> collection-id;
    in property <string> collection-title;
    in property <CollectionBackground> collection-background;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed: "0:00";
    in property <string> remaining: "-0:00";
    in property <float> volume: 1.0;
    in property <float> effects-volume: 1.0;
    in property <bool> muted;
    in property <bool> shuffle;
    // 0 off, 1 playlist, 2 track.
    in property <int> repeat: 1;
    in property <bool> songs-queued;
    in property <[SoundChip]> sounds;
    in property <bool> sounds-paused;
    out property <bool> something-plays: (self.has-playback && self.playing) || (self.sounds.length > 0 && !self.sounds-paused);
}

// Ctrl+F filters the open page; Ctrl+Shift+F searches everything. A hand-picked playlist also
// searches the songs to add to it.
export global Search {
    in-out property <bool> filter-open;
    in-out property <string> filter-text;
    in-out property <string> song-search-text;
    in-out property <bool> palette-open;
    in-out property <string> palette-query;
    in property <[SearchResult]> results;
    in-out property <int> selected;
}

// The background gallery, and the background the Add dialog creates its collection with.
export global Backgrounds {
    in property <[BackgroundGroup]> groups;
    in property <CollectionBackground> draft;
    in property <BackgroundLabel> draft-label;
}

// In the host's `SoundIcon` order.
export global SoundIcons {
    in property <[image]> images;
    in property <[string]> labels;
}

// Pictures the host draws off the UI thread, sized and rounded for where they show, since the
// software renderer can't round gradients or images.
export global Art {
    // Holds existing artwork through the sidebar's slide; ending it requests settled sizes.
    callback layout-moving(bool);
    in property <int> backdrop-revision;
    // The felt at its size: its still gradient, shaded by the rim's recess reaching the given depth
    // in from its edges, with corners of the given radius left transparent.
    pure callback backdrop(length, length, length, length, color, color, color, int) -> image;
    // Rises whenever the worker delivers a picture, or pictures that failed may decode now.
    in property <int> pictures-revision;
    // A collection's background with rounded corners, at the given size: its preset or image,
    // otherwise the gradient derived from its id, or Tufo's own gradient for an empty id. The last
    // arguments are the corners' radius and `pictures-revision`, which the host ignores; passing
    // it draws the picture again when it rises.
    pure callback painting(string, CollectionBackground, length, length, length, int) -> image;
    // The same, shaded along its foot for a title over it, as a collection's card shows it.
    pure callback card-background(string, CollectionBackground, length, length, length, int) -> image;
    // Whether the background's image file can't be opened, so its gradient shows instead.
    pure callback picture-missing(CollectionBackground, int) -> bool;
}

// Time for the accents on whatever plays, in seconds. It advances only while it's enabled and
// something plays; otherwise the accents hold still and draw nothing new.
export global Clock {
    in-out property <float> seconds;
    // The window has focus.
    in property <bool> enabled;
}

// The window draws its own frame, so its buttons and title row reach the window through here.
export global WindowFrame {
    callback minimize();
    callback toggle-maximized();
    // Opens the desktop's window menu at this point in the window.
    callback show-menu(length, length);
    // Shrinks the window to the mini player, or grows it back to its full size, at once.
    callback set-mini-player(bool);
    // The window's size changed while it wasn't maximized.
    callback resized(length, length);
    // The desktop shows through the window's transparent pixels, and the window doesn't fill the
    // screen. Whatever touches a corner of the window rounds it by `corner-radius`.
    in property <bool> corners-rounded;
    out property <length> corner-radius: root.corners-rounded ? Theme.radius-window : 0px;
    // How much of the page's bar the output and the window's buttons cover at its right end.
    in-out property <length> title-controls-width: Theme.window-buttons-width;
    in-out property <FormSwitch> form-switch;
    // Fades the form on show out, then switches the window to the other one.
    public function switch-form() {
        if root.form-switch == FormSwitch.none {
            root.form-switch = Session.mini-player ? FormSwitch.to-full-window : FormSwitch.to-mini-player;
        }
    }
}

export struct KenkuConflictRow {
    incoming: string,
    existing: string,
    kind: string,
    overwrite: bool,
}

export global KenkuImportView {
    in-out property <bool> open;
    in-out property <bool> available;
    in-out property <bool> busy;
    in-out property <bool> choosing;
    in-out property <bool> can-retry;
    in-out property <int> percent;
    in-out property <string> stage;
    in-out property <string> summary;
    in-out property <string> error;
    in-out property <[string]> unreadable;
    in-out property <[string]> unsupported;
    in-out property <[KenkuConflictRow]> conflicts;
}

// The draft loop the editor shows. Marker positions are fractions of the visible waveform,
// outside 0 to 1 when scrolled out of view.
export global LoopEditorView {
    in-out property <bool> open;
    in property <string> song-title;
    in property <bool> loading;
    in property <string> notice;
    in property <string> error;
    in property <bool> has-saved-loop;
    in property <bool> can-save;
    in property <string> playback-start-text;
    in property <string> loop-start-text;
    in property <string> loop-end-text;
    in property <string> crossfade-text;
    in property <string> playhead-text;
    in property <float> playback-start-x;
    in property <float> loop-start-x;
    in property <float> loop-end-x;
    in property <float> crossfade-start-x;
    in property <float> playhead-x;
    // The share of the song before the view, and the share it shows.
    in property <float> view-start;
    in property <float> view-visible: 1;
    in property <int> waveform-revision;
    in property <LoopPreview> preview;
    // The visible peaks at this size and color; the last argument redraws it when it rises.
    pure callback waveform(length, length, color, int) -> image;
}

export enum SongLoopImportRowState { ok, conflict, failed }

export struct SongLoopImportRow {
    path: string,
    outcome: string,
    state: SongLoopImportRowState,
}

export global SongLoopImportView {
    in-out property <bool> open;
    in property <bool> busy;
    in property <string> summary;
    in property <[SongLoopImportRow]> rows;
    in property <int> conflicts;
    in-out property <bool> replace;
    in property <bool> can-import;
}

export global Actions {
    callback open-page(Page, string);
    callback filter-changed(string);
    callback song-search-changed(string);
    callback palette-query-changed(string);
    callback palette-activate(int);

    callback create-collection(CollectionKind, string);
    callback follow-folder(CollectionKind);
    callback rename-collection(string, string);
    // The Add dialog opened; the host picks the draft's preset.
    callback start-new-collection();
    callback pick-background(BackgroundTarget, CollectionBackground);
    callback choose-background-file(BackgroundTarget);
    callback delete-collection(string);
    callback set-order(int, bool);
    callback add-files(string);

    callback play-collection(string);
    callback play-track(string);
    callback add-music-layer(string);
    callback add-to-queue(string);
    callback remove-from-queue(string);
    callback stop-music-layer(string);
    callback set-music-layer-volume(string, float);
    callback set-music-layer-looping(string, bool);
    callback rename-entry(string, string);
    callback delete-entry(string);

    // The song the Add to playlist dialog adds, for the host to list the playlists, or empty
    // once the dialog closes.
    callback adding-song-changed(string);
    // The playlist, then the song.
    callback add-song-to-playlist(string, string);
    // The new playlist's title, then the song.
    callback add-song-to-new-playlist(string, string);
    callback remove-song(string);
    callback unfollow-folder(string);

    callback toggle-sound(string);
    callback set-sound-looping(string, bool);
    callback set-sound-volume(string, float);
    // The entry, its title, its fades in milliseconds, and its icon's position in `SoundIcons`.
    callback update-sound(string, string, int, int, int);
    callback stop-sound(string);
    callback toggle-sounds-paused();

    callback toggle-play-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback set-volume(float);
    callback set-effects-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();

    callback select-output(int);
    callback set-drawer-pinned(bool);
    callback set-player-collapsed(bool);
    callback set-mini-player-pinned(bool);
    callback refresh-outputs();
    // In milliseconds.
    callback set-crossfade(int);
    callback set-keep-playing-after-quit(bool);
    callback set-tour-visibility(TourVisibility);
    callback set-start-at-login(bool);
    // Restarts tufo-server, so its bot logs in with the new token.
    callback save-discord-token(string);
    // Logs the bot out of Discord, or back in, without a restart.
    callback set-discord-connection-disabled(bool);
    callback import-kenku-library();
    callback start-kenku-import();
    callback retry-kenku-import();
    callback choose-kenku-conflict(int, bool);
    callback confirm-kenku-import();

    // The song's audio file id.
    callback edit-song-loop(string);
    callback close-loop-editor();
    callback loop-marker-dragged(LoopMarker, float);
    callback loop-marker-typed(LoopMarker, string);
    // In milliseconds.
    callback loop-crossfade-typed(string);
    callback loop-playhead-set(float);
    // Forward or back, by a fine step or a coarse one.
    callback loop-playhead-step(bool, bool);
    callback loop-marker-at-playhead(LoopMarker);
    callback loop-show-marker(LoopMarker);
    callback loop-zoom(bool);
    callback loop-scroll(float);
    callback toggle-loop-preview(LoopPreview);
    callback loop-editor-tick();
    callback save-song-loop(LoopFieldTexts);
    callback delete-song-loop();
    callback export-song-loops();
    callback import-song-loops();
    callback set-song-loop-import-replace(bool);
    callback confirm-song-loop-import();
    callback close-song-loop-import();

    callback open-browser();
    callback close-browser();
    // What was typed into the address field: an address, a host, or words to search for.
    callback browser-navigate(string);
    callback browser-new-tab();
    // A tab's id.
    callback browser-select-tab(int);
    callback browser-close-tab(int);
    callback browser-back();
    callback browser-forward();
    callback browser-reload();
    callback browser-stop();
    // The pane's size.
    callback browser-view-resized(length, length);
    // Where in the pane, and which button for presses and releases.
    callback browser-pointer(BrowserPointerKind, BrowserButton, length, length, BrowserModifiers);
    // Where in the pane, then how far to scroll each way.
    callback browser-scroll(length, length, length, length, BrowserModifiers);
    // A key's text, whether it went down, and whether it repeats.
    callback browser-key(string, bool, bool, BrowserModifiers);
    callback browser-focus(bool);
    // Text pasted into the page.
    callback browser-paste(string);
    callback set-browser-volume(float);
    callback toggle-browser-mute();
}
