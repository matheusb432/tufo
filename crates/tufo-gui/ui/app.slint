// The window: the backdrop, the sidebar, the page with the player docked under it, and the
// overlays, with keyboard search.

import { GuidedTours, Tour, TourId, TourStep, TourLayout, TourRect, TourScroll, TourVisibility } from "tours/state.slint";
import { TourOverlay } from "tours/overlay.slint";
import { HomeTour } from "tours/home.slint";
import { SettingsTour } from "tours/settings.slint";
import { Motion, Theme } from "theme.slint";
import {
    Actions, Art, BackgroundGroup, BackgroundLabel, BackgroundPresetTile, BackgroundTarget,
    Backgrounds, BrowserButton, BrowserModifiers, BrowserPointer, BrowserPointerKind, BrowserState,
    BrowserTabView, BrowserView, Clock, CollectionBackground, CollectionKind, CurrentOutput, FormSwitch,
    KenkuConflictRow, KenkuImportView, LibraryView, LoopBadge, LoopEditorView, LoopFieldTexts,
    LoopMarker, LoopPreview, NavItem, Navigation, Page, PlayerView, Search, Session,
    SongLoopImportRow, SongLoopImportRowState, SongLoopImportView, SoundIcons, SoundTile, VoiceBadge,
    WindowFrame,
} from "state.slint";
import { Sidebar } from "sidebar.slint";
import { ConnectingPage, GridPage, HomePage, PlaylistPage, SongsPage, SoundboardPage } from "pages.slint";
import { BrowserPage } from "browser.slint";
import { Dock, MiniPlayer } from "dock.slint";
import {
    AddCollectionDialog, AddToPlaylistDialog, EditCollectionDialog, EditEntryDialog, SettingsDialog,
} from "dialogs.slint";
import { BackgroundGallery } from "gallery.slint";
import { SearchPalette } from "search.slint";
import { WindowButtons, WindowDragArea } from "frame.slint";
import { OutputChip } from "output.slint";
import { Icon, Presence, Scrim } from "widgets.slint";
import { KenkuImportDialog } from "kenku-import.slint";
import { LoopEditorDialog } from "loop-editor.slint";
import { SongLoopImportDialog } from "song-loop-import.slint";

export {
    Actions, Art, BackgroundGroup, BackgroundLabel, BackgroundPresetTile, BackgroundTarget,
    Backgrounds, BrowserButton, BrowserModifiers, BrowserPointer, BrowserPointerKind, BrowserState,
    BrowserTabView, BrowserView, Clock, CollectionBackground, CollectionKind, CurrentOutput, KenkuConflictRow,
    KenkuImportView, LibraryView, LoopBadge, LoopEditorView, LoopFieldTexts, LoopMarker,
    LoopPreview, NavItem, Navigation, Page, PlayerView, Search, Session, SongLoopImportRow,
    SongLoopImportRowState, SongLoopImportView, SoundIcons, SoundTile, Theme, VoiceBadge,
    WindowFrame, GuidedTours, TourId, TourLayout, TourRect, TourScroll, Tour, TourStep,
    TourVisibility, HomeTour, SettingsTour,
}

enum DialogKind {
    none, add-collection, edit-collection, edit-entry, add-to-playlist, settings, kenku-import, loop-editor,
    song-loop-import,
}

export component AppWindow inherits Window {
    title: @tr("Tufo");
    icon: @image-url("../icons/tufo.svg");
    // Fits a 1280 × 800 screen at 125% scaling.
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: Session.mini-player ? Theme.mini-player-width-min : Theme.window-width-min;
    min-height: Session.mini-player ? Theme.mini-player-height-min : Theme.window-height-min;
    max-width: Session.mini-player ? Theme.mini-player-width-max : Theme.window-size-unbounded;
    max-height: Session.mini-player ? Theme.mini-player-height-min : Theme.window-size-unbounded;
    always-on-top: Session.mini-player && Session.mini-player-pinned && Session.always-on-top-supported;
    background: WindowFrame.corners-rounded ? transparent : Theme.wood;
    default-font-family: Theme.font;
    no-frame: true;
    resize-border-width: root.fills-screen ? 0 : 6px;
    // Keyboard shortcuts see every key first, wherever focus is inside the window.
    forward-focus: shortcuts;
    property <DialogKind> dialog: DialogKind.none;
    changed dialog => {
        GuidedTours.close();
        shortcuts.focus();
        if root.dialog != DialogKind.kenku-import { KenkuImportView.open = false; }
        if root.dialog != DialogKind.loop-editor && LoopEditorView.open {
            LoopEditorView.open = false;
            Actions.close-loop-editor();
        }
        if root.dialog != DialogKind.song-loop-import && SongLoopImportView.open {
            SongLoopImportView.open = false;
            Actions.close-song-loop-import();
        }
    }
    property <bool> kenku-import-open: KenkuImportView.open;
    changed kenku-import-open => {
        if root.kenku-import-open {
            root.dialog = DialogKind.kenku-import;
        }
    }
    property <bool> loop-editor-open: LoopEditorView.open;
    changed loop-editor-open => {
        if root.loop-editor-open {
            root.dialog = DialogKind.loop-editor;
        } else if root.dialog == DialogKind.loop-editor {
            root.close-dialog();
        }
    }
    property <bool> song-loop-import-open: SongLoopImportView.open;
    changed song-loop-import-open => {
        if root.song-loop-import-open {
            root.dialog = DialogKind.song-loop-import;
        } else if root.dialog == DialogKind.song-loop-import {
            root.close-dialog();
        }
    }
    property <CollectionKind> add-kind;
    property <string> entry-id;
    property <string> entry-title;
    property <bool> entry-is-sound;
    property <int> entry-fade-in-ms;
    property <int> entry-fade-out-ms;
    property <int> entry-icon;
    // The song Add to playlist adds.
    property <string> song-id;
    property <string> song-title;
    property <bool> any-dialog: root.dialog != DialogKind.none;
    property <bool> any-overlay: root.any-dialog || Search.palette-open || root.sidebar-overlaid || GuidedTours.active;
    property <bool> guide-active: GuidedTours.active;
    changed guide-active => {
        if !root.guide-active {
            shortcuts.focus();
            GuidedTours.restore-revision += 1;
        }
    }
    property <Page> guide-page: Navigation.page;
    changed guide-page => { GuidedTours.close(); }
    property <bool> guide-palette: Search.palette-open;
    changed guide-palette => { GuidedTours.close(); }
    property <FormSwitch> guide-form-switch: WindowFrame.form-switch;
    changed guide-form-switch => { GuidedTours.close(); }
    property <bool> fills-screen: root.maximized || root.full-screen;
    property <bool> sidebar-fits: root.width >= Theme.sidebar-width + Theme.page-width-min;
    property <bool> sidebar-expanded: Session.drawer-pinned && root.sidebar-fits;
    // Where the sidebar doesn't fit beside the page, expanding it lays it over the page until
    // a page opens.
    property <bool> sidebar-overlaid;
    changed sidebar-fits => {
        root.sidebar-overlaid = false;
    }
    property <length> page-x: root.sidebar-expanded ? Theme.sidebar-width : Theme.rail-width;
    animate page-x {
        duration: Motion.sidebar-slide;
        easing: Motion.sidebar-slide-easing;
    }
    property <bool> sidebar-moving: root.page-x != (root.sidebar-expanded ? Theme.sidebar-width : Theme.rail-width);
    changed sidebar-moving => {
        Art.layout-moving(root.sidebar-moving);
    }
    // The background gallery, over the Add or Edit dialog that opened it.
    property <bool> gallery-open;
    changed gallery-open => {
        GuidedTours.close();
        if !root.gallery-open { shortcuts.focus(); }
    }
    property <string> gallery-title;
    property <bool> mini-player: Session.mini-player;
    full-form := Presence {
        open: !root.mini-player && WindowFrame.form-switch == FormSwitch.none;
    }

    mini-form := Presence {
        open: root.mini-player && WindowFrame.form-switch == FormSwitch.none;
    }

    changed mini-player => {
        GuidedTours.close();
        if self.mini-player {
            root.sidebar-overlaid = false;
            root.gallery-open = false;
            root.dialog = DialogKind.none;
            Search.palette-open = false;
            shortcuts.focus();
        }
    }
    changed width => {
        root.report-size();
    }
    changed height => {
        root.report-size();
    }

    // The picker that takes an image dropped on the window, if a dialog shows one.
    public pure function background-drop-target() -> BackgroundTarget {
        if root.dialog == DialogKind.add-collection {
            return BackgroundTarget.new-collection;
        }
        if root.dialog == DialogKind.edit-collection {
            return BackgroundTarget.open-collection;
        }
        BackgroundTarget.none
    }

    function report-size() {
        if !root.fills-screen {
            WindowFrame.resized(root.width, root.height);
        }
    }

    function open-add(kind: CollectionKind) {
        root.add-kind = kind;
        root.dialog = DialogKind.add-collection;
    }

    function open-add-to-playlist(song-id: string, song-title: string) {
        root.song-id = song-id;
        root.song-title = song-title;
        root.dialog = DialogKind.add-to-playlist;
    }

    public function open-settings() {
        root.sidebar-overlaid = false;
        root.dialog = DialogKind.settings;
    }

    public function close-dialog() {
        KenkuImportView.open = false;
        if root.dialog == DialogKind.add-to-playlist {
            Actions.adding-song-changed("");
        }
        root.dialog = DialogKind.none;
        root.gallery-open = false;
        shortcuts.focus();
    }

    function toggle-sidebar() {
        if root.sidebar-fits {
            Session.drawer-pinned = !Session.drawer-pinned;
            Actions.set-drawer-pinned(Session.drawer-pinned);
        } else {
            root.sidebar-overlaid = !root.sidebar-overlaid;
        }
    }

    function open-palette() {
        Search.palette-open = true;
        Search.selected = 0;
        Actions.palette-query-changed(Search.palette-query);
    }

    function open-gallery(title: string) {
        root.gallery-title = title;
        root.gallery-open = true;
    }

    function close-overlays() -> bool {
        if root.sidebar-overlaid {
            root.sidebar-overlaid = false;
            return true;
        }
        if root.gallery-open {
            root.gallery-open = false;
            return true;
        }
        if Search.palette-open {
            Search.palette-open = false;
            shortcuts.focus();
            return true;
        }
        if root.any-dialog {
            root.close-dialog();
            return true;
        }
        if Search.filter-open {
            Search.filter-open = false;
            Search.filter-text = "";
            Actions.filter-changed("");
            shortcuts.focus();
            return true;
        }
        false
    }

    // Switches the window's form once the form on show has faded out.
    Timer {
        interval: Motion.presence-exit;
        running: WindowFrame.form-switch != FormSwitch.none;
        triggered => {
            WindowFrame.set-mini-player(WindowFrame.form-switch == FormSwitch.to-mini-player);
            WindowFrame.form-switch = FormSwitch.none;
        }
    }

    // The accents' clock, at 30 frames a second.
    Timer {
        interval: 33ms;
        running: Clock.enabled && PlayerView.something-plays;
        triggered => {
            Clock.seconds += 0.033;
        }
    }

    // The tray's rim of dark wood, under everything; pages lie on felt set into it.
    Rectangle {
        border-radius: WindowFrame.corner-radius;
        background: Theme.wood;
    }

    shortcuts := FocusScope {
        capture-key-pressed(event) => {
            if GuidedTours.active {
                return event.modifiers.control || event.modifiers.alt || event.modifiers.meta ? accept : reject;
            }
            if event.modifiers.control && !event.modifiers.alt && (event.text == "f" || event.text == "F") {
                if event.modifiers.shift {
                    root.open-palette();
                } else if !root.any-dialog && !Search.palette-open {
                    Search.filter-open = !Search.filter-open;
                    if !Search.filter-open {
                        Search.filter-text = "";
                        Actions.filter-changed("");
                        shortcuts.focus();
                    }
                }
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "b" || event.text == "B") {
                if !root.any-dialog && !Search.palette-open {
                    root.toggle-sidebar();
                }
                return accept;
            }
            if event.modifiers.control && event.modifiers.shift && !event.modifiers.alt && (event.text == "m" || event.text == "M") {
                WindowFrame.switch-form();
                return accept;
            }
            if event.text == Key.Escape {
                return root.close-overlays() ? accept : reject;
            }
            reject
        }
        if full-form.present && !root.mini-player: Rectangle {
            opacity: full-form.progress;
            tray := VerticalLayout {
                upper := Rectangle {
                    vertical-stretch: 1;
                    // The rim's edge around the felt: lit where it drops to the felt below, shaded where it
                    // rises above.
                    Rectangle {
                        x: felt.x;
                        y: felt.y + 1px;
                        width: felt.width;
                        height: felt.height;
                        border-radius: Theme.radius-felt;
                        background: Theme.felt-lip;
                    }

                    Rectangle {
                        x: felt.x;
                        y: felt.y - 1px;
                        width: felt.width;
                        height: felt.height;
                        border-radius: Theme.radius-felt;
                        background: Theme.felt-rim-shade;
                    }

                    felt := Rectangle {
                        x: root.page-x;
                        y: Theme.felt-margin;
                        width: parent.width - self.x - Theme.felt-margin;
                        height: parent.height - self.y;
                        felt-backdrop := Image {
                            width: parent.width;
                            height: parent.height;
                            preferred-width: 0px;
                            preferred-height: 0px;
                            source: Art.backdrop(self.width, self.height, Theme.radius-felt, Theme.felt-recess-depth, Theme.still-light, Theme.still-canopy, Theme.still-shade, Art.backdrop-revision);
                            image-fit: fill;
                        }

                        // The software renderer can't round a gradient, so the felt waits on its plain shade.
                        if felt-backdrop.source.width == 0: Rectangle {
                            border-radius: Theme.radius-felt;
                            background: Theme.still-shade;
                        }

                        main := Rectangle {
                            WindowDragArea {
                                y: 0;
                                height: Theme.title-row-height;
                            }

                            page-area := Rectangle {
                                // Small enough that a collection's page trades its plate for a slim header.
                                property <bool> compact: self.width < 680px || self.height < 520px;
                                clip: true;
                                if !LibraryView.loaded: ConnectingPage { }
                                if LibraryView.loaded && Navigation.page == Page.home: HomePage {
                                    add(kind) => {
                                        root.open-add(kind);
                                    }
                                }
                                if LibraryView.loaded && Navigation.page == Page.songs: SongsPage {
                                    add-to-playlist(id, title) => {
                                        root.open-add-to-playlist(id, title);
                                    }
                                }
                                if LibraryView.loaded && Navigation.page == Page.playlists: GridPage {
                                    kind: CollectionKind.playlist;
                                    add(kind) => {
                                        root.open-add(kind);
                                    }
                                }
                                if LibraryView.loaded && Navigation.page == Page.soundboards: GridPage {
                                    kind: CollectionKind.soundboard;
                                    add(kind) => {
                                        root.open-add(kind);
                                    }
                                }
                                if LibraryView.loaded && Navigation.page == Page.playlist: PlaylistPage {
                                    compact: page-area.compact;
                                    edit-collection => {
                                        root.dialog = DialogKind.edit-collection;
                                    }
                                    edit-entry(id, title) => {
                                        root.entry-id = id;
                                        root.entry-title = title;
                                        root.entry-is-sound = false;
                                        root.dialog = DialogKind.edit-entry;
                                    }
                                    add-files => {
                                        Actions.add-files(Navigation.collection-id);
                                    }
                                    add-to-playlist(id, title) => {
                                        root.open-add-to-playlist(id, title);
                                    }
                                }
                                if LibraryView.loaded && Navigation.page == Page.browser: BrowserPage { }
                                if LibraryView.loaded && Navigation.page == Page.soundboard: SoundboardPage {
                                    compact: page-area.compact;
                                    edit-collection => {
                                        root.dialog = DialogKind.edit-collection;
                                    }
                                    edit-sound(tile) => {
                                        root.entry-id = tile.id;
                                        root.entry-title = tile.title;
                                        root.entry-is-sound = true;
                                        root.entry-fade-in-ms = tile.fade-in-ms;
                                        root.entry-fade-out-ms = tile.fade-out-ms;
                                        root.entry-icon = tile.icon;
                                        root.dialog = DialogKind.edit-entry;
                                    }
                                    add-files => {
                                        Actions.add-files(Navigation.collection-id);
                                    }
                                }
                            }

                            if Session.toast != "": Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 16px;
                                width: min(toast-text.preferred-width + 36px, parent.width - 32px);
                                height: toast-text.preferred-height + 24px;
                                border-radius: Theme.radius-row;
                                background: Session.toast-is-error ? #5a2a2a : Theme.raised;
                                border-width: 1px;
                                border-color: Session.toast-is-error ? Theme.error.with-alpha(0.4) : Theme.raised-edge;
                                // Swallows clicks, so they don't reach the page under the toast.
                                TouchArea { }
                                toast-text := Text {
                                    text: Session.toast;
                                    width: parent.width - 36px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    color: Theme.text;
                                    font-size: Theme.body-small;
                                    font-weight: 500;
                                }
                            }
                            if Session.drop-hover: Rectangle {
                                background: Theme.scrim;
                                border-radius: Theme.radius-felt;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Icon {
                                        width: 64px;
                                        height: 64px;
                                        source: @image-url("icons/folder.svg");
                                        tint: Theme.lit;
                                    }

                                    Text {
                                        text: Session.drop-label;
                                        font-size: Theme.heading;
                                        font-weight: 800;
                                        color: Theme.text;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // The player, on the rim's ledge under the sidebar and the felt.
                if LibraryView.loaded: Dock {
                    wide: root.width >= Theme.sidebar-width + 680px;
                    collapsed: Session.player-collapsed;
                    set-collapsed(collapsed) => {
                        Session.player-collapsed = collapsed;
                        Actions.set-player-collapsed(collapsed);
                    }
                }
            }

            Scrim {
                x: Theme.rail-width;
                width: parent.width - self.x;
                border-top-left-radius: 0;
                border-bottom-left-radius: 0;
                progress: root.sidebar-overlaid ? 1 : 0;
                animate progress { duration: Motion.sidebar-slide; }
                clicked => {
                    root.sidebar-overlaid = false;
                }
            }

            Sidebar {
                x: 0;
                y: 0;
                height: upper.height;
                expanded: root.sidebar-expanded || root.sidebar-overlaid;
                overlaid: root.sidebar-overlaid;
                page-opened => {
                    root.sidebar-overlaid = false;
                }
                toggle => {
                    root.toggle-sidebar();
                }
                open-search => {
                    root.sidebar-overlaid = false;
                    root.open-palette();
                }
                open-settings => {
                    root.open-settings();
                }
                add(kind) => {
                    root.sidebar-overlaid = false;
                    root.open-add(kind);
                }
            }

            SearchPalette {
                close => {
                    Search.palette-open = false;
                    shortcuts.focus();
                }
            }
            add-dialog := Presence {
                open: root.dialog == DialogKind.add-collection;
            }

            if add-dialog.present: AddCollectionDialog {
                progress: add-dialog.progress;
                kind: root.add-kind;
                change-background(title) => {
                    root.open-gallery(title);
                }
                cancel => {
                    root.close-dialog();
                }
            }
            edit-collection-dialog := Presence {
                open: root.dialog == DialogKind.edit-collection;
            }

            if edit-collection-dialog.present: EditCollectionDialog {
                progress: edit-collection-dialog.progress;
                change-background(title) => {
                    root.open-gallery(title);
                }
                cancel => {
                    root.close-dialog();
                }
            }
            new-collection-gallery := Presence {
                open: root.gallery-open && root.dialog == DialogKind.add-collection;
            }

            if new-collection-gallery.present: BackgroundGallery {
                progress: new-collection-gallery.progress;
                target: BackgroundTarget.new-collection;
                heading: root.gallery-title != "" ? @tr("Background for {0}", root.gallery-title) : root.add-kind == CollectionKind.playlist ? @tr("Background for the new playlist") : @tr("Background for the new soundboard");
                selected: Backgrounds.draft;
                selected-label: Backgrounds.draft-label;
                close => {
                    root.gallery-open = false;
                }
            }
            open-collection-gallery := Presence {
                open: root.gallery-open && root.dialog == DialogKind.edit-collection;
            }

            if open-collection-gallery.present: BackgroundGallery {
                progress: open-collection-gallery.progress;
                target: BackgroundTarget.open-collection;
                collection-id: Navigation.collection-id;
                heading: @tr("Background for {0}", root.gallery-title != "" ? root.gallery-title : LibraryView.collection-title);
                selected: LibraryView.collection-background;
                selected-label: LibraryView.collection-background-label;
                image-missing: Art.picture-missing(LibraryView.collection-background, Art.pictures-revision);
                close => {
                    root.gallery-open = false;
                }
            }
            edit-entry-dialog := Presence {
                open: root.dialog == DialogKind.edit-entry;
            }

            if edit-entry-dialog.present: EditEntryDialog {
                progress: edit-entry-dialog.progress;
                entry-id: root.entry-id;
                entry-title: root.entry-title;
                sound: root.entry-is-sound;
                fade-in-ms: root.entry-fade-in-ms;
                fade-out-ms: root.entry-fade-out-ms;
                icon: root.entry-icon;
                cancel => {
                    root.close-dialog();
                }
            }
            add-to-playlist-dialog := Presence {
                open: root.dialog == DialogKind.add-to-playlist;
            }

            if add-to-playlist-dialog.present: AddToPlaylistDialog {
                progress: add-to-playlist-dialog.progress;
                song-id: root.song-id;
                song-title: root.song-title;
                cancel => {
                    root.close-dialog();
                }
            }
            settings-dialog := Presence {
                open: root.dialog == DialogKind.settings;
            }

            if settings-dialog.present: SettingsDialog {
                progress: settings-dialog.progress;
                cancel => {
                    root.close-dialog();
                }
            }
            kenku-dialog := Presence {
                open: root.dialog == DialogKind.kenku-import;
            }

            if kenku-dialog.present: KenkuImportDialog {
                progress: kenku-dialog.progress;
                cancel => { root.close-dialog(); }
            }
            loop-editor-dialog := Presence {
                open: root.dialog == DialogKind.loop-editor;
            }

            if loop-editor-dialog.present: LoopEditorDialog {
                progress: loop-editor-dialog.progress;
                cancel => { root.close-dialog(); }
            }
            song-loop-import-dialog := Presence {
                open: root.dialog == DialogKind.song-loop-import;
            }

            if song-loop-import-dialog.present: SongLoopImportDialog {
                progress: song-loop-import-dialog.progress;
                cancel => { root.close-dialog(); }
            }
        }
        if mini-form.present && root.mini-player: MiniPlayer {
            opacity: mini-form.progress;
            close => {
                root.close();
            }
        }
        TourOverlay {
            y: root.mini-player ? 0px : Theme.title-row-height;
            height: parent.height - self.y;
        }
    }

    // The title row still moves the window while an overlay dims the page.
    if root.any-overlay && !root.mini-player: WindowDragArea {
        x: root.sidebar-overlaid ? Theme.sidebar-width : 0;
        y: 0;
        width: parent.width - self.x;
        height: Theme.title-row-height;
    }

    // Where the audio goes, and the window's buttons, over the felt's top right corner.
    if full-form.present && !root.mini-player: HorizontalLayout {
        opacity: full-form.progress;
        x: parent.width - self.width - Theme.felt-margin - 8px;
        y: Theme.felt-margin + (Theme.title-row-height - self.height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 8px;
        init => {
            WindowFrame.title-controls-width = self.preferred-width;
        }
        changed preferred-width => {
            WindowFrame.title-controls-width = self.preferred-width;
        }
        if LibraryView.loaded: OutputChip {
            y: (parent.height - self.height) / 2;
            open-settings => {
                root.open-settings();
            }
        }
        WindowButtons {
            y: (parent.height - self.height) / 2;
            maximized: root.maximized;
            close => {
                root.close();
            }
        }
    }

    if !root.fills-screen: Rectangle {
        border-width: 1px;
        border-color: Theme.window-edge;
        border-radius: WindowFrame.corner-radius;
    }

    // Swallows clicks while the form on show fades out.
    if WindowFrame.form-switch != FormSwitch.none: TouchArea { }
}
