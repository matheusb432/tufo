// The window's own frame, drawn in place of the desktop's: the areas that move the window, and
// its buttons.

import { Theme } from "theme.slint";
import { WindowFrame } from "state.slint";
import { IconButton } from "widgets.slint";

// Moves the window when dragged, maximizes or restores it on a double click, and opens the
// desktop's window menu on a right click. Whatever lies above it keeps its own presses.
export component WindowDragArea inherits WindowMoveArea {
    in property <bool> maximizes: true;
    TouchArea {
        double-clicked => {
            if root.maximizes {
                WindowFrame.toggle-maximized();
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                WindowFrame.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// One button of the window's capsule.
component WindowButton inherits IconButton {
    width: Theme.window-button-width;
    height: Theme.window-button-height;
    border-radius: self.height / 2;
    icon-size: Theme.window-button-icon-size;
}

// Minimize, maximize, and close, sharing one quiet capsule.
export component WindowButtons inherits Rectangle {
    in property <bool> maximized;
    callback close();
    width: Theme.window-buttons-width;
    height: Theme.window-buttons-height;
    border-radius: self.height / 2;
    background: Theme.window-controls;
    HorizontalLayout {
        padding: Theme.window-buttons-padding;
        WindowButton {
            icon: @image-url("icons/minus.svg");
            tooltip: @tr("Minimize");
            clicked => {
                WindowFrame.minimize();
            }
        }

        WindowButton {
            icon: root.maximized ? @image-url("icons/copy.svg") : @image-url("icons/square.svg");
            tooltip: root.maximized ? @tr("Restore") : @tr("Maximize");
            clicked => {
                WindowFrame.toggle-maximized();
            }
        }

        WindowButton {
            icon: @image-url("icons/x.svg");
            tooltip: @tr("Close");
            background: self.has-hover ? Theme.window-close-hover : transparent;
            hover-tint: Theme.window-close-hover-icon;
            clicked => {
                root.close();
            }
        }
    }
}
