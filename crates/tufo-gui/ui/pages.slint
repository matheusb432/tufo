// Home, the playlist and soundboard grids, one playlist or soundboard, and the wait for the server.

import { HomeTour } from "tours/home.slint";
import { SongsTour } from "tours/songs.slint";
import { ShelfTour } from "tours/shelves.slint";
import { CollectionTour } from "tours/collection.slint";
import { GuidedTours, TourId, TourScroll } from "tours/state.slint";
import { TourButton } from "tours/button.slint";
import { TourTarget, TourScrollArea } from "tours/target.slint";
import { Motion, Theme } from "theme.slint";
import {
    Actions, Art, CollectionCard, CollectionKind, LibraryView, LoopBadge, Navigation, OrderKey, Page,
    PlayerView, Search, Session, SongFolder, SongRow, SoundIcons, SoundTile, TrackRow,
} from "state.slint";
import {
    Button, ButtonKind, Equalizer, Icon, IconButton, MenuItem as MenuAction, MenuSurface, ScrollThumb, Slider,
    TextLink,
} from "widgets.slint";

struct OrderChoice {
    label: string,
    key: OrderKey,
    descending: bool,
}

export global PageMetrics {
    out property <length> gap: 18px;
    out property <length> padding: 26px;
    // Between the bar and the first content of Home and the grids.
    out property <length> padding-top: 8px;
    // A card's painting is 4 wide to 3.3 high.
    out property <float> card-aspect: 3.3 / 4;
    // A collection page's painting, at least as tall as the title and tools beside it.
    out property <length> plate-width: 250px;
    out property <length> plate-height: 176px;
}

component CardView inherits Rectangle {
    in property <CollectionCard> card;
    in property <CollectionKind> kind;
    border-radius: Theme.radius-card;
    border-width: root.card.playing ? 2px : 0px;
    border-color: Theme.lit;
    accessible-role: button;
    accessible-label: root.card.title;
    accessible-description: root.card.count-label;
    accessible-action-default => {
        Actions.open-page(root.kind == CollectionKind.playlist ? Page.playlist : Page.soundboard, root.card.id);
    }
    Image {
        width: parent.width;
        height: parent.height;
        source: Art.card-background(root.card.id, root.card.background, self.width, self.height, Theme.radius-card, Art.pictures-revision);
        image-fit: fill;
    }

    Rectangle {
        border-radius: Theme.radius-card;
        background: white;
        opacity: touch.has-hover ? 0.05 : 0;
        animate opacity { duration: Motion.hover; }
    }

    property <Point> menu-position;
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Actions.open-page(root.kind == CollectionKind.playlist ? Page.playlist : Page.soundboard, root.card.id);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.menu-position = { x: self.mouse-x, y: self.mouse-y };
                card-menu.show();
            }
        }
    }

    card-menu := PopupWindow {
        x: root.menu-position.x;
        y: root.menu-position.y;
        close-policy: close-on-click-outside;
        MenuSurface {
            MenuAction {
                text: root.card.pinned ? @tr("Unpin from the sidebar") : @tr("Pin to the sidebar");
                activated => {
                    Actions.set-collection-pinned(root.card.id, !root.card.pinned);
                    card-menu.close();
                }
            }
        }
    }

    VerticalLayout {
        x: 14px;
        width: parent.width - 28px;
        padding-bottom: 12px;
        alignment: end;
        spacing: 2px;
        Text {
            text: root.card.title;
            font-size: Theme.card-title;
            font-weight: 800;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            max-height: 44px;
        }

        Text {
            text: root.card.missing ? @tr("Folder missing") : root.card.count-label;
            font-size: Theme.caption;
            color: root.card.missing ? Theme.error : Theme.text-secondary;
            overflow: elide;
        }
    }

    if root.card.playing: Rectangle {
        x: 12px;
        y: 12px;
        width: 27px;
        height: 24px;
        border-radius: 12px;
        background: Theme.badge;
        Equalizer { }
    }
    if root.kind == CollectionKind.playlist && (touch.has-hover || root.card.playing): Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 38px;
        height: 38px;
        border-radius: 19px;
        background: root.card.playing ? (play-touch.has-hover ? Theme.lit-bright : Theme.lit) : play-touch.has-hover ? Theme.badge-hover : Theme.badge;
        accessible-role: button;
        accessible-label: root.card.playing ? @tr("Pause") : @tr("Play");
        Icon {
            width: 18px;
            height: 18px;
            source: root.card.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            tint: root.card.playing ? Theme.on-lit : Theme.text;
        }

        play-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                Actions.play-collection(root.card.id);
            }
        }
    }
}

// Cards in 2, 3, or 4 columns by width.
component CardGrid inherits Rectangle {
    in property <[CollectionCard]> cards;
    in property <CollectionKind> kind;
    in property <TourScroll> tour-scroll;
    TourTarget {
        anchor: ShelfTour.grid;
        scroll: root.tour-scroll;
        available: GuidedTours.tour == (root.kind == CollectionKind.playlist ? TourId.playlists : TourId.soundboards);
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    // Shows at most this many rows; -1 shows every card.
    in property <int> rows-max: -1;
    property <int> columns: root.width < 500px ? 2 : root.width < 680px ? 3 : 4;
    property <int> count: root.rows-max < 0 ? root.cards.length : min(root.rows-max * root.columns, root.cards.length);
    property <length> card-width: (root.width - (root.columns - 1) * PageMetrics.gap) / root.columns;
    property <length> card-height: root.card-width * PageMetrics.card-aspect;
    property <int> rows: Math.ceil(root.count / root.columns);
    height: root.rows == 0 ? 0 : root.rows * root.card-height + (root.rows - 1) * PageMetrics.gap;
    for card[index] in root.cards: CardView {
        visible: index < root.count;
        x: Math.mod(index, root.columns) * (root.card-width + PageMetrics.gap);
        y: Math.floor(index / root.columns) * (root.card-height + PageMetrics.gap);
        width: root.card-width;
        height: root.card-height;
        card: card;
        kind: root.kind;
    }
}

// The filter Ctrl+F opens on a page: a search pill that takes focus as it opens. It carries
// the gap under it, because a layout's spacing would keep a gap while it's closed.
component FilterField inherits Rectangle {
    in property <length> space-below;
    property <bool> open: Search.filter-open;
    changed open => {
        if self.open {
            input.focus();
        }
    }
    height: root.open ? 42px + root.space-below : 0px;
    visible: root.open;
    Rectangle {
        width: min(parent.width, 460px);
        height: 42px;
        x: 0;
        y: 0;
        border-radius: self.height / 2;
        background: Theme.raised;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.divider;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                source: @image-url("icons/search.svg");
                tint: Theme.text-faint;
            }

            input := TextInput {
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: Theme.body;
                color: Theme.text;
                single-line: true;
                text: Search.filter-text;
                edited => {
                    Search.filter-text = self.text;
                    Actions.filter-changed(self.text);
                }
                if self.text == "": Text {
                    x: 0;
                    width: parent.width;
                    overflow: elide;
                    text: @tr("Filter this page");
                    color: Theme.text-faint;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }
}

// Scrolls a page's content, with a thumb that shows while the pointer is over it.
component PageScroll inherits Rectangle {
    in property <length> content-height;
    in property <TourScroll> tour-scroll;
    out property <bool> scrolled: flick.content-y < 0;
    out property <length> scroll-top: -flick.content-y;
    public function scroll-by(distance: length) {
        flick.content-y = clamp(flick.content-y - distance, min(0px, flick.height - flick.content-height), 0px);
    }
    hover := TouchArea {
        flick := TourScrollArea {
            tour-scroll: root.tour-scroll;
            mouse-drag-pan-enabled: false;
            content-height: max(root.content-height, root.height);
            @children
        }

        ScrollThumb {
            x: parent.width - self.width - 2px;
            height: parent.height;
            content-height: flick.content-height;
            content-y <=> flick.content-y;
            show: hover.has-hover;
        }
    }
}

// Pointers are in window coordinates, so the page can scroll under a lifted entry.
component EntryDrag {
    in property <length> scroll-top;
    in property <length> viewport-y;
    in property <length> viewport-height;
    callback scroll-by(length);
    out property <string> entry-id;
    // The lifted entry's place before the drag, or -1.
    out property <int> from: -1;
    out property <length> offset-x: root.pointer.x - root.start.x;
    out property <length> offset-y: root.pointer.y - root.start.y + root.scroll-top - root.scroll-top-at-start;
    property <Point> start;
    property <Point> pointer;
    property <length> scroll-top-at-start;
    property <length> pointer-in-viewport: root.pointer.y - root.viewport-y;
    // How deep the pointer rests in the band at either end; negative at the top.
    property <length> edge-depth: root.pointer-in-viewport < Theme.arrange-scroll-edge
        ? max(root.pointer-in-viewport, 0px) - Theme.arrange-scroll-edge
        : root.pointer-in-viewport > root.viewport-height - Theme.arrange-scroll-edge
            ? min(root.pointer-in-viewport, root.viewport-height) - (root.viewport-height - Theme.arrange-scroll-edge)
            : 0px;

    public function begin(id: string, index: int, start: Point) {
        root.entry-id = id;
        root.from = index;
        root.start = start;
        root.pointer = start;
        root.scroll-top-at-start = root.scroll-top;
    }

    public function move(pointer: Point) {
        root.pointer = pointer;
    }

    public function end() {
        root.from = -1;
        root.entry-id = "";
    }

    Timer {
        interval: 16ms;
        running: root.from >= 0 && root.edge-depth != 0px;
        triggered => {
            root.scroll-by(root.edge-depth / Theme.arrange-scroll-edge * 14px);
        }
    }
}

// Falls from the page's bar once content scrolls under it.
component BarShadow inherits Rectangle {
    in property <bool> shown;
    y: Theme.title-row-height;
    height: Theme.bar-shadow-height;
    background: Theme.bar-shadow;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Motion.hover; }
}

export component Heading inherits Text {
    font-family: Theme.display-font;
    font-size: Theme.heading;
    font-weight: Theme.display-weight;
    color: Theme.text;
    vertical-alignment: center;
}

component EmptyShelf inherits VerticalLayout {
    in property <CollectionKind> kind;
    callback add();
    spacing: 12px;
    alignment: start;
    Text {
        text: root.kind == CollectionKind.playlist ? @tr("Drop folders of music on Playlists, or add a playlist.") : @tr("Drop folders of sounds on Soundboards, or add a soundboard.");
        color: Theme.text-secondary;
        font-size: Theme.body;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 10px;
        Button {
            text: root.kind == CollectionKind.playlist ? @tr("Add a playlist") : @tr("Add a soundboard");
            icon: @image-url("icons/folder-plus.svg");
            kind: ButtonKind.primary;
            enabled: Session.connected;
            clicked => {
                root.add();
            }
        }

        if root.kind == CollectionKind.playlist: Button {
            text: @tr("Import my Kenku FM library");
            kind: ButtonKind.quiet;
            enabled: Session.connected;
            clicked => {
                Actions.import-kenku-library();
            }
        }
    }
}

component HomeShelf inherits VerticalLayout {
    in property <string> title;
    in property <[CollectionCard]> cards;
    in property <int> total;
    in property <CollectionKind> kind;
    callback add();
    callback see-all();
    TourTarget {
        anchor: root.kind == CollectionKind.playlist ? HomeTour.home-playlists : HomeTour.home-soundboards;
        scroll: TourScroll.home;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    spacing: 14px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Heading {
            text: root.title;
        }

        if root.total > 0: TextLink {
            text: @tr("See all {0}", root.total);
            vertical-alignment: center;
            clicked => {
                root.see-all();
            }
        }
    }

    if root.total == 0: EmptyShelf {
        kind: root.kind;
        add => {
            root.add();
        }
    }
    CardGrid {
        tour-scroll: TourScroll.home;
        cards: root.cards;
        kind: root.kind;
        rows-max: 1;
    }
}

export component HomePage inherits Rectangle {
    callback add(CollectionKind);
    HorizontalLayout {
        y: 0;
        height: Theme.title-row-height;
        padding-left: PageMetrics.padding;
        padding-right: 8px;
        spacing: 8px;
        Heading { text: @tr("Home"); }
        TourButton { y: (parent.height - self.height) / 2; guide: HomeTour.guide; label: @tr("Home"); }
        Rectangle { horizontal-stretch: 1; }
    }
    scroll := PageScroll {
        tour-scroll: TourScroll.home;
        y: Theme.title-row-height;
        height: parent.height - self.y;
        content-height: column.preferred-height;
        column := VerticalLayout {
            padding: PageMetrics.padding;
            padding-top: PageMetrics.padding-top;
            alignment: start;
            FilterField {
                space-below: 24px;
            }

            HomeShelf {
                title: @tr("Playlists");
                cards: LibraryView.playlists;
                total: LibraryView.playlist-count;
                kind: CollectionKind.playlist;
                add => {
                    root.add(CollectionKind.playlist);
                }
                see-all => {
                    Actions.open-page(Page.playlists, "");
                }
            }

            HomeShelf {
                padding-top: 24px;
                title: @tr("Soundboards");
                cards: LibraryView.soundboards;
                total: LibraryView.soundboard-count;
                kind: CollectionKind.soundboard;
                add => {
                    root.add(CollectionKind.soundboard);
                }
                see-all => {
                    Actions.open-page(Page.soundboards, "");
                }
            }
        }
    }

    BarShadow {
        shown: scroll.scrolled;
    }
}

component PageTitle inherits Text {
    font-family: Theme.display-font;
    font-size: Theme.title;
    font-weight: Theme.display-weight;
    color: Theme.text;
    overflow: elide;
}

export component GridPage inherits Rectangle {
    in property <CollectionKind> kind;
    callback add(CollectionKind);
    property <string> add-label: root.kind == CollectionKind.playlist ? @tr("Add Playlist") : @tr("Add Soundboard");
    HorizontalLayout {
        y: 0;
        height: Theme.title-row-height;
        padding-left: PageMetrics.padding;
        padding-right: 8px;
        spacing: 8px;
        Heading {
            text: root.kind == CollectionKind.playlist ? @tr("Playlists") : @tr("Soundboards");
            horizontal-stretch: 0;
            overflow: elide;
        }
        TourButton {
            y: (parent.height - self.height) / 2;
            guide: root.kind == CollectionKind.playlist ? ShelfTour.playlists : ShelfTour.soundboards;
            label: root.kind == CollectionKind.playlist ? @tr("Playlists") : @tr("Soundboards");
        }
        Rectangle { horizontal-stretch: 1; }

        if root.width >= 520px: Button {
            y: (parent.height - self.height) / 2;
            height: 32px;
            text: root.add-label;
            icon: @image-url("icons/plus.svg");
            enabled: Session.connected;
            clicked => {
                root.add(root.kind);
            }
        }
        if root.width < 520px: IconButton {
            y: (parent.height - self.height) / 2;
            size: Theme.bar-button-size;
            icon-size: Theme.bar-icon-size;
            icon: @image-url("icons/plus.svg");
            tooltip: root.add-label;
            enabled: Session.connected;
            clicked => {
                root.add(root.kind);
            }
        }
    }

    scroll := PageScroll {
        tour-scroll: TourScroll.grid;
        y: Theme.title-row-height;
        height: parent.height - self.y;
        content-height: column.preferred-height;
        column := VerticalLayout {
            padding: PageMetrics.padding;
            padding-top: PageMetrics.padding-top;
            alignment: start;
            FilterField {
                space-below: PageMetrics.gap;
            }

            if (root.kind == CollectionKind.playlist ? LibraryView.playlists.length : LibraryView.soundboards.length) == 0: Text {
                text: Search.filter-text != "" ? @tr("Nothing matches the filter.") : root.kind == CollectionKind.playlist ? @tr("Drop a folder of music here: each folder in it that holds audio becomes a playlist.") : @tr("Drop a folder of sounds here: each folder in it that holds audio becomes a soundboard.");
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            CardGrid {
                tour-scroll: TourScroll.grid;
                cards: root.kind == CollectionKind.playlist ? LibraryView.playlists : LibraryView.soundboards;
                kind: root.kind;
            }
        }
    }

    BarShadow {
        shown: scroll.scrolled;
    }
}

// Sorting and the ⋮ menu of a playlist or soundboard page.
component CollectionTools inherits HorizontalLayout {
    TourTarget {
        anchor: CollectionTour.collection-tools;
        scroll: root.compact ? TourScroll.none : TourScroll.collection;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    // Shows sorting as an icon, without the order's name.
    in property <bool> compact;
    callback edit();
    callback add-files();
    property <[OrderChoice]> order-choices: [
        { label: @tr("Name A→Z"), key: OrderKey.title, descending: false },
        { label: @tr("Name Z→A"), key: OrderKey.title, descending: true },
        { label: @tr("Shortest first"), key: OrderKey.duration, descending: false },
        { label: @tr("Longest first"), key: OrderKey.duration, descending: true },
        { label: @tr("Oldest first"), key: OrderKey.date-added, descending: false },
        { label: @tr("Newest first"), key: OrderKey.date-added, descending: true },
        { label: @tr("Custom order"), key: OrderKey.custom, descending: false },
    ];
    spacing: 2px;
    property <string> order-label: LibraryView.order-key == OrderKey.custom ? @tr("Custom order")
        : LibraryView.order-key == OrderKey.duration ? (LibraryView.order-descending ? @tr("Longest first") : @tr("Shortest first"))
        : LibraryView.order-key == OrderKey.date-added ? (LibraryView.order-descending ? @tr("Newest first") : @tr("Oldest first"))
        : LibraryView.order-descending ? @tr("Name Z→A") : @tr("Name A→Z");
    if !root.compact: Button {
        y: (parent.height - self.height) / 2;
        text: root.order-label;
        icon: @image-url("icons/arrow-down-up.svg");
        kind: ButtonKind.quiet;
        clicked => {
            sort-menu.show();
        }
    }
    if root.compact: IconButton {
        y: (parent.height - self.height) / 2;
        size: Theme.bar-button-size;
        icon-size: Theme.bar-icon-size;
        icon: @image-url("icons/arrow-down-up.svg");
        tooltip: @tr("Sort: {0}", root.order-label);
        clicked => {
            sort-menu.show();
        }
    }

    sort-menu := PopupWindow {
        x: root.compact ? more.x - 120px : 0;
        y: more.y + more.height + 4px;
        MenuSurface {
            for choice in root.order-choices: MenuAction {
                text: choice.label;
                activated => {
                    Actions.set-order(choice.key, choice.descending);
                    sort-menu.close();
                }
            }
        }
    }

    more := IconButton {
        y: (parent.height - self.height) / 2;
        size: root.compact ? Theme.bar-button-size : 40px;
        icon-size: root.compact ? Theme.bar-icon-size : 22px;
        icon: @image-url("icons/ellipsis-vertical.svg");
        tooltip: @tr("More");
        clicked => {
            menu.show();
        }
    }

    menu := PopupWindow {
        x: more.x - 120px;
        y: more.y + more.height + 4px;
        MenuSurface {
            MenuAction {
                text: @tr("Edit");
                activated => {
                    root.edit();
                    menu.close();
                }
            }

            MenuAction {
                text: LibraryView.collection-pinned ? @tr("Unpin from the sidebar") : @tr("Pin to the sidebar");
                activated => {
                    Actions.set-collection-pinned(Navigation.collection-id, !LibraryView.collection-pinned);
                    menu.close();
                }
            }

            if !LibraryView.collection-linked: MenuAction {
                text: @tr("Add files…");
                activated => {
                    root.add-files();
                    menu.close();
                }
            }
            MenuAction {
                text: @tr("Delete");
                destructive: true;
                activated => {
                    Actions.delete-collection(Navigation.collection-id);
                    menu.close();
                }
            }
        }
    }
}

// The collection's header as one slim row that stays put while its content
// scrolls: a way back to every playlist or soundboard, the title, and the actions, left of the
// window's buttons.
component CollectionBar inherits Rectangle {
    in property <CollectionKind> kind;
    callback edit();
    callback add-files();
    height: Theme.title-row-height;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        IconButton {
            y: (parent.height - self.height) / 2;
            size: Theme.bar-button-size;
            icon-size: Theme.bar-icon-size;
            icon: @image-url("icons/arrow-left.svg");
            tooltip: root.kind == CollectionKind.playlist ? @tr("Back to Playlists") : @tr("Back to Soundboards");
            clicked => {
                Actions.open-page(root.kind == CollectionKind.playlist ? Page.playlists : Page.soundboards, "");
            }
        }

        Text {
            text: LibraryView.collection-title;
            horizontal-stretch: 0;
            vertical-alignment: center;
            overflow: elide;
            font-family: Theme.display-font;
            font-size: Theme.heading;
            font-weight: Theme.display-weight;
            color: Theme.text;
        }
        TourButton {
            y: (parent.height - self.height) / 2;
            guide: root.kind == CollectionKind.playlist ? CollectionTour.playlist : CollectionTour.soundboard;
            label: LibraryView.collection-title;
        }
        Rectangle { horizontal-stretch: 1; }

        CollectionTools {
            compact: true;
            edit => {
                root.edit();
            }
            add-files => {
                root.add-files();
            }
        }
    }
}

// The collection's painting as a plate beside its title, size, folder, and actions.
component CollectionHero inherits HorizontalLayout {
    callback edit();
    callback add-files();
    spacing: 22px;
    alignment: start;
    VerticalLayout {
        spacing: 8px;
        alignment: end;
        Rectangle {
            width: PageMetrics.plate-width;
            height: PageMetrics.plate-height;
            border-radius: Theme.radius-plate;
            Image {
                width: parent.width;
                height: parent.height;
                source: Art.painting(Navigation.collection-id, LibraryView.collection-background, self.width, self.height, Theme.radius-plate, Art.pictures-revision);
                image-fit: fill;
            }
        }
    }

    VerticalLayout {
        alignment: end;
        spacing: 6px;
        horizontal-stretch: 1;
        PageTitle {
            text: LibraryView.collection-title;
        }

        Text {
            text: LibraryView.collection-summary;
            font-size: Theme.body-small;
            color: Theme.text-secondary;
        }

        if LibraryView.collection-linked: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: @image-url("icons/folder.svg");
                tint: LibraryView.collection-missing ? Theme.error : Theme.text-faint;
            }

            Text {
                text: LibraryView.collection-missing ? @tr("Can't find {0}", LibraryView.collection-folder) : @tr("Follows {0}", LibraryView.collection-folder);
                font-size: Theme.caption;
                color: LibraryView.collection-missing ? Theme.error : Theme.text-faint;
                overflow: elide;
            }
        }
        HorizontalLayout {
            padding-top: 10px;
            spacing: 8px;
            alignment: start;
            @children
            CollectionTools {
                edit => {
                    root.edit();
                }
                add-files => {
                    root.add-files();
                }
            }
        }
    }
}

// A row's right-click menu: a primary action, then optionally a second action, Add to playlist,
// Edit, Edit loop, and a red Remove. Slint's built-in menu items cannot color destructive
// actions.
component RowMenu inherits TouchArea {
    in property <string> primary-action-title;
    in property <bool> primary-action-enabled: true;
    in property <bool> secondary-action-shown;
    in property <string> secondary-action-title;
    in property <bool> secondary-action-enabled: true;
    in property <bool> add-to-playlist-shown;
    in property <bool> edit-shown: true;
    in property <bool> loop-shown;
    in property <bool> remove-shown;
    in property <string> remove-title: @tr("Remove");
    callback primary-action();
    callback secondary-action();
    callback add-to-playlist();
    callback edit();
    callback edit-loop();
    callback remove();
    // Pressing and moving lifts the row to a new place; pointers are in window coordinates.
    in property <bool> arrangeable;
    out property <bool> arranging;
    callback arrange-started(Point);
    callback arrange-moved(Point);
    callback arrange-ended();
    callback arrange-cancelled();
    property <Point> menu-position;
    // Where each optional action sits when it shows.
    property <int> playlist-index: root.secondary-action-shown ? 2 : 1;
    property <int> edit-index: root.playlist-index + (root.add-to-playlist-shown ? 1 : 0);
    property <int> loop-index: root.edit-index + (root.edit-shown ? 1 : 0);
    property <int> remove-index: root.loop-index + (root.loop-shown ? 1 : 0);
    property <int> action-count: root.remove-index + (root.remove-shown ? 1 : 0);
    mouse-cursor: root.arranging ? MouseCursor.grabbing : MouseCursor.pointer;

    public function show-menu(position: Point) {
        root.menu-position = {
            x: position.x - root.absolute-position.x,
            y: position.y - root.absolute-position.y,
        };
        menu.show();
    }

    function enabled-at(index: int) -> bool {
        if index == 0 {
            return root.primary-action-enabled;
        }
        if index == 1 && root.secondary-action-shown {
            return root.secondary-action-enabled;
        }
        return true;
    }

    function step(index: int, down: bool) -> int {
        Math.mod(index + (down ? 1 : -1) + root.action-count, root.action-count)
    }

    function activate(index: int) {
        if !root.enabled-at(index) {
            return;
        }
        menu.close();
        if index == 0 {
            root.primary-action();
        } else if index == 1 && root.secondary-action-shown {
            root.secondary-action();
        } else if root.add-to-playlist-shown && index == root.playlist-index {
            root.add-to-playlist();
        } else if root.edit-shown && index == root.edit-index {
            root.edit();
        } else if root.loop-shown && index == root.loop-index {
            root.edit-loop();
        } else if root.remove-shown && index == root.remove-index {
            root.remove();
        }
    }

    moved => {
        if root.arrangeable && root.pressed && !root.arranging
            && max(abs(root.mouse-x - root.pressed-x), abs(root.mouse-y - root.pressed-y)) > Theme.arrange-threshold {
            root.arranging = true;
            root.arrange-started({
                x: root.absolute-position.x + root.pressed-x,
                y: root.absolute-position.y + root.pressed-y,
            });
        }
        if root.arranging {
            root.arrange-moved({
                x: root.absolute-position.x + root.mouse-x,
                y: root.absolute-position.y + root.mouse-y,
            });
        }
    }

    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
            root.show-menu({
                x: root.absolute-position.x + root.mouse-x,
                y: root.absolute-position.y + root.mouse-y,
            });
        }
        if root.arranging && event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
            root.arranging = false;
            root.arrange-ended();
        }
        if root.arranging && event.kind == PointerEventKind.cancel {
            root.arranging = false;
            root.arrange-cancelled();
        }
    }

    menu := PopupWindow {
        x: root.menu-position.x;
        y: root.menu-position.y;
        close-policy: close-on-click-outside;
        keys := FocusScope {
            property <int> selected: -1;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    menu.close();
                    return accept;
                }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    let down = event.text == Key.DownArrow;
                    self.selected = self.selected < 0 ? (down ? 0 : root.action-count - 1) : root.step(self.selected, down);
                    // Only the first two actions can be disabled, and an enabled one follows
                    // them, so skipping twice suffices.
                    if !root.enabled-at(self.selected) {
                        self.selected = root.step(self.selected, down);
                    }
                    if !root.enabled-at(self.selected) {
                        self.selected = root.step(self.selected, down);
                    }
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.activate(self.selected);
                    return accept;
                }
                reject
            }
            MenuSurface {
                MenuAction {
                    text: root.primary-action-title;
                    enabled: root.primary-action-enabled;
                    highlighted: keys.selected == 0;
                    changed has-hover => {
                        if self.has-hover { keys.selected = 0; }
                    }
                    activated => { root.activate(0); }
                }
                if root.secondary-action-shown: MenuAction {
                    text: root.secondary-action-title;
                    enabled: root.secondary-action-enabled;
                    highlighted: keys.selected == 1;
                    changed has-hover => {
                        if self.has-hover { keys.selected = 1; }
                    }
                    activated => { root.activate(1); }
                }
                if root.add-to-playlist-shown: MenuAction {
                    text: @tr("Add to playlist…");
                    highlighted: keys.selected == root.playlist-index;
                    changed has-hover => {
                        if self.has-hover { keys.selected = root.playlist-index; }
                    }
                    activated => { root.activate(root.playlist-index); }
                }
                if root.edit-shown: MenuAction {
                    text: @tr("Edit");
                    highlighted: keys.selected == root.edit-index;
                    changed has-hover => {
                        if self.has-hover { keys.selected = root.edit-index; }
                    }
                    activated => { root.activate(root.edit-index); }
                }
                if root.loop-shown: MenuAction {
                    text: @tr("Edit loop…");
                    highlighted: keys.selected == root.loop-index;
                    changed has-hover => {
                        if self.has-hover { keys.selected = root.loop-index; }
                    }
                    activated => { root.activate(root.loop-index); }
                }
                if root.remove-shown: MenuAction {
                    text: root.remove-title;
                    destructive: true;
                    highlighted: keys.selected == root.remove-index;
                    changed has-hover => {
                        if self.has-hover { keys.selected = root.remove-index; }
                    }
                    activated => { root.activate(root.remove-index); }
                }
            }
        }
    }
}

component LoopBadgeIcon inherits Icon {
    in property <LoopBadge> badge;
    width: 16px;
    height: 16px;
    source: @image-url("icons/repeat.svg");
    tint: root.badge == LoopBadge.needs-review ? Theme.warning : Theme.text-faint;
    accessible-role: image;
    accessible-label: root.badge == LoopBadge.needs-review ? @tr("Loop needs review") : @tr("Saved loop");
}

// Where a queued song plays in the queue, in place of its row number.
component QueueChip inherits Rectangle {
    in property <int> number;
    width: max(22px, label.preferred-width + 10px);
    height: 22px;
    border-radius: self.height / 2;
    background: Theme.lit;
    label := Text {
        text: "\{root.number}";
        color: Theme.on-lit;
        font-size: Theme.caption;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TrackColumns inherits HorizontalLayout {
    in property <length> available-width;
    out property <length> source-width: root.available-width >= 760px ? min(420px, root.available-width * 0.3) : 0px;
    out property <length> date-width: root.available-width >= 1020px ? 140px : 0px;
    padding-left: 6px;
    padding-right: 16px;
    spacing: 16px;
    @children
}

component TrackCell inherits Text {
    font-size: Theme.body-small;
    color: Theme.text-faint;
    vertical-alignment: center;
    overflow: elide;
}

component TrackItem inherits Rectangle {
    TourTarget {
        anchor: CollectionTour.tracks;
        scroll: TourScroll.collection;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in property <TrackRow> track;
    in property <int> number;
    in property <length> available-width;
    in property <bool> arrangeable;
    in property <length> shift;
    in property <bool> sliding;
    in property <bool> lifted;
    callback edit();
    callback add-to-playlist();
    callback arrange-started(Point);
    callback arrange-moved(Point);
    callback arrange-ended();
    callback arrange-cancelled();
    height: 48px;
    z: root.lifted ? 1 : 0;
    row := Rectangle {
        y: root.shift;
        animate y { duration: root.sliding ? Motion.arrange-slide : 0ms; }
        border-radius: Theme.radius-row;
        background: root.lifted ? Theme.panel-hover : root.track.current ? Theme.current-row : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Motion.hover; }
        opacity: root.track.missing ? 0.55 : 1;
        touch := RowMenu {
            primary-action-title: PlayerView.can-add-layer ? @tr("Add to mix") : @tr("Mix full (3 songs)");
            primary-action-enabled: PlayerView.can-add-layer && !root.track.missing && !root.track.current;
            primary-action => {
                Actions.add-music-layer(root.track.id);
            }
            secondary-action-shown: true;
            secondary-action-title: root.track.queue-number > 0 ? @tr("Remove from queue")
                : PlayerView.repeat == 2 ? @tr("Queue off (repeating one song)") : @tr("Add to queue");
            secondary-action-enabled: root.track.queue-number > 0 || (PlayerView.repeat != 2 && !root.track.missing);
            secondary-action => {
                if root.track.queue-number > 0 {
                    Actions.remove-from-queue(root.track.id);
                } else {
                    Actions.add-to-queue(root.track.id);
                }
            }
            add-to-playlist-shown: true;
            add-to-playlist => { root.add-to-playlist(); }
            edit => { root.edit(); }
            loop-shown: !root.track.missing;
            edit-loop => { Actions.edit-song-loop(root.track.song-id); }
            remove-shown: !LibraryView.collection-linked;
            remove => { Actions.delete-entry(root.track.id); }
            double-clicked => {
                if !self.arranging {
                    Actions.play-track(root.track.id);
                }
            }
            arrangeable: root.arrangeable;
            arrange-started(start) => { root.arrange-started(start); }
            arrange-moved(pointer) => { root.arrange-moved(pointer); }
            arrange-ended => { root.arrange-ended(); }
            arrange-cancelled => { root.arrange-cancelled(); }
        }

        columns := TrackColumns {
            available-width: root.available-width;
            Rectangle {
                width: 32px;
                if root.track.playing && !touch.has-hover: Equalizer { }
                if !root.track.playing && root.track.queue-number == 0: Text {
                    text: "\{root.number}";
                    color: Theme.text-faint;
                    font-size: Theme.body-small;
                    opacity: touch.has-hover ? 0 : 1;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !root.track.playing && root.track.queue-number > 0: QueueChip {
                    number: root.track.queue-number;
                    opacity: touch.has-hover ? 0 : 1;
                }
                if touch.has-hover || !root.track.playing: IconButton {
                    size: 32px;
                    icon-size: 16px;
                    icon: root.track.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                    tint: root.track.current ? Theme.lit : Theme.text-faint;
                    opacity: touch.has-hover || self.has-hover ? 1 : 0;
                    tooltip: root.track.playing ? @tr("Pause") : @tr("Play");
                    enabled: !root.track.missing;
                    clicked => {
                        Actions.play-track(root.track.id);
                    }
                    context-menu-requested(position) => { touch.show-menu(position); }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                Text {
                    text: root.track.title;
                    overflow: elide;
                    font-size: Theme.body;
                    font-weight: root.track.current ? 800 : 500;
                    color: root.track.current ? Theme.lit-bright : Theme.text;
                }
            }

            if root.track.loop-badge != LoopBadge.none: LoopBadgeIcon {
                y: (parent.height - self.height) / 2;
                badge: root.track.loop-badge;
            }

            if root.track.missing: Text {
                text: @tr("Missing");
                font-size: Theme.caption;
                color: Theme.error;
                vertical-alignment: center;
            }
            if columns.source-width > 0px: TrackCell {
                width: columns.source-width;
                text: root.track.source;
            }
            if columns.date-width > 0px: TrackCell {
                width: columns.date-width;
                text: root.track.date-added;
            }
            TrackCell {
                width: 72px;
                text: root.track.duration;
                horizontal-alignment: right;
            }
        }
    }
}

component TrackHeader inherits Rectangle {
    in property <length> available-width;
    height: 36px;
    columns := TrackColumns {
        available-width: root.available-width;
        TrackCell {
            width: 32px;
            text: "#";
            horizontal-alignment: center;
        }
        TrackCell {
            text: @tr("Title");
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
        }
        if columns.source-width > 0px: TrackCell {
            width: columns.source-width;
            text: @tr("Source");
        }
        if columns.date-width > 0px: TrackCell {
            width: columns.date-width;
            text: @tr("Date added");
        }
        TrackCell {
            width: 72px;
            text: @tr("Duration");
            horizontal-alignment: right;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

// A song outside any playlist's order: its number, or its add button while hovered, then the
// same columns as a track. `add` adds it somewhere; right-click also offers removing it.
component SongItem inherits Rectangle {
    TourTarget {
        anchor: SongsTour.songs;
        scroll: TourScroll.songs;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in property <SongRow> song;
    in property <int> number;
    in property <length> available-width;
    // Shows the add button in place of the number even without hover.
    in property <bool> add-always-shown;
    in property <string> add-title;
    callback add();
    height: 48px;
    border-radius: Theme.radius-row;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.hover; }
    opacity: root.song.missing ? 0.55 : 1;
    touch := RowMenu {
        primary-action-title: root.add-title;
        primary-action => { root.add(); }
        edit-shown: false;
        loop-shown: !root.song.missing;
        edit-loop => { Actions.edit-song-loop(root.song.id); }
        remove-shown: root.song.removable;
        remove-title: @tr("Remove from Songs");
        remove => { Actions.remove-song(root.song.id); }
        double-clicked => { root.add(); }
    }

    columns := TrackColumns {
        available-width: root.available-width;
        Rectangle {
            width: 32px;
            if !root.add-always-shown: Text {
                text: "\{root.number}";
                color: Theme.text-faint;
                font-size: Theme.body-small;
                opacity: touch.has-hover ? 0 : 1;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            IconButton {
                size: 32px;
                icon-size: 18px;
                icon: @image-url("icons/plus.svg");
                tint: Theme.text-secondary;
                opacity: root.add-always-shown || touch.has-hover || self.has-hover ? 1 : 0;
                tooltip: root.add-title;
                clicked => {
                    root.add();
                }
                context-menu-requested(position) => { touch.show-menu(position); }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            Text {
                text: root.song.title;
                overflow: elide;
                font-size: Theme.body;
                font-weight: 500;
                color: Theme.text;
            }
        }

        if root.song.loop-badge != LoopBadge.none: LoopBadgeIcon {
            y: (parent.height - self.height) / 2;
            badge: root.song.loop-badge;
        }

        if root.song.missing: Text {
            text: @tr("Missing");
            font-size: Theme.caption;
            color: Theme.error;
            vertical-alignment: center;
        }
        if columns.source-width > 0px: TrackCell {
            width: columns.source-width;
            text: root.song.source;
        }
        if columns.date-width > 0px: TrackCell {
            width: columns.date-width;
            text: root.song.date-added;
        }
        TrackCell {
            width: 72px;
            text: root.song.duration;
            horizontal-alignment: right;
        }
    }
}

// A search over the songs, below a hand-picked playlist's tracks, that adds what it finds.
component SongSearch inherits VerticalLayout {
    TourTarget {
        anchor: CollectionTour.find-songs;
        scroll: TourScroll.collection;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in property <length> available-width;
    spacing: 10px;
    Text {
        text: @tr("Find songs for this playlist");
        font-size: Theme.subheading;
        font-weight: 800;
        color: Theme.text;
    }

    Rectangle {
        width: min(root.available-width, 460px);
        height: 42px;
        border-radius: self.height / 2;
        background: Theme.raised;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.divider;
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                input.focus();
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                source: @image-url("icons/search.svg");
                tint: Theme.text-faint;
            }

            input := TextInput {
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: Theme.body;
                color: Theme.text;
                single-line: true;
                text: Search.song-search-text;
                edited => {
                    Search.song-search-text = self.text;
                    Actions.song-search-changed(self.text);
                }
                if self.text == "": Text {
                    x: 0;
                    width: parent.width;
                    overflow: elide;
                    text: @tr("Search your songs by title or folder");
                    color: Theme.text-faint;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }

    if Search.song-search-text != "" && LibraryView.song-search-results.length == 0: Text {
        text: @tr("No song outside this playlist matches.");
        color: Theme.text-secondary;
        font-size: Theme.body-small;
    }
    VerticalLayout {
        spacing: 2px;
        for song in LibraryView.song-search-results: SongItem {
            song: song;
            available-width: root.available-width;
            add-always-shown: true;
            add-title: @tr("Add to this playlist");
            add => {
                Actions.add-song-to-playlist(Navigation.collection-id, song.id);
            }
        }
    }
}

export component PlaylistPage inherits Rectangle {
    // Hides the plate; the slim header shows either way.
    in property <bool> compact;
    callback edit-collection();
    callback edit-entry(string, string);
    callback add-files();
    // The song's id and title.
    callback add-to-playlist(string, string);
    property <bool> this-plays: PlayerView.collection-id == Navigation.collection-id && PlayerView.playing;
    // A track row and the spacing after it.
    property <length> track-pitch: 48px + 2px;
    property <int> last-track: LibraryView.tracks.length - 1;
    property <int> track-target: clamp(drag.from + round(drag.offset-y / root.track-pitch), 0, root.last-track);

    pure function track-shift(index: int) -> length {
        if drag.from < 0 {
            return 0px;
        }
        if index == drag.from {
            return clamp(drag.offset-y, -drag.from * root.track-pitch, (root.last-track - drag.from) * root.track-pitch);
        }
        if drag.from < index && index <= root.track-target {
            return -root.track-pitch;
        }
        if root.track-target <= index && index < drag.from {
            return root.track-pitch;
        }
        return 0px;
    }

    drag := EntryDrag {
        scroll-top: scroll.scroll-top;
        viewport-y: scroll.absolute-position.y;
        viewport-height: scroll.height;
        scroll-by(distance) => {
            scroll.scroll-by(distance);
        }
    }

    VerticalLayout {
        CollectionBar {
            kind: CollectionKind.playlist;
            edit => {
                root.edit-collection();
            }
            add-files => {
                root.add-files();
            }
        }
        scroll := PageScroll {
            tour-scroll: TourScroll.collection;
            vertical-stretch: 1;
            content-height: column.preferred-height;
            column := VerticalLayout {
                padding: PageMetrics.padding;
                padding-top: root.compact ? PageMetrics.padding-top : 18px;
                alignment: start;
                if !root.compact: CollectionHero {
                    padding-bottom: 16px;
                    edit => {
                        root.edit-collection();
                    }
                    add-files => {
                        root.add-files();
                    }
                    Button {
                        text: root.this-plays ? @tr("Pause") : @tr("Play");
                        icon: root.this-plays ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                        kind: ButtonKind.primary;
                        enabled: LibraryView.tracks.length > 0;
                        clicked => {
                            Actions.play-collection(Navigation.collection-id);
                        }
                    }

                    Button {
                        text: PlayerView.shuffle ? @tr("Shuffling") : @tr("Shuffle");
                        icon: @image-url("icons/shuffle.svg");
                        clicked => {
                            Actions.toggle-shuffle();
                        }
                    }
                }
                FilterField {
                    space-below: 16px;
                }

                VerticalLayout {
                    spacing: 2px;
                    if LibraryView.tracks.length > 0: TrackHeader {
                        available-width: root.width - 2 * PageMetrics.padding;
                    }
                    if LibraryView.tracks.length == 0: Text {
                        text: Search.filter-text != "" ? @tr("No track matches the filter.") : LibraryView.collection-linked ? @tr("This folder holds no audio yet.") : @tr("Find songs below, or drop audio files here.");
                        color: Theme.text-secondary;
                    }
                    for track[index] in LibraryView.tracks: TrackItem {
                        track: track;
                        number: index + 1;
                        available-width: root.width - 2 * PageMetrics.padding;
                        arrangeable: Search.filter-text == "";
                        shift: root.track-shift(index);
                        lifted: index == drag.from;
                        sliding: drag.from >= 0 && index != drag.from;
                        arrange-started(start) => {
                            drag.begin(track.id, index, start);
                        }
                        arrange-moved(pointer) => {
                            drag.move(pointer);
                        }
                        arrange-ended => {
                            Actions.arrange-entry(drag.entry-id, root.track-target);
                            drag.end();
                        }
                        arrange-cancelled => {
                            drag.end();
                        }
                        edit => {
                            root.edit-entry(track.id, track.title);
                        }
                        add-to-playlist => {
                            root.add-to-playlist(track.song-id, track.title);
                        }
                    }
                }

                if !LibraryView.collection-linked: SongSearch {
                    padding-top: 32px;
                    available-width: root.width - 2 * PageMetrics.padding;
                }
            }
        }
    }

    BarShadow {
        shown: scroll.scrolled;
    }
}

// The ring that fills around a playing sound's disc as the sound plays through.
component ProgressRing inherits Path {
    in property <float> progress;
    property <float> fraction: clamp(root.progress, 0, 0.999);
    property <angle> sweep: root.fraction * 360deg;
    viewbox-width: 100;
    viewbox-height: 100;
    stroke: Theme.lit;
    stroke-width: 2.5px;
    commands: "M 50 4 A 46 46 0 " + (root.fraction > 0.5 ? "1" : "0") + " 1 " + (50 + 46 * Math.sin(root.sweep)) + " " + (50 - 46 * Math.cos(root.sweep));
}

// A sound as a pad: an icon in a disc that the sun lights while it plays, its title, and its
// volume. Clicking the pad plays or stops it.
component SoundTileView inherits Rectangle {
    TourTarget {
        anchor: CollectionTour.sounds;
        scroll: TourScroll.collection;
        bounds: GuidedTours.bounds(root.absolute-position, root.width, root.height);
    }
    in property <SoundTile> tile;
    in property <bool> arrangeable;
    in property <bool> lifted;
    callback edit();
    callback arrange-started(Point);
    callback arrange-moved(Point);
    callback arrange-ended();
    callback arrange-cancelled();
    property <bool> playable: !root.tile.missing;
    border-radius: Theme.radius-tile;
    background: toggle.has-hover || root.lifted ? Theme.panel-hover : Theme.panel;
    animate background { duration: Motion.hover; }
    border-width: 1px;
    border-color: root.tile.playing ? Theme.lit.with-alpha(0.5) : Theme.panel-edge;
    opacity: root.tile.missing ? 0.5 : 1;
    accessible-role: button;
    accessible-label: root.tile.title;
    accessible-checked: root.tile.playing;
    accessible-action-default => {
        if root.playable {
            Actions.toggle-sound(root.tile.id);
        }
    }
    toggle := RowMenu {
        primary-action-title: root.tile.looping ? @tr("Stop Looping") : @tr("Loop");
        primary-action => {
            Actions.set-sound-looping(root.tile.id, !root.tile.looping);
        }
        edit => { root.edit(); }
        remove-shown: !LibraryView.collection-linked;
        remove => { Actions.delete-entry(root.tile.id); }
        clicked => {
            if root.playable && !self.arranging {
                Actions.toggle-sound(root.tile.id);
            }
        }
        arrangeable: root.arrangeable;
        arrange-started(start) => { root.arrange-started(start); }
        arrange-moved(pointer) => { root.arrange-moved(pointer); }
        arrange-ended => { root.arrange-ended(); }
        arrange-cancelled => { root.arrange-cancelled(); }
    }

    if root.tile.looping: Icon {
        x: 14px;
        y: 14px;
        width: 15px;
        height: 15px;
        source: @image-url("icons/repeat.svg");
        tint: Theme.accent;
    }
    if root.tile.missing: Text {
        x: 14px;
        y: 12px;
        text: @tr("File missing");
        font-size: Theme.micro;
        font-weight: 700;
        color: Theme.error;
    }
    VerticalLayout {
        padding: 14px;
        padding-top: 20px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 86px;
                height: 86px;
                if root.tile.playing: Rectangle {
                    border-radius: self.width / 2;
                    border-width: 1px;
                    border-color: Theme.lit.with-alpha(0.16);
                }
                if root.tile.playing: ProgressRing {
                    progress: root.tile.progress;
                }
                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: 74px;
                    height: 74px;
                    border-radius: self.width / 2;
                    background: root.tile.playing ? Theme.lit : Theme.disc;
                    Icon {
                        width: 32px;
                        height: 32px;
                        source: SoundIcons.images[root.tile.icon];
                        tint: root.tile.playing ? Theme.on-lit : Theme.text;
                    }
                }
            }
        }

        Text {
            text: root.tile.title;
            font-size: Theme.body-small;
            font-weight: 800;
            horizontal-alignment: center;
            overflow: elide;
            color: Theme.text;
        }

        Slider {
            value: root.tile.volume;
            fill: root.tile.playing ? Theme.lit : Theme.text-secondary;
            track: root.tile.playing ? Theme.lit.with-alpha(0.2) : Theme.track;
            changed(value) => {
                Actions.set-sound-volume(root.tile.id, value);
            }
            context-menu-requested(position) => { toggle.show-menu(position); }
        }
    }
}

component TileGrid inherits Rectangle {
    in property <[SoundTile]> tiles;
    in property <bool> arrangeable;
    // -1 while no tile is lifted.
    in property <int> lifted-index: -1;
    in property <length> lifted-offset-x;
    in property <length> lifted-offset-y;
    callback edit(SoundTile);
    callback arrange-started(string, int, Point);
    callback arrange-moved(Point);
    callback arrange-ended(int);
    callback arrange-cancelled();
    property <length> tile-width-min: 150px;
    property <int> columns: max(1, Math.floor((root.width + PageMetrics.gap) / (root.tile-width-min + PageMetrics.gap)));
    property <length> tile-width: (root.width - (root.columns - 1) * PageMetrics.gap) / root.columns;
    property <length> tile-height: 184px;
    property <length> column-pitch: root.tile-width + PageMetrics.gap;
    property <length> row-pitch: root.tile-height + PageMetrics.gap;
    property <int> rows: Math.ceil(root.tiles.length / root.columns);
    property <int> target-index: min(
        root.tiles.length - 1,
        clamp(Math.floor(root.lifted-index / root.columns) + round(root.lifted-offset-y / root.row-pitch), 0, root.rows - 1) * root.columns
            + clamp(Math.mod(root.lifted-index, root.columns) + round(root.lifted-offset-x / root.column-pitch), 0, root.columns - 1));
    height: root.rows == 0 ? 0 : root.rows * root.tile-height + (root.rows - 1) * PageMetrics.gap;

    pure function place(index: int) -> int {
        if root.lifted-index < 0 {
            return index;
        }
        if root.lifted-index < index && index <= root.target-index {
            return index - 1;
        }
        if root.target-index <= index && index < root.lifted-index {
            return index + 1;
        }
        return index;
    }

    for tile[index] in root.tiles: SoundTileView {
        lifted: index == root.lifted-index;
        x: self.lifted
            ? clamp(Math.mod(index, root.columns) * root.column-pitch + root.lifted-offset-x, 0px, root.width - root.tile-width)
            : Math.mod(root.place(index), root.columns) * root.column-pitch;
        y: self.lifted
            ? clamp(Math.floor(index / root.columns) * root.row-pitch + root.lifted-offset-y, 0px, root.height - root.tile-height)
            : Math.floor(root.place(index) / root.columns) * root.row-pitch;
        z: self.lifted ? 1 : 0;
        animate x, y { duration: root.lifted-index >= 0 && !self.lifted ? Motion.arrange-slide : 0ms; }
        width: root.tile-width;
        height: root.tile-height;
        tile: tile;
        arrangeable: root.arrangeable;
        edit => {
            root.edit(tile);
        }
        arrange-started(start) => {
            root.arrange-started(tile.id, index, start);
        }
        arrange-moved(pointer) => {
            root.arrange-moved(pointer);
        }
        arrange-ended => {
            root.arrange-ended(root.target-index);
        }
        arrange-cancelled => {
            root.arrange-cancelled();
        }
    }
}

export component SoundboardPage inherits Rectangle {
    // Hides the plate; the slim header shows either way.
    in property <bool> compact;
    callback edit-collection();
    callback edit-sound(SoundTile);
    callback add-files();
    drag := EntryDrag {
        scroll-top: scroll.scroll-top;
        viewport-y: scroll.absolute-position.y;
        viewport-height: scroll.height;
        scroll-by(distance) => {
            scroll.scroll-by(distance);
        }
    }
    VerticalLayout {
        CollectionBar {
            kind: CollectionKind.soundboard;
            edit => {
                root.edit-collection();
            }
            add-files => {
                root.add-files();
            }
        }
        scroll := PageScroll {
            tour-scroll: TourScroll.collection;
            vertical-stretch: 1;
            content-height: column.preferred-height;
            column := VerticalLayout {
                padding: PageMetrics.padding;
                padding-top: root.compact ? PageMetrics.padding-top : 18px;
                alignment: start;
                if !root.compact: CollectionHero {
                    padding-bottom: 16px;
                    edit => {
                        root.edit-collection();
                    }
                    add-files => {
                        root.add-files();
                    }
                }
                FilterField {
                    space-below: 16px;
                }

                if LibraryView.sounds.length == 0: Text {
                    text: Search.filter-text != "" ? @tr("No sound matches the filter.") : LibraryView.collection-linked ? @tr("This folder holds no audio yet.") : @tr("Drop audio files here to add them.");
                    color: Theme.text-secondary;
                }
                TileGrid {
                    tiles: LibraryView.sounds;
                    arrangeable: Search.filter-text == "";
                    lifted-index: drag.from;
                    lifted-offset-x: drag.offset-x;
                    lifted-offset-y: drag.offset-y;
                    edit(tile) => {
                        root.edit-sound(tile);
                    }
                    arrange-started(id, index, start) => {
                        drag.begin(id, index, start);
                    }
                    arrange-moved(pointer) => {
                        drag.move(pointer);
                    }
                    arrange-ended(target) => {
                        Actions.arrange-entry(drag.entry-id, target);
                        drag.end();
                    }
                    arrange-cancelled => {
                        drag.end();
                    }
                }
            }
        }
    }

    BarShadow {
        shown: scroll.scrolled;
    }
}

// A followed folder of music, with a menu to stop following it.
component SongFolderItem inherits Rectangle {
    in property <SongFolder> folder;
    height: 40px;
    border-radius: Theme.radius-row;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.hover; }
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            source: @image-url("icons/folder.svg");
            tint: Theme.text-faint;
        }

        Text {
            text: root.folder.path;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.body-small;
            color: Theme.text;
        }

        Text {
            text: root.folder.count-label;
            vertical-alignment: center;
            font-size: Theme.caption;
            color: Theme.text-faint;
        }

        more := IconButton {
            y: (parent.height - self.height) / 2;
            size: 32px;
            icon-size: 18px;
            icon: @image-url("icons/ellipsis-vertical.svg");
            tooltip: @tr("More");
            clicked => {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 300px;
        y: root.height;
        MenuSurface {
            width: 296px;
            MenuAction {
                text: @tr("Stop following and delete its playlists");
                destructive: true;
                activated => {
                    Actions.unfollow-folder(root.folder.id);
                    menu.close();
                }
            }
        }
    }
}

// Every song the sources keep: the followed folders of music, and the files added to playlists.
export component SongsPage inherits Rectangle {
    // The song's id and title.
    callback add-to-playlist(string, string);
    property <string> follow-label: @tr("Follow a folder");
    HorizontalLayout {
        y: 0;
        height: Theme.title-row-height;
        padding-left: PageMetrics.padding;
        padding-right: 8px;
        spacing: 8px;
        Heading {
            text: @tr("Songs");
            horizontal-stretch: 0;
            overflow: elide;
        }
        TourButton { y: (parent.height - self.height) / 2; guide: SongsTour.guide; label: @tr("Songs"); }
        Rectangle { horizontal-stretch: 1; }

        if root.width >= 520px: Button {
            y: (parent.height - self.height) / 2;
            height: 32px;
            text: root.follow-label;
            icon: @image-url("icons/folder-plus.svg");
            enabled: Session.connected;
            clicked => {
                Actions.follow-folder(CollectionKind.playlist);
            }
        }
        if root.width < 520px: IconButton {
            y: (parent.height - self.height) / 2;
            size: Theme.bar-button-size;
            icon-size: Theme.bar-icon-size;
            icon: @image-url("icons/folder-plus.svg");
            tooltip: root.follow-label;
            enabled: Session.connected;
            clicked => {
                Actions.follow-folder(CollectionKind.playlist);
            }
        }
    }

    scroll := PageScroll {
        tour-scroll: TourScroll.songs;
        y: Theme.title-row-height;
        height: parent.height - self.y;
        content-height: column.preferred-height;
        column := VerticalLayout {
            padding: PageMetrics.padding;
            padding-top: PageMetrics.padding-top;
            alignment: start;
            Text {
                text: LibraryView.songs-summary;
                font-size: Theme.body-small;
                color: Theme.text-secondary;
            }

            if LibraryView.song-folders.length > 0: VerticalLayout {
                TourTarget {
                    anchor: SongsTour.song-folders;
                    scroll: TourScroll.songs;
                    bounds: GuidedTours.bounds(parent.absolute-position, parent.width, parent.height);
                }
                padding-top: 18px;
                spacing: 2px;
                Text {
                    text: @tr("Followed folders");
                    font-size: Theme.caption;
                    font-weight: 700;
                    color: Theme.text-secondary;
                }

                for folder in LibraryView.song-folders: SongFolderItem {
                    folder: folder;
                }
            }
            Rectangle {
                height: 18px;
            }

            FilterField {
                space-below: 16px;
            }

            VerticalLayout {
                spacing: 2px;
                if LibraryView.songs.length > 0: TrackHeader {
                    available-width: root.width - 2 * PageMetrics.padding;
                }
                if LibraryView.songs.length == 0: Text {
                    text: Search.filter-text != "" ? @tr("No song matches the filter.") : @tr("Drop folders of music here to follow them. Their songs show here, ready for any playlist.");
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                for song[index] in LibraryView.songs: SongItem {
                    song: song;
                    number: index + 1;
                    available-width: root.width - 2 * PageMetrics.padding;
                    add-title: @tr("Add to playlist…");
                    add => {
                        root.add-to-playlist(song.id, song.title);
                    }
                }
                if LibraryView.songs-overflow != "": Text {
                    text: LibraryView.songs-overflow;
                    color: Theme.text-faint;
                    font-size: Theme.body-small;
                }
            }
        }
    }

    BarShadow {
        shown: scroll.scrolled;
    }
}

// Before the server answers for the first time.
export component ConnectingPage inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding-bottom: 40px;
        Text {
            text: @tr("Starting the audio server");
            font-family: Theme.display-font;
            font-size: Theme.heading;
            font-weight: Theme.display-weight;
            color: Theme.text;
            horizontal-alignment: center;
        }

        Text {
            text: Session.connection-text;
            font-size: Theme.body;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }
}
